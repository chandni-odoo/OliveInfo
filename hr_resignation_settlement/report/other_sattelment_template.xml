<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_other_sattelment">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="o">
                    <div class="page" style="font-family: 'Times New Roman', Times, serif;">
                        <div class="header">
                            <div style="display:flex; flex-direction:column; justify-content:center;min-height:100vh;">
                                <center><u><b><span style="font-size:20px;">DULSCO QATAR W.L.L.</span></b></u></center>
                                <center><u><b><span style="font-size:18px;">Final Settlement</span></b></u></center>
                                <div class="row">
                                    <div class="col-3" style="text-align:left;">
                                        <span style="text-align:right;">Settlement Number: <t t-esc="o.name"/></span>
                                    </div><div class="col-3"/><div class="col-3"/>
                                    <div class="col-3" style="text-align:right;">
                                        <span style="text-align:left;">Date: <t t-esc="datetime.datetime.now().strftime('%Y-%m-%d')" t-options='{"widget": "date","format": "dd-MM-yyyy"}'/></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row" style="text-align:justify;">
                            <div class="col-4">
                                <span>Name :</span>
                                <span><t t-esc="o.employee_name.name"/></span><br/>
                                <span>Title :</span>
                                <span><t t-esc="o.employee_job_id.name"/></span><br/>
                                <span>Branch :</span>
                                <span><t t-esc="o.branch_id.code"/> - <t t-esc="o.branch_id.name"/></span><br/>
                                <span>Joining Date :</span>
                                <span><t t-esc="o.joined_date" t-options='{"widget": "date","format": "dd-MM-yyyy"}'/></span><br/>
                            </div><div class="col-4"></div>
                            <div class="col-4">
                                <t t-set="total_allownce" t-value="sum(o.employee_name.contract_id.allowance_ids.filtered(lambda x: x.category_id.code == 'ALW').mapped('amount'))"/>
                                <span>Code :</span>
                                <span><t t-esc="o.employee_name.emp_no"/></span><br/>
                                <span>Basic :</span>
                                <span><t t-esc="o.basic_salary" t-options='{"widget": "float", "precision": 2}'/></span><br/>
                                <span>Allowances :</span>
                                <span><t t-esc="total_allownce" t-options='{"widget": "float", "precision": 2}'/></span><br/>
                                <span>Total :</span>
                                <span><t t-esc="total_allownce + o.basic_salary" t-options='{"widget": "float", "precision": 2}'/></span><br/>
                            </div>
                        </div><hr style="border-top: 1px solid black;"/>
                        <table style="width: 100%;">
                            <thead style="width: 100%;">
                                <tr>
                                    <th>Description</th>
                                    <th>Duration - From</th>
                                    <th>To</th>
                                    <th>Days</th>
                                    <th>Unproductive Days</th>
                                    <th>Eligible Days</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="o.gratuity_id">
                                    <tr>
                                        <td><span>Gratuity Period</span></td>
                                        <td><span>
                                            <t t-esc="o.gratuity_id.joined_date" t-options='{"widget": "date","format": "dd-MM-yyyy"}'/></span>
                                        </td>
                                        <td><span>
                                            <t t-esc="o.last_date" t-options='{"widget": "date","format": "dd-MM-yyyy"}'/></span>
                                        </td>
                                        <td>
                                            <span>
                                                <t t-esc="o.gratuity_id.total_days" t-options='{"widget": "float", "precision": 2}'/>
                                            </span>
                                        </td>
                                        <td>
                                            <span>
                                                <t t-esc="o.gratuity_id.unproductive_days" t-options='{"widget": "float", "precision": 2}'/>
                                            </span>
                                        </td>
                                        <td>
                                            <span>
                                                <t t-esc="o.gratuity_id.eligible_days" t-options='{"widget": "float", "precision": 2}'/>
                                            </span>
                                        </td>
                                    </tr>
                                </t>
                                <t t-if="o.leave_ids">
                                    <tr t-foreach="o.leave_ids" t-as="line">
                                        <t t-set="leave" t-value="line.report_leave_data()"/>
                                        <t t-if="line.quantity > 0">
                                            <td><span>Leave Period</span></td>
                                            <td>
                                                <span>
                                                    <t t-esc="leave.date_from" t-options='{"widget": "date","format": "dd-MM-yyyy"}'/>
                                                </span>
                                            </td>
                                            <td>
                                                <span>
                                                    <t t-esc="leave.date_to" t-options='{"widget": "date","format": "dd-MM-yyyy"}'/>
                                                </span>
                                            </td>
                                            <td>
                                                <span>
                                                    <t t-esc="line.quantity" t-options='{"widget": "float", "precision": 2}'/>
                                                </span>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <hr style="border-top: 1px solid black;"/>
                        <table style="width: 100%;">
                            <thead>
                                <tr>
                                    <th style="width: 20%;">Code</th>
                                    <th style="width: 30%;">Description</th>
                                    <th style="width: 10%;">Remarks</th>
                                    <th style="width: 20%;">Quantity</th>
                                    <th style="width: 20%;">Amount</th>
                                    <th style="width: 20%;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="o.gratuity_ids">
                                    <tr t-foreach="o.gratuity_ids" t-as="line">
                                        <td style="width: 20%;"><span><t t-esc="line.other_input_type.code"/></span></td>
                                        <td style="width: 30%;"><span><t t-esc="line.description"/></span></td>
                                        <td style="width: 10%;"><span><t t-esc="line.remarks"/></span></td>
                                        <td style="width: 20%;"><span><t t-esc="line.quantity"/></span></td>
                                        <td style="width: 20%;"><span><t t-esc="round(line.amount, 2)" t-options='{"widget": "float", "precision": 2}'/></span></td>
                                        <td style="width: 20%;"><span><t t-esc="line.total" t-options='{"widget": "float", "precision": 2}'/></span></td>
                                    </tr>
                                </t>
                                <t t-if="o.leave_ids">
                                    <tr t-foreach="o.leave_ids" t-as="line">
                                        <t t-if="line.quantity > 0">
                                            <td style="width: 20%;"><span><t t-esc="line.other_input_type.code"/></span></td>
                                            <td style="width: 30%;"><span><t t-esc="line.description"/></span></td>
                                            <td style="width: 10%;"><span><t t-esc="line.remarks"/></span></td>
                                            <!-- <td style="width: 20%;"><span><t t-esc="line.quantity"/></span></td> -->
                                            <td style="width: 20%;"><span><t t-esc="round(line.quantity, 2)" t-options='{"widget": "float", "precision": 2}'/></span></td>
                                            <td style="width: 20%;"><span><t t-esc="round(line.amount, 2)" t-options='{"widget": "float", "precision": 2}'/></span></td>
                                            <td style="width: 20%;"><span><t t-esc="line.total" t-options='{"widget": "float", "precision": 2}'/></span></td>
                                        </t>
                                    </tr>
                                </t>
                                <t t-if="o.other_sattlement_ids">
                                    <tr t-foreach="o.other_sattlement_ids" t-as="line">
                                        <td style="width: 20%;"><span><t t-esc="line.other_input_type.code"/></span></td>
                                        <td style="width: 30%;"><span><t t-esc="line.description"/></span></td>
                                        <td style="width: 10%;"><span><t t-esc="line.remarks"/></span></td>
                                        <td style="width: 20%;"><span><t t-esc="line.quantity"/></span></td>
                                        <td style="width: 20%;"><span><t t-esc="round(line.amount, 2)" t-options='{"widget": "float", "precision": 2}'/></span></td>
                                        <td style="width: 20%;"><span><t t-esc="line.total" t-options='{"widget": "float", "precision": 2}'/></span></td>
                                    </tr>
                                </t>
                                <!-- <t t-if="o.payslip_ids">
                                    <tr t-foreach="o.payslip_ids" t-as="line">
                                        <td style="width: 20%;"><span>Advance Salary</span></td>
                                        <td style="width: 30%;">Advance Salary For <span t-esc="line.date_from.strftime('%B')"/> </td>
                                        <td style="width: 10%;"><span></span></td>
                                        <td style="width: 20%;"><span>1</span></td>
                                        <td style="width: 20%;"><span><t t-esc="round(line.net_wage, 2)" t-options='{"widget": "float", "precision": 2}'/></span></td>
                                        <td style="width: 20%;"><span><t t-esc="round(line.net_wage, 2)" t-options='{"widget": "float", "precision": 2}'/></span></td>
                                    </tr>
                                </t> -->
                                <t t-if="o.advance_salary_ids">
                                    <tr t-foreach="o.advance_salary_ids" t-as="advance">
                                        <td style="width: 20%;"><span>Advance Salary</span></td>
                                        <td style="width: 30%;">
                                            <t t-if="advance.date">
                                                <span>Advance Salary for <t t-esc="advance.date.strftime('%d/%m/%Y')"/></span>
                                            </t>
                                            <t t-else="">
                                                <span t-esc="advance.name or 'Advance Salary'"/>
                                            </t>
                                        </td>
                                        <td style="width: 10%;"><span></span></td>
                                        <td style="width: 20%;"><span>1</span></td>
                                        <td style="width: 20%;">
                                            <span><t t-esc="round(advance.loan_amount, 2)" t-options='{"widget": "float", "precision": 2}'/></span>
                                        </td>
                                        <td style="width: 20%;">
                                            <span><t t-esc="round(advance.loan_amount, 2)" t-options='{"widget": "float", "precision": 2}'/></span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table><br/>
                        <div style="text-align:right;"><span style="text-align:right; border-top: 1px solid black; padding:5px;">
                            <b>Net Payable :&#160; <t t-esc="o.total_payable_amount" t-options='{"widget":"float", "precision":2}'/></b></span>
                        </div><hr style="border-top: 1px solid black;"/>
                        <div style="text-align:right;">* Amount in QAR.</div>
                        <div style="text-align:left;">
                            <span>Remarks : <t t-esc="o.remarks"/></span>
                        </div><br/>
                        <div style="font-size:12px;"><b>NOTE: ALL CBI-C3 MASTERCARD HOLDERS ARE ADVISED TO WITHDRAW THEIR BALANCES AS IT WILL BE DISCONNECTED SOON</b><br/><br/>
                        <span style="font-size:17px;">Accrued Leave Days :</span><br/>
                        <span style="font-size:17px;">Less Excess Leaves :</span><br/>
                        <span style="font-size:17px;">Less Absent Days :</span><br/>
                        <span style="font-size:17px;">Balance :</span>
                        </div>
                        <div class="row" style="margin-top: 50px;">
                            <div class="col-4"><span  style="border-top: 1px solid black; padding:5px;">Prepared By</span></div>
                            <div class="col-4"><span style="border-top: 1px solid black; padding:5px;">Checked By Finance</span></div>
                            <div class="col-4"><span style="border-top: 1px solid black; padding:5px;">Recipient's Sign</span></div>
                        </div>
                         <div class="row" style="margin-top: 80px; margin-right:5px">
                            <div class="col-4"><span style="border-top: 1px solid black; padding:5px;">Checked By HR</span></div>
                            <div class="col-4"><span style="border-top: 1px solid black; padding:5px;">Finance Approval</span></div>
                            <div class="col-4"><span style="border-top: 1px solid black; padding:5px;">Business Unit Head</span></div>
                        </div><hr style="border-top: 1px solid black;"/>
                        <div>Payment Details</div>
                        <div class="row">
                            <div class="col-4">Cash / Bank</div>
                            <div class="col-4">Cheque No :</div>
                            <div class="col-4">Date :</div>
                        </div>
                        <div>Note :</div>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>
