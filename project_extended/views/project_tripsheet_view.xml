<odoo>
    <record id="trip_sheet_view_tree" model="ir.ui.view">
        <field name="name">trip.sheet.view.tree</field>
        <field name="model">trip.sheet</field>
        <field name="arch" type="xml">
            <tree>
                <field name="status"/>
                <field name="date"/>
                <field name="project"/>
                <field name="driver_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="trip_sheet_view_form" model="ir.ui.view">
        <field name="name">trip.sheet.view.form</field>
        <field name="model">trip.sheet</field>
        <field name="arch" type="xml">
            <form string="Trip Sheet">
                <header>
                    <button name="button_complete" string="Completed" type="object" class="oe_highlight"/>
                    <button name="button_reschedule"  string="Reschedule" type="object" class="oe_highlight"/>
                    <button name="button_cancel"  string="Cancel" type="object" class="oe_highlight"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="trip_sequence"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="type_of_waste"/>
                            <field name="client_id"/>
                            <field name="type_of_sheet"/>
                            <field name="status" invisible="1"/>
                            <field name="date"/>
                            <field name="location_from"/>
                            <field name="location_to"/>
                            <field name="order_id"/>
                        </group>
                        <group>
                            <field name="client_no"/>
                            <field name="client_signature"/>
                            <field name="driver_name"/>
                            <field name="driver_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="vehicle_id"/>
                            <field name="project_task"/>
                            <field name="project"/>
                            <field name="driver_id"/>
                        </group>
                        <group>
                            <field name="helper_name"/>
                            <field name="helper_id"/>
                            <field name="helper_code"/>
                            <field name="km"/>
                            <field name="collection_no"/>
                            <field name="equipment_no"/>
                            <field name="non_billable"/>
                            <field name="reason_of_cancle" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Skip Delivered">
                            <field name="skip_delivered_ids">
                               <tree editable="bottom">
                                    <field name="skip_no"/>
                                    <field name="size"/>
                                    <field name="qty"/>
                                    <field name="unit"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Skip Collected">
                            <field name="skip_collected_ids">
                               <tree editable="bottom">
                                    <field name="skip_no"/>
                                    <field name="size"/>
                                    <field name="qty"/>
                                    <field name="unit"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Material Details" attrs="{'invisible': [('type_of_sheet','!=', 'hazardous')]}">
                            <field name="material_detail_ids">
                               <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="nos"/>
                                    <field name="material_type"/>
                                    <field name="grosswt"/>
                                    <field name="tarewt"/>
                                    <field name="netwt"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Transporters Details" attrs="{'invisible': [('type_of_sheet','!=', 'hazardous')]}">
                            <field name="transporters_details_ids">
                               <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="telephone_no"/>
                                    <field name="truck_no"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Reason of cancel">
                            <group>
                                <field name="reason_of_cancle"/>
                                <field name="note"/>
                            </group>
                        </page>
                        <page string="Attachments">
                            <field name="attachment_ids" widget='many2many_binary'>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id='action_trip_sheet' model='ir.actions.act_window'>
        <field name="name">Trip Sheet</field>
        <field name="res_model">trip.sheet</field>
        <field name="view_mode">tree,form</field>
    </record>
<!-- 
    <menuitem id="menu_trip_sheet"
        name="Trip Sheet"
        parent="project.menu_main_pm"
        action="action_trip_sheet"
        sequence="60"/> -->
</odoo>
