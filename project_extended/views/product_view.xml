            <field name="name">ramadan.tree.view</field>
            <field name="model">timeoff.ramadan</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="date_from"/> 
                    <field name="date_to"/>
                </tree>
            </field>
        </record>
