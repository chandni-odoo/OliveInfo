        <!-- Action -->
        <record id="action1_timeoff_ramadan" model="ir.actions.act_window">
            <field name="name">Ramadan Leaves</field>
            <field name="res_model">timeoff.ramadan</field>
            <field name="view_mode">tree,form</field>
        </record>


         <menuitem
            id="menu_timeoff_ramadan"
            name="Ramadan Leaves"
            action="action1_timeoff_ramadan"
            parent="hr_holidays.menu_hr_holidays_configuration"
            sequence = "5"
            />


        <record id="product_template_form_view_inherits" model="ir.ui.view">
            <field name="name">product.template.form.inherits</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
              <xpath expr="//div[@name='options']" position='inside'>
                <div>
                  <field name="is_overtime_product"/>
                  <label for="is_overtime_product"/>
                </div>
              </xpath>
              <xpath expr="//field[@name='uom_po_id']" position="after">
                  <field name="based_cost"/>
                  <field name="recurring"/>
              </xpath>
            </field>
        </record>
    </data>
