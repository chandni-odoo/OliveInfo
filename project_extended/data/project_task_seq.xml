<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data>
		<record id="sequence_project_task" model="ir.sequence">
			<field name="name">Project Task Seq</field>
			<field name="code">project.task</field>	
			<field name="padding">3</field>
		    <field name="number_increment">1</field>
		    <field name="prefix">/JOB/</field>
		</record>
		<record id="trip_sheet_check" model="ir.sequence">
	        <field name="name">Trip</field>
	        <field name="code">trip.sheet</field>
	        <field name="prefix">Trip/</field>
	        <field name="padding">5</field>
	        <field name="company_id" eval="False" />
	    </record>
	    <record id="product_soc_product_template" model="product.product">
            <field name="name">Special Overtime</field>
            <!-- <field name="categ_id"  ref="product.product_category_3"/> -->
            <field name="default_code">SOC</field>
            <!-- <field name="uom_id" ref="uom.product_uom_hour"/> -->
            <!-- <field name="uom_po_id" ref="uom.product_uom_hour"/> -->
        </record>
       	<record id="product_noc_product_template" model="product.product">
            <field name="name">Normal Overtime</field>
            <!-- <field name="categ_id"  ref="product.product_category_3"/> -->
            <field name="default_code">NOC</field>
            <!-- <field name="uom_id" ref="uom.product_uom_hour"/> -->
            <!-- <field name="uom_po_id" ref="uom.product_uom_hour"/> -->
        </record>
        <record id="product_agency_template" model="product.product">
            <field name="name">Agency Fee</field>
            <!-- <field name="categ_id"  ref="product.product_category_3"/> -->
            <field name="default_code">agency</field>
            <!-- <field name="uom_id" ref="uom.product_uom_hour"/> -->
            <!-- <field name="uom_po_id" ref="uom.product_uom_hour"/> -->
        </record>

		<record id="stop_warning_data" model="stop.warning">
	        <field name="stop_check">True</field>
	        <field name="warning_check">False</field>
	    </record>


	</data>
</odoo>
