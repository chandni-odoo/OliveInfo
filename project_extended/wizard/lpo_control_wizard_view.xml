<odoo>
	<data noupdate="0">
		<record id="lpo_control_wizard_view_form" model="ir.ui.view">
			<field name="name">lpo.control.wizard.view</field>
			<field name="model">lpo.control.wizard</field>
			<field name="arch" type="xml">
				<form>
					<group>
						<group>
							<field name="name"/>
							<field name="attachment_id" widget="binary"/>
						</group>
						<group>
							<field name="date"/>
							<field name="sale_id" invisible="1"/>
							<field name="branch_id" invisible="1"/>
						</group>
					</group>
					<field name="lpo_control_ids">
						<tree editable="bottom">
                            <field name="sale_order_line_id" invisible="1"/>
							<field name="name" readonly="True" force_save="1"/>
							<field name="no_of_hour"/>
							<field name="quantity"/>
							<field name="amount"/>
						</tree>
					</field>
					<footer>
						<button name="create_lpo_control" string="Create LPO" type="object" class="oe_highlight" />
						<button string="Cancel" class="oe_link" special="cancel"/>
					</footer>
				</form>
			</field>
		</record>

		<record id="lpo_control_wizard_action" model="ir.actions.act_window">
			<field name="name">Lpo Control</field>
			<field name="res_model">lpo.control.wizard</field>
			<field name="view_mode">form</field>
			<field name="view_id" ref="lpo_control_wizard_view_form"/>
			<field name="target">new</field>
		</record>
	</data>
</odoo>
