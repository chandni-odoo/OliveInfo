<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.view.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="/form/header/button[@name='button_cancel']" position="before">
                <button name="too_approve" type="object" class="oe_highlight" string="Submit" attrs="{'invisible':['|', ('state', 'not in', ('draft','sent')), ('no_approval', '=', True)]}" />
            </xpath> 
            <field name="currency_id" position="after">
                <field name="no_approval" invisible="1"/>
                <field name="has_approval" invisible="1" />
            </field>
            <xpath expr="//button[@name='button_approve']" position="replace">
                <button name="action_button_approve" type="object" string="Approve" attrs="{'invisible': ['|', ('state', 'in', ('draft', 'sent', 'purchase', 'done', 'cancel')),('has_approval', '=', False)]}" class="oe_highlight" groups="purchase.group_purchase_manager" data-hotkey="z"/>
            </xpath>
            <xpath expr="//button[@name='button_cancel']" position="replace">
             <button name="button_cancel" attrs="{'invisible': [('state', 'in', ('to approve',))]}" string="Cancel" type="object" data-hotkey="x"/>
            </xpath>
            <xpath expr="//button[@name='button_cancel']" position="after">
            <button string="Reject" name="%(pways_purchase_approval.approval_rejected_action)d" type="action" attrs="{'invisible': ['|', ('state', 'in', ('draft', 'sent', 'purchase', 'done', 'cancel')),('has_approval', '=', False)]}"/>
            </xpath>
            <xpath expr="//button[@name='button_confirm'][1]" position="replace">
                <button name="button_confirm" type="object" string="Confirm Order" attrs="{'invisible': [('state', 'in', ('draft', 'sent', 'to approve' , 'purchase', 'done', 'cancel', 'approved', 'reject'))]}"/>
            </xpath>
            <xpath expr="//button[@name='button_confirm'][2]" position="replace">
                <button name="button_confirm" type="object" string="Confirm Order" attrs="{'invisible': [('state', '!=', 'approved')]}"/>
            </xpath>
            <xpath expr="//notebook//page[@name='products']" position="after">
                <page string="Approver History" attrs="{'invisible': [('purchase_history_ids','=', [])]}">
                    <field name="purchase_history_ids" mode="tree">
                        <tree editable="bottom">
                            <field name="user_id"/>
                            <field name="status"/>
                            <field name="date_done"/>
                        </tree>
                    </field>
                    <group>
                        <field name="reject_reason"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
