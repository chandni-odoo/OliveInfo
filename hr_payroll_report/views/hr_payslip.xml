<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_payroll_structure_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.payrolL.structure.form.inherit</field>
        <field name="model">hr.payroll.structure</field>
        <field name="inherit_id" ref="hr_payroll_account.hr_payroll_structure_view_form"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="reporting_account_id"/>
            </field>
        </field>
    </record>

    <record id="view_salary_rule_form_inherit_leave_pay" model="ir.ui.view">
        <field name="name">hr.salary.rule.form.inherit.leave.pay</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="hr_payroll.hr_salary_rule_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='appears_on_payslip']" position="after">
                <field name="exclude_from_leave_pay"/>
            </xpath>

        </field>
    </record>

    <record id="view_account_payment_form_inherit_release_date" model="ir.ui.view">
        <field name="name">account.payment.form.release.date</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_bank_id']" position="after">
                <field name="payment_release_date" attrs="{'invisible': [('payment_type', '!=', 'outbound')]}"/>
            </xpath>
        </field>
    </record>
</odoo>