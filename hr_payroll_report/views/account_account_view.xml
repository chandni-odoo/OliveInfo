<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_account_form_inherit_grouping" model="ir.ui.view">
        <field name="name">account.account.form.grouping</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group/group" position="inside">
                <field name="pl_group_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="bs_group_id" options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>

        </field>
    </record>
</odoo>