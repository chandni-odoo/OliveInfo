<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_billing_summary_report_wizard" model="ir.ui.view">
        <field name="name">employee.billing.summary.report.wizard.form</field>
        <field name="model">employee.billing.summary.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Employee Billing Summary Report">
                <sheet>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="branch_ids" widget="many2many_tags"/>
                    </group>
                    <footer>
                        <button name="action_generate_report" string="Generate Report" type="object" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_employee_billing_summary_report_wizard" model="ir.actions.act_window">
        <field name="name">Employee Billing Summary Report</field>
        <field name="res_model">employee.billing.summary.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_employee_billing_summary_report_wizard"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_employee_billing_summary_report"
              name="Employee Billing Summary Report"
              parent="menu_mis_report_main"
              action="action_employee_billing_summary_report_wizard"
              sequence="2"/>
</odoo>