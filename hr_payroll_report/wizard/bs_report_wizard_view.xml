<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bs_report_wizard" model="ir.ui.view">
        <field name="name">bs.report.wizard.form</field>
        <field name="model">bs.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Comparative BS Report">
                <group>
                    <field name="date"/>
                    <field name="company_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_print_report"
                            type="object"
                            string="Print Excel"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bs_report_wizard" model="ir.actions.act_window">
        <field name="name">Comparative BS</field>
        <field name="res_model">bs.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_pl_report"
              name="Comparative BS"
              parent="menu_mis_report_main"
              action="action_bs_report_wizard"
              sequence="13"
              groups="budget_customizations.group_account_admin"/>
</odoo>