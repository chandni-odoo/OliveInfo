<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_cost_plus_report_wizard" model="ir.ui.view">
        <field name="name">cost.plus.report.wizard.form</field>
        <field name="model">cost.plus.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Cost Plus Report">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="user_id"/>
                    <field name="employee_id"/>
                </group>
                <footer>
                    <button
                        name="action_export_excel"
                        string="Export Excel"
                        type="object"
                        class="btn-primary"/>
                    <button
                        string="Cancel"
                        special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="action_cost_plus_report" model="ir.actions.act_window">
        <field name="name">Cost Plus Report</field>
        <field name="res_model">cost.plus.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_cost_plus_report"
        name="Cost Plus Report"
        parent="sale.menu_sale_report"
        action="action_cost_plus_report"
        sequence="90"/>

</odoo>