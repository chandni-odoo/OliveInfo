    <!-- Wizard Action -->
    <record id="action_payslip_report_wizard" model="ir.actions.act_window">
        <field name="name">Employee Payroll Report</field>
        <field name="res_model">payslip.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_employee_payroll_report"
              name="Employee Payroll Report"
              parent="hr_payroll.menu_hr_payroll_report"
              action="action_payslip_report_wizard"
              sequence="110"/>
