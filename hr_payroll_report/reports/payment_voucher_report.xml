<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payment_voucher_document">
        <t t-call="hr_payroll_report.external_layout_payment_voucher">
            <main class="page">
                <t t-foreach="docs" t-as="o">
                    <t t-set="lang" t-value="o.partner_id.lang or o.company_id.partner_id.lang"/>
                    <t t-set="o" t-value="o.with_context(lang=lang)"/>

                    <h3><strong>Payment Voucher: <span t-field="o.name"/></strong></h3>

                    <div class="mb-4 mt-3">
                        <div class="row">
                            <div class="col-6" t-if="o.date">
                                Payment Date: <span t-field="o.date"/>
                            </div>
                            <div class="col-6" t-if="o.payment_method_id">
                                Payment Method: <span t-field="o.payment_method_id.name"/>
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-6" t-if="o.partner_id">
                                <t t-if="o.partner_type == 'customer'">Customer:</t>
                                <t t-if="o.partner_type == 'supplier'">Vendor:</t>
                                <span t-field="o.partner_id"/>
                            </div>
                            <div class="col-6" t-if="o.journal_id">
                                Bank Name: <span t-field="o.journal_id.name"/>
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-6" t-if="o.amount">
                                Payment Amount: <span t-field="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </div>
                            <div class="col-6" t-if="o.check_number">
                                Check Number: <span t-field="o.check_number"/>
                            </div>
                        </div>
                    </div>

                    <t t-if="o.payment_type == 'outbound'">
                    <t t-set="reconciled_bills" t-value="o.reconciled_bill_ids"/>
                    <t t-if="reconciled_bills">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Invoice Date</th>
                                    <th>Invoice Number</th>
                                    <th>Bill Number</th>
                                    <th class="text-right">Invoice Amount</th>
                                    <th class="text-right">Paid Amount</th>
                                    <th class="text-right">Balance Due</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="total_paid" t-value="0"/>
                                <t t-foreach="reconciled_bills" t-as="bill">
                                    <t t-set="paid_amount" t-value="0"/>
                                    <t t-foreach="o.move_id.line_ids.filtered(lambda l: l.account_id.user_type_id.type in ('receivable', 'payable'))" t-as="payment_line">
                                        <t t-foreach="payment_line.matched_debit_ids | payment_line.matched_credit_ids" t-as="partial">
                                            <t t-set="reconciled_line" t-value="partial.debit_move_id if partial.credit_move_id == payment_line else partial.credit_move_id"/>
                                            <t t-if="reconciled_line.move_id == bill">
                                                <t t-set="paid_amount" t-value="paid_amount + partial.amount"/>
                                            </t>
                                        </t>
                                    </t>
                                    <tr>
                                        <td><span t-field="bill.invoice_date"/></td> 
                                        <td><span t-field="bill.ref"/></td>
                                        <td><span t-field="bill.name"/></td>
                                        <td class="text-right">
                                            <span t-field="bill.amount_total"
                                                t-options="{'widget': 'monetary', 'display_currency': bill.currency_id}"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="paid_amount" 
                                                t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="bill.amount_residual" 
                                                t-options="{'widget': 'monetary', 'display_currency': bill.currency_id}"/>
                                        </td>
                                    </tr>
                                    <t t-set="total_paid" t-value="total_paid + paid_amount"/>
                                </t>
                                <tr class="font-weight-bold">
                                    <td colspan="4" class="text-right">Total Paid:</td>
                                    <td class="text-right">
                                        <span t-esc="total_paid" 
                                            t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </t>

                <t t-if="o.payment_type == 'inbound'">
                    <t t-set="reconciled_invoices" t-value="o.reconciled_invoice_ids"/>
                    <t t-if="reconciled_invoices">
                        <h5 class="mt-4">Reconciled Invoices</h5>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Invoice Date</th>
                                    <th>Invoice Number</th>
                                    <th>Reference</th>
                                    <th class="text-right">Invoice Amount</th>
                                    <th class="text-right">Paid Amount</th>
                                    <th class="text-right">Balance Due</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="total_paid" t-value="0"/>
                                <t t-foreach="reconciled_invoices" t-as="invoice">
                                    <t t-set="paid_amount" t-value="0"/>
                                    <t t-foreach="o.move_id.line_ids.filtered(lambda l: l.account_id.user_type_id.type in ('receivable', 'payable'))" t-as="payment_line">
                                        <t t-foreach="payment_line.matched_debit_ids | payment_line.matched_credit_ids" t-as="partial">
                                            <t t-set="reconciled_line" t-value="partial.debit_move_id if partial.credit_move_id == payment_line else partial.credit_move_id"/>
                                            <t t-if="reconciled_line.move_id == invoice">
                                                <t t-set="paid_amount" t-value="paid_amount + partial.amount"/>
                                            </t>
                                        </t>
                                    </t>
                                    <tr>
                                        <td><span t-field="invoice.invoice_date"/></td>
                                        <td><span t-field="invoice.name"/></td>
                                        <td><span t-field="invoice.ref"/></td>
                                        <td class="text-right">
                                            <span t-field="invoice.amount_total"
                                                t-options="{'widget': 'monetary', 'display_currency': invoice.currency_id}"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="paid_amount" 
                                                t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-esc="invoice.amount_residual" 
                                                t-options="{'widget': 'monetary', 'display_currency': invoice.currency_id}"/>
                                        </td>
                                    </tr>
                                    <t t-set="total_paid" t-value="total_paid + paid_amount"/>
                                </t>
                                <tr class="font-weight-bold">
                                    <td colspan="4" class="text-right">Total Paid:</td>
                                    <td class="text-right">
                                        <span t-esc="total_paid" 
                                            t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>
                </t>
                </t>
            </main>
        </t>
    </template>
        
    <!-- Wrapper template -->
    <template id="report_payment_voucher">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang or o.company_id.partner_id.lang"/>
                <t t-call="hr_payroll_report.report_payment_voucher_document" t-lang="lang"/>
            </t>
        </t>
    </template>
</odoo>
