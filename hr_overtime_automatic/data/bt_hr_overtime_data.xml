     </record> -->

     <record id="hr_payslip_input_type_input" model="hr.payslip.input.type">
        <field name="name">Overtime</field>
        <field name="code">OT100</field>
        <field name="country_id" ref="base.us"/>
     </record>

      <record id="action_run_overtime_scheduler_mail" model="ir.actions.server" >
            <field name="name">Run Overtime Scheduler</field>
            <field name="model_id" ref="model_bt_hr_overtime"/>
            <field name="binding_model_id" ref="hr_overtime_automatic.model_bt_hr_overtime"/>
            <field name="state">code</field>
            <field name="code">   
    if records:
        records.run_overtime_scheduler()
            </field>
        </record>

</odoo>
