<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>    
		<record id="ot_approval_view_form" model="ir.ui.view">
			<field name="name">ot.approval.view</field>
			<field name="model">ot.approval</field>
			<field name="arch" type="xml">
				<form string="Overtime Approval">
					<group>
						<group colspan='6'>
							<field name="employee_ids" widget="many2many_tags"/>
						</group>
						<group>
							<field name="state" widget="radio"/>
						</group>
					</group>
					<footer>
						<button name="action_submit" type="object" string="Submit" groups="base.group_user" attrs="{'invisible':[('state', '!=', 'draft')]}"/>
	                	<button name="action_approve" type="object" string="Approve" groups="hr.group_hr_manager" attrs="{'invisible':[('state', '!=', 'confirm')]}"/>
	                	<button name="action_refuse" type="object" string="Refuse" groups="hr.group_hr_manager" attrs="{'invisible':[('state', '!=', 'confirm')]}"/>
						<button string="Cancel" class="oe_link" special="cancel" />
					</footer>
				</form>
			</field>
		</record>

		<record id="ot_approval_act" model="ir.actions.act_window">
			<field name="name">Overtime Approval</field>
			<field name="res_model">ot.approval</field>
			<field name="view_mode">form</field>
			<field name="view_id" ref="ot_approval_view_form" />
			<field name="target">new</field>
			<field name="binding_model_id" ref="hr_overtime_automatic.model_bt_hr_overtime"/>
		</record>
	</data>
</odoo>
