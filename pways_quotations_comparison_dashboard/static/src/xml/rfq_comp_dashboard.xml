                                        </td>
                                    </t>
                                </t> -->
                                <t t-foreach="partner_ids" t-as="partner_id">
                                <t t-set="matching_line" t-value="None"/>
                                <t t-foreach="record['record_lines']" t-as="line">
                                    <t t-if="line.vendor_id == partner_id['id']">
                                        <t t-set="matching_line" t-value="line"/>
                                    </t>
                                </t>
                                
                                <t t-if="matching_line and matching_line.line_id != 0">
                                    <t t-if="matching_line.option == 'by_price'">
                                        <td style="background: ghostwhite; color: black;" >
                                            <span data-toggle="tooltip" t-att-title="matching_line.message">
                                                <div class="row" style="display: flex;">
                                                    <div style="width:43%; text-align: center;"><t t-esc="matching_line.unit_price"/></div>
                                                    <div style="width:42%; text-align: center;"><span t-esc="matching_line.qty"/></div>
                                                    <div style="width:15%; text-align: left; ">
                                                        <button class="fa fa-trash remove_line" 
                                                                t-att-data-id="matching_line.line_id"
                                                                t-att-data-vendor="matching_line.vendor_name"
                                                                t-att-data-product="record['product_name']"/>
                                                    </div>
                                                </div>
                                            </span>
                                        </td>
                                    </t>
                                    <t t-elif="matching_line.option == 'by_date'">
                                        <td style="background: ghostwhite; color: black;">
                                            <span data-toggle="tooltip" t-att-title="matching_line.message">
                                                <div class="row" style="display: flex;">
                                                    <div style="width:43%; text-align: center;"><t t-esc="matching_line.unit_price"/></div>
                                                    <div style="width:42%; text-align: center;"><span t-esc="matching_line.qty"/></div>
                                                    <div style="width:15%; text-align: left; ">
                                                        <button class="fa fa-trash remove_line" 
                                                                t-att-data-id="matching_line.line_id"
                                                                t-att-data-vendor="matching_line.vendor_name"
                                                                t-att-data-product="record['product_name']"/>
                                                    </div>
                                                </div>
                                            </span>
                                        </td>
                                    </t>
                                    <t t-else="">
                                        <td>
                                            <span data-toggle="tooltip" t-att-title="matching_line.message">
                                                <div class="row" style="display: flex;">
                                                    <div style="width:43%; text-align: center;"><t t-esc="matching_line.unit_price"/></div>
                                                    <div style="width:42%; text-align: center;"><span t-esc="matching_line.qty"/></div>
                                                    <div style="width:15%; text-align: left; ">
                                                        <button class="fa fa-trash remove_line" 
                                                                t-att-data-id="matching_line.line_id"
                                                                t-att-data-vendor="matching_line.vendor_name"
                                                                t-att-data-product="record['product_name']"/>
                                                    </div>
                                                </div>
                                            </span>
                                        </td>
                                    </t>
                                </t>
                                <t t-else="">
                                    <td>
                                        <div class="row" style="display: flex;">
                                            <div style="width:43%; text-align: center;"></div>
                                            <div style="width:42%; text-align: center;"></div>
                                            <div style="width:15%; text-align: center;"></div>
                                        </div>
                                    </td>
                                </t>
                            </t>
                        </tr>
                    </t>
                    <tr>
                        <td class="headcol" style="height: 68px;"></td>
                        <t t-foreach="total" t-as="t">
                            <t t-if="t.option == 'by_price'">
                                <td class="table_footer" style="background: ghostwhite; color: black; height: 61px;">
                                    <div class="row"  style="margin-left: -6px;">
                                        <div class="footer_left_row" style="float:left; text-align:left; margin-left: auto;">
                                            Total: <span t-esc="t.subtotal"/>
                                        </div>
                                        <div class="footer_right_row" style="float:right; text-align:right; margin-right: auto;">
                                            Delivery Date: <span t-esc="t.delivery_date"/>
                                        </div>
                                    </div>
                                    <div style=" text-align: center; margin-left: 12px;">
                                        <t t-if="t.state == 'draft' or t.state == 'sent'">
                                            <input class="conform_order" type="button" value="Confirm" t-att-data-id="t.id"/>
                                            <input class="update_tender" type="button" value="Update Tender" t-att-data-id="t.id" style="margin-left:10px;"/>
                                        </t>
                                        <t t-elif="t.state == 'cancel'">
                                            <span>Order Canceled...</span>
                                        </t>
                                        <t t-else="">
                                            <span>Order Cofirmed...</span>
                                        </t>
                                    </div>
                                </td>
                            </t>
                            <t t-elif="option == 'by_date'">
                                <td class="table_footer" style="background: ghostwhite; color: black; height: 61px;">
                                    <div class="row"  style="margin-left: -6px;">
                                        <div class="footer_left_row" style="float:left; text-align:left; margin-left: auto;">
                                            Total: <span t-esc="t.subtotal"/>
                                        </div>
                                        <div class="footer_right_row" style="float:right; text-align:right; margin-right: auto;">
                                            Delivery Date: <span t-esc="t.delivery_date"/>
                                        </div>
                                    </div>
                                    <div style=" text-align: center; margin-left: 12px;">
                                        <t t-if="t.state == 'draft' or t.state == 'sent'">
                                            <input class="conform_order" type="button" value="Confirm" t-att-data-id="t.id"/>
                                            <input class="update_tender" type="button" value="Update Tender" t-att-data-id="t.id" style="margin-left:10px;"/>
                                        </t>
                                        <t t-elif="t.state == 'cancel'">
                                            <span>Order Canceled...</span>
                                        </t>
                                        <t t-else="">
                                            <span>Order Cofirmed...</span>
                                        </t>
                                    </div>
                                </td>
                            </t>
                            <t t-else="">
                                <td class="table_footer" style="height: 61px;">
                                    <div class="row"  style="margin-left: -6px;">
                                        <div class="footer_left_row" style="float:left; text-align:left; margin-left: auto;">
                                            Total: <span t-esc="t.subtotal"/>
                                        </div>
                                        <div class="footer_right_row" style="float:right; text-align:right; margin-right: auto;">
                                            Delivery Date: <span t-esc="t.delivery_date"/>
                                        </div>
                                    </div>
                                    <div style=" text-align: center; margin-left: 12px;">
                                        <t t-if="t.state == 'draft' or t.state == 'sent'">
                                            <input class="conform_order" type="button" value="Confirm" t-att-data-id="t.id"/>
                                            <input class="update_tender" type="button" value="Update Tender" t-att-data-id="t.id" style="margin-left:10px;"/>
                                        </t>
                                        <t t-elif="t.state == 'cancel'">
                                            <span>Order Canceled...</span>
                                        </t>
                                        <t t-else="">
                                            <span>Order Cofirmed...</span>
                                        </t>
                                    </div>
                                </td>
                            </t>
                        </t>
                    </tr>
                </tbody>
            </table>
        </div>
    </t>
</templates>
