<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data  noupdate="1">
        <record id="seq_trip_sheets" model="ir.sequence">
            <field name="name">Trip Sheets</field>
            <field name="code">custom.trip.sheet</field>
            <field name="prefix">Trip/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="product_minimum_charge_product" model="product.product">
            <field name="name">Minimum Charge</field>
            <!-- <field name="categ_id"  ref="product.product_category_3"/> -->
            <field name="default_code">MinimumCharge</field>
            <field name="uom_id" ref="uom.product_uom_kgm"/>
            <field name="uom_po_id" ref="uom.product_uom_kgm"/>
        </record>
            
        <record id="product_extra_charge_product" model="product.product">
            <field name="name">Extra Charge</field>
            <!-- <field name="categ_id"  ref="product.product_category_3"/> -->
            <field name="default_code">ExtraCharge</field>
            <field name="uom_id" ref="uom.product_uom_kgm"/>
            <field name="uom_po_id" ref="uom.product_uom_kgm"/>
        </record>
        
        <record id="product_add_equipment_charge_product" model="product.product">
            <field name="name">Add Equipment Charge</field>
            <!-- <field name="categ_id"  ref="product.product_category_3"/> -->
            <field name="default_code">AddEquipmentCharge</field>
            <field name="uom_id" ref="uom.product_uom_kgm"/>
            <field name="uom_po_id" ref="uom.product_uom_kgm"/>
        </record>
        
        <record id="product_visit_charge_product" model="product.product">
            <field name="name">Visit Charge</field>
            <!-- <field name="categ_id"  ref="product.product_category_3"/> -->
            <field name="default_code">VisitCharge</field>
            <field name="uom_id" ref="uom.product_uom_kgm"/>
            <field name="uom_po_id" ref="uom.product_uom_kgm"/>
        </record>
    </data>
</odoo>
