<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_check_ps_document_expiry" model="ir.cron">
        <field name="name">Check PS Vehicle Document Expiry</field>
        <field name="model_id" ref="model_fleet_vehicle"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_document_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_check_insurance_expiry" model="ir.cron">
        <field name="name">Check Vehicle Insurance Expiry</field>
        <field name="model_id" ref="model_fleet_vehicle"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_insurance_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>