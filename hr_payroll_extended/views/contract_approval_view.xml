<?xml version="1.0"?>
<odoo>
    <record id="contract_approval_process_view_tree" model="ir.ui.view">
        <field name="name">reccontract.approval.process.view.tree</field>
        <field name="model">contract.approval.process</field>
        <field name="arch" type="xml">
            <tree create="false">
                <field name="name"/>
            </tree>
        </field>
    </record>
    
    <record id="contract_approval_process_view_form" model="ir.ui.view">
        <field name="name">contract.approval.process.view.form</field>
        <field name="model">contract.approval.process</field>
        <field name="arch" type="xml">
            <form string="Record Approval" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="activity_type_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Approver">
                            <field name="approver_ids">
                                <tree editable="bottom">
                                    <field name="user_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    
    <record id='action_contract_approval_process' model='ir.actions.act_window'>
        <field name="name">Contract Approval</field>
        <field name="res_model">contract.approval.process</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_contract_approval_process"
        name="Contract Approval Setting"
        parent="base.menu_users"
        action="action_contract_approval_process"
        groups="group_hr_contract_approver,base.group_system,base.group_erp_manager"/>
    
    
    
    <record id="contract_approval_records_tree" model="ir.ui.view">
        <field name="name">contract approval records</field>
        <field name="model">contract.approval.records</field>
        <field name="arch" type="xml">
            <tree create="false">
                <field name="user_id"/>
                <field name="contract_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    
    <record id="contract_approval_records_view_form" model="ir.ui.view">
        <field name="name">contract.approval.records.view.form</field>
        <field name="model">contract.approval.records</field>
        <field name="arch" type="xml">
            <form string="Record Approval" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="contract_id"/>
                            <field name="activity_id"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="active" invisible="1"/>
                            <field name="contract_active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    
    <record id='action_contract_approval_records' model='ir.actions.act_window'>
        <field name="name">Contract Approval Records</field>
        <field name="res_model">contract.approval.records</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_contract_approval_records"
        name="Contract Approval Records"
        parent="base.menu_users"
        action="action_contract_approval_records"
        groups="group_hr_contract_approver,base.group_system,base.group_erp_manager"/>
    
    
    <record id="act_contract_approval_records" model="ir.actions.act_window">
        <field name="name">Contract Approval Records</field>
        <field name="res_model">contract.approval.records</field>
        <field name="view_mode">tree</field>
        <field name="target">new</field>
        <field name="context">{'default_contract_id':active_id}</field>
    </record>

</odoo>
