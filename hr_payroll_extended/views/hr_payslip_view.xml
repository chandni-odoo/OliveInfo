<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ref_field_hr_payslip_form_inherit_loan_view" model="ir.ui.view">
            <field name="name">hr.payslip.inherit.ref.form1</field>
            <field name="model">hr.payslip</field>
            <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='input_line_ids']//tree//field[@name='sequence']" position="after">
                    <field name="ref"/>
                    <field name="is_other_earning" invisible="1"/>
                    <field name="is_overtime" invisible="1"/>
                    <field name="is_loan" invisible="1"/>
                </xpath>
            </field>
        </record>

        <record id="hr_payslip_employees_form_inherit" model="ir.ui.view">
            <field name="name">hr.payslip.employees.form</field>
            <field name="model">hr.payslip.employees</field>
            <field name="inherit_id" ref="hr_payroll.view_hr_payslip_by_employees"/>
            <field name="arch" type="xml">
                <xpath expr="//group" position="before">
                    <group>
                        <field name="payroll_batch_id"/>
                    </group>
                </xpath>
            </field>
        </record>

        <record id="hr_payslip_run_form_inherit" model="ir.ui.view">
            <field name="name">hr.payslip.run.form</field>
            <field name="model">hr.payslip.run</field>
            <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group" position="before">
                    <label for="payroll_batch_id" string="Payroll Batch"/>
                    <h1>
                        <field name="payroll_batch_id"/>
                    </h1>
                </xpath>
                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//label[@for='name']" position="replace">
                </xpath>
            </field>
        </record>

        <record id="edit_hr_payslip_form_inherit" model="ir.ui.view">
            <field name="name">hr.payslip.form.form</field>
            <field name="model">hr.payslip</field>
            <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='worked_days_input']/field[@name='worked_days_line_ids']"
                       position='attributes'>
                    <attribute name="groups">hr_payroll_extended.group_hr_payroll_worked_days</attribute>
                </xpath>
                <xpath expr="//page[@name='worked_days_input']/separator[1]" position='attributes'>
                    <attribute name="groups">hr_payroll_extended.group_hr_payroll_worked_days</attribute>
                </xpath>
                <xpath expr="//page[@name='worked_days_input']/separator[1]" position='before'>
                    <group>
                        <group>
                            <field name="salary_days"/>
                            <field name="attendance_days"/>
                            <field name="shift_days"/>
                            <field name="absent_day"/>
                        </group>
                        <group>
                            <field name="present_day"/>
                            <field name="public_holidays"/>
                            <field name="leave_day"/>
                            <field name="unpaid_day"/>
                            <!-- <field name="paid_sick_leave" attrs="{'invisible': [('is_paid_sick', '!=', True)]}"/>
                            <field name="unpaid_sick_leave" attrs="{'invisible': [('is_unpaid_sick', '!=', True)]}"/>
                            <field name="is_paid_sick" invisible="1"/>
                            <field name="is_unpaid_sick" invisible="1"/> -->
                        </group>
                    </group>
                </xpath>
                <field name="contract_id" position="after">
                    <field name="code" readonly="1"/>
                </field>
                <xpath expr="//field[@name='amount']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <record model="ir.actions.server" id="action_hr_payroll_set_draft_payroll">
            <field name="name">Set to Draft</field>
            <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
            <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
                if records:
                records.action_payslip_draft()
            </field>
        </record>

        <record id="edit_holiday_status_form_inherit" model="ir.ui.view">
            <field name="name">hr.leave.type.form.form</field>
            <field name="model">hr.leave.type</field>
            <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
            <field name="arch" type="xml">
                <field name="allocation_validation_type" position="after">
                    <field name="is_paid"/>
                    <field name="other_input_type"/>
                </field>
                <field name='allocation_validation_type' position="after">
                    <field name='is_sick_leave'/>
                </field>
            </field>
        </record>

