         <record id="res_users_view_form_inherits" model="ir.ui.view">
            <field name="name">res.users.form</field>
            <field name="model">res.users</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Exta Details">
                       <group col="4">
                          <field name="is_approve_by_user" invisible='1'/>
                          <field name="click_count" invisible="1"/>
                        </group>
                     </page>
                </xpath>
            </field>
        </record>

        <record id="hr_contract_view_form_inherit" model="ir.ui.view">
            <field name="name">hr.contract.form</field>
            <field name="model">hr.contract</field>
            <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
            <field name="arch" type="xml">
                <field name="hr_responsible_id" position="after">
                    <field name='has_payslip' invisible='1'/>
                    <field name="min_time" widget="float_time" required="1"
                           attrs="{'readonly': [('has_payslip', '=', True)]}"/>
                    <field name="max_time" widget="float_time" required="1"
                           attrs="{'readonly': [('has_payslip', '=', True)]}"/>
                    <field name="structure_id" required="1" attrs="{'readonly': [('has_payslip', '=', True)]}"/>
                    <field name="gross_amount" attrs="{'readonly': [('has_payslip', '=', True)]}"/>
                    <field name="net_amount" attrs="{'readonly': [('has_payslip', '=', True)]}"/>
                </field>

                <xpath expr="//field[@name='name']" position="after">
                    <group><field name="reject_reason" style="background-color:red;" attrs="{'invisible' : [('state', 'not in', ['rejects'])]}"/>
                
                </group>
                </xpath>
                <xpath expr="//form//header" position="inside">
                    <button name="submit_contract" type="object" string="Submit Contract" attrs="{'invisible' : [('state', 'not in', ['draft'])]}"/>
                    <button name="send_to_expiry" type="object" string="Expire" attrs="{'invisible' : [('state', 'not in', ['open'])]}"/>
                    <button name="send_to_cancel" type="object" string="Cancel" attrs="{'invisible' : [('state', 'not in', ['open'])]}"/>
                    <button name="resubmit_contract" type="object" string="Re-Submit Contract" attrs="{'invisible' : [('state', 'not in', ['rejects'])]}"/>
                    <button name="approve_contract" type="object" string="Approve" attrs="{'invisible' : [('state', 'not in', ['approval'])]}" groups="hr_payroll_extended.group_hr_contract_approver"/>
                    <button name="open_approval_status" string="Approval Status" attrs="{'invisible' : [('state', 'not in', ['approval','open','rejects'])]}" type="object"/>
                    <button name="contract_reject" type="object" string="Reject" attrs="{'invisible' : [('state', 'not in', ['approval'])]}" groups="hr_payroll_extended.group_hr_contract_approver"/>
                    <!--<button name="approve_emp_contract" groups="hr_payroll_extended.group_hr_contract_approver" 
                        type="object" string="Approve Contract" attrs="{'invisible' : [('state', 'not in', ['approval'])]}"/>
                    
                    <button name="%(hr_payroll_extended.reject_reason_emp_contract)d" string="Reject Contract" type="action" groups="hr_payroll_extended.group_hr_contract_approver" attrs="{'invisible' : [('state', 'not in', ['approval'])]}"/>


                    <button name="notify_contract_info" type="object" string="Notify Contract" class="oe_highlight" attrs="{'invisible' : ['|',('state', 'not in', ['approval']),('is_approve_user','=',False)]}"
                    /> -->
                </xpath>
                <xpath expr="//form//header/field[@name='state']" position="attributes">
                    <attribute name="readonly">1</attribute>
                </xpath>
<!--                <xpath expr="//field[@name='state']" position="replace">-->
<!--                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,to_approve,sale"/>-->
<!--                </xpath>-->

                <xpath expr="//field[@name='gross_amount']" position="attributes">
                    <attribute name="groups">hr_payroll_extended.group_hr_contract_edit_view</attribute>
                </xpath>
                <xpath expr="//field[@name='net_amount']" position="attributes">
                    <attribute name="groups">hr_payroll_extended.group_hr_contract_edit_view</attribute>
                </xpath>
                <xpath expr="//form//sheet//notebook//page[@name='information']" position="attributes">
                    <attribute name="groups">hr_payroll_extended.group_hr_contract_edit_view</attribute>
                </xpath>



                <xpath expr="//notebook//page//group[@name='yearly_advantages']" position="after">
                    <separator string="Allowance/Deduction"/>
                    <field name="allowance_ids" attrs="{'readonly': [('has_payslip', '=', True)]}">
                        <tree editable="bottom">
                            <field name="category_id" required="1"/>
                            <field name="name" required="1"/>
                            <field name="code" required="1"/>
                            <field name="amount"/>
                            <field name="contract_id" invisible="1"/>
                        </tree>
                    </field>
                </xpath>
                <xpath expr="//field[@name='structure_type_id']" position="attributes">
                    <attribute name="required">1</attribute>
                    <attribute name="attrs">{'readonly': [('has_payslip', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='employee_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('has_payslip', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='date_start']" position="attributes">
                    <attribute name="attrs">{'readonly': [('has_payslip', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='date_end']" position="attributes">
                    <attribute name="attrs">{'readonly': [('has_payslip', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='department_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('has_payslip', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='job_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('has_payslip', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='resource_calendar_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('has_payslip', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='wage']" position="attributes">
                    <attribute name="attrs">{'readonly': [('has_payslip', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='hr_responsible_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('has_payslip', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='contract_type_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('has_payslip', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='notes']" position="attributes">
                    <attribute name="attrs">{'readonly': [('has_payslip', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='analytic_account_id']" position="attributes">
                    <attribute name="attrs">{'readonly': [('has_payslip', '=', True)]}</attribute>
                </xpath>
                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="attrs">{'readonly': [('has_payslip', '=', True)]}</attribute>
                </xpath>
            </field>
        </record>

        <record id="hr_contract_inherit_search_today_approve" model="ir.ui.view">
        <field name="name">hr.contract.search.approve</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='activities_overdue']" position="after">
                <separator/>
                <filter string="Waiting For Approval" name="is_approve_today" domain="[('state','=','approval')]"/>
                <separator/>
            </xpath>
        </field>
    </record>

