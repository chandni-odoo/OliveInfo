<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="multi_approval_view_tree" model="ir.ui.view">
        <field name="name">multi_approval_view_tree</field>
        <field name="model">multi.approval</field>
        <field name="arch" type="xml">
            <tree import="false">
                <field name="priority" widget="priority"/>
                <field name="code"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="request_date"/>
                <field name="pic_id"/>
                <field name="deadline"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="multi_approval_view_filter" model="ir.ui.view">
        <field name="name">multi_approval_view_filter</field>
        <field name="model">multi.approval</field>
        <field name="arch" type="xml">
            <search string="Approvals">
                <filter string="My Request" name="my_request" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <field name="code"/>
                <field name="name"/>
                <separator/>
                <filter string="My Approvals" name="my_approval" domain="[('pic_id','=',uid)]"/>
                <filter string="To Review" name="to_review"
                        domain="[('pic_id','=', uid), ('state', '=', 'Submitted')]"/>
                <separator/>
                <field name="user_id"/>
                <field name="pic_id"/>
                <field name="type_id"/>
                <group expand="1" string="Group By">
                    <filter string="User" name='user' context="{'group_by':'user_id'}"/>
                    <filter string="Type" name="type_id" context="{'group_by':'type_id'}"/>
                    <filter string="Status" name="status" context="{'group_by':'state'}"/>
                    <separator orientation="vertical"/>
                    <filter string="Request Date" name="date" context="{'group_by':'request_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="multi_approval_view_form" model="ir.ui.view">
        <field name="name">multi_approval_view_form</field>
        <field name="model">multi.approval</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name='is_pic' invisible="1"/>

                    <!-- Submit Button -->
                    <button name="action_submit" type="object" string="Submit"
                            attrs="{'invisible': [('state', '!=', 'Draft')]}" class="oe_highlight"/>

                    <!-- Approve Button -->
                    <button name="action_approve" type="object" string="Approve"
                            attrs="{'invisible': [('state', '!=', 'Submitted')]}" class="oe_highlight"/>

                    <!-- Refuse Button -->
                    <button name="%(multi_level_approval.refused_reason_action)d" type="action"
                            attrs="{'invisible': [('is_pic', '=', False), ('state', '!=', 'Submitted')]}"/>

                    <!-- Attach Document Widget (first) -->
                    <widget name="attach_document" string="Attach Document" action="message_post"
                            attrs="{'invisible': [('document_opt', '!=', 'Required'), ('attachment_number', '!=', False), ('id', '=', False)]}"/>

                    <!-- Attach Document Widget (highlighted) -->
                    <widget name="attach_document" string="Attach Document" action="message_post" highlight="1"
                            attrs="{'invisible': [('document_opt', '!=', 'Required'), ('attachment_number', '!=', False), ('id', '=', False)]}"/>

                    <!-- Cancel Button -->
                    <button name="action_cancel" type="object" string="Cancel"
                            attrs="{'invisible': [('state', '!=', 'Draft')]}"/>

                    <!-- Statusbar -->
                    <field name="state" widget="statusbar" statusbar_visible="Draft,Submitted,Approved,Cancel"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="code" readonly="1"/>
                        </h1>
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Title" attrs="{'readonly': [('state', '!=', 'Draft')]}"/>
                        </h1>
                        <field name="priority" widget="priority" attrs="{'readonly': [('state', '!=', 'Draft')]}"/>
                    </div>
                    <div style="background: rgb(245, 245, 245);margin: 0px !important;padding: 10px;border: 1px solid rgb(207, 207, 207);">
                        <group>
                            <group>
                                <field name="user_id" readonly="1"/>
                                <field name="request_date" attrs="{'readonly': [('state', '!=', 'Draft')]}"/>
                                <field name="type_id" attrs="{'readonly': [('state', '!=', 'Draft')]}"
                                       options="{'no_create': True, 'no_open': True}"/>
                                <field name="deadline" readonly="1"/>
                                <field name="pic_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="contact_id" readonly="1"
                                       attrs="{'invisible': [('contact_opt', 'in', ['None', False])], 'required': [('contact_opt', '=', 'Required')]}"/>

                                <field name="date"
                                       attrs="{'readonly': [('state', '!=', 'Draft')],'invisible': [('date_opt', 'in', ['None', False])],'required': [('date_opt', '=', 'Required')]}"/>

                                <label for="date_start" string="Period"
                                       attrs="{'invisible': [('period_opt', 'in', ['None', False])]}"/>
                                <div attrs="{'invisible': [('period_opt', 'in', ['None', False])]}">
                                    <div>
                                        <span>From:</span>
                                        <field name="date_start" class="oe_inline"
                                               attrs="{'readonly': [('state', '!=', 'Draft')],'required': [('payment_opt', '=', 'Required')]}"/>
                                    </div>
                                    <div>
                                        <span>to:</span>
                                        <field name="date_end" class="oe_inline"
                                               attrs="{'readonly': [('state', '!=', 'Draft')],'required': [('payment_opt', '=', 'Required')]}"/>
                                    </div>
                                </div>
                                <field name="item_id"
                                       attrs="{'readonly': [('state', '!=', 'Draft')], 'invisible': [('item_opt', 'in', ['None', False])], 'required': [('payment_opt', '=', 'Required')]}"/>
                                <field name="quantity"
                                       attrs="{'readonly': [('state', '!=', 'Draft')], 'invisible': [('item_opt', 'in', ['None', False])], 'required': [('payment_opt', '=', 'Required')]}"/>
                                <field name="amount"
                                       attrs="{'readonly': [('state', '!=', 'Draft')], 'invisible': [('item_opt', 'in', ['None', False])], 'required': [('payment_opt', '=', 'Required')]}"/>
                                <field name="payment"
                                       attrs="{'readonly': [('state', '!=', 'Draft')],'invisible': [('payment_opt', 'in', ['None', False])],'required': [('payment_opt', '=', 'Required')]}"/>
                                <field name="reference"
                                       attr="{'readonly': state != 'Draft','invisible': [('reference_opt' in ('None', False))],required : ['(reference_opt', '=', 'Required')]}"/>
                                <field name="location"
                                       attr="{'readonly': state != 'Draft','invisible': [('item_opt' in ('None',False)]),required: [('location_opt', '=', 'Required')]  }"/>
                            </group>
                        </group>
                        <group string="Items"
                               attrs="{'invisible': [('multi_items_opt', 'in', ['None', False])]}">
                            <field name="item_ids" nolabel="1" colspan="2"
                                   attrs="{'readonly': [('state', '!=', 'Draft')],'invisible': [('multi_items_opt', 'in', ['None', False])],'required': [('multi_items_opt', '=', 'Required')]}"/>
                        </group>
                    </div>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" nolabel="1" placeholder="Description"
                                   attrs="{'readonly': [('state', '!=', 'Draft')]}"/>
                        </page>
                        <page string="Approver(s)" name="approver"
                              attrs="{'invisible': [('state', 'in', ['Draft', 'Cancel'])]}">
                            <field name="line_ids">
                                <tree editable="top" create="false" delete="false">
                                    <field name="name" readonly="1"/>
                                    <field name="user_id" readonly="1"/>
                                    <field name="require_opt" readonly="1"/>
                                    <field name="deadline"
                                           attrs="{'readonly': [('state', 'not in', ['Draft', 'Waiting for Approval'])]}"/>
                                    <field name="state" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Options" name="options" invisible="1">
                            <group string="Fields" name="option_settings">
                                <group>
                                    <field name="document_opt" widget="radio" options="{'horizontal': true}"/>
                                    <field name="contact_opt" widget="radio" options="{'horizontal': true}"/>
                                    <field name="date_opt" widget="radio" options="{'horizontal': true}"/>
                                    <field name="period_opt" widget="radio" options="{'horizontal': true}"/>
                                    <field name="item_opt" widget="radio" options="{'horizontal': true}"/>
                                    <field name="multi_items_opt" widget="radio" options="{'horizontal': true}"/>
                                </group>
                                <group>
                                    <field name="quantity_opt" widget="radio" options="{'horizontal': true}"/>
                                    <field name="amount_opt" widget="radio" options="{'horizontal': true}"/>
                                    <field name="payment_opt" widget="radio" options="{'horizontal': true}"/>
                                    <field name="reference_opt" widget="radio" options="{'horizontal': true}"/>
                                    <field name="location_opt" widget="radio" options="{'horizontal': true}"/>
                                    <field name="attachment_number"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="multi_approval_view_kanban" model="ir.ui.view">
        <field name="name">multi_approval_view_kanban</field>
        <field name="model">multi.approval</field>
        <field name="arch" type="xml">
            <kanban class="o_modules_kanban" import="false">
                <field name="name"/>
                <field name="id"/>
                <field name="image"/>
                <field name="code"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <t t-if="record.id">
                                <img
                                        t-att-src="kanban_image('multi.approval', 'image', record.id.raw_value)"
                                        alt="Approval Image"
                                        class="oe_kanban_avatar float-left mr-3"
                                        width="64"
                                        height="64"
                                />
                            </t>
                            <div class="oe_module_desc">
                                <h4 class="o_kanban_record_title">
                                    <field name="code"/>
                                </h4>
                                <p class="oe_module_name">
                                    <field name="name"/>
                                </p>
                                <div class="oe_module_action" t-if="!selection_mode">
                                    <p class="">
                                        <field name="priority" widget="priority"/>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
