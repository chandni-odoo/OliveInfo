<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_approval_email_tree_view" model="ir.ui.view">
        <field name="name">hr.approval.email.tree.view</field>
        <field name="model">hr.approval.email</field>
        <field name="arch" type="xml">
            <tree>
                <field name="branch_id"/>
                <field name="document_type"/>
            </tree>
        </field>
    </record>

    <record id="hr_approval_eamil_form_view" model="ir.ui.view">
        <field name="name">hr.approval.email.form.view</field>
        <field name="model">hr.approval.email</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="branch_id"/>
                        </group>
                        <group>
                            <field name="document_type"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Approval Lines">
                            <field name="approval_line_ids" mode="tree">
                                <tree editable="bottom">
                                    <field name="user_id"/>
                                    <field name="limit"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_approval_email" model="ir.actions.act_window">
        <field name="name">HR Approval Email</field>
        <field name="res_model">hr.approval.email</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem 
        id="menu_hr_approval_email"
        name="HR Approval Email"
        action="action_hr_approval_email"
        parent="base.menu_users"
        sequence="25"
        />

    <!-- Email Olive Info -->
    <record id="view_email_notification_management_tree" model="ir.ui.view">
        <field name="name">Email Notification Management Tree</field>
        <field name="model">email.notification.management</field>
        <field name="arch" type="xml">
            <tree>
                <field name="customer_service_email"/>
                <field name="scheduler_email"/>
                <field name="accommodation_email"/>
                <field name="procurement_email"/>
            </tree>
        </field>
    </record>
    <record id="view_email_notification_management_form" model="ir.ui.view">
        <field name="name">Email Notification Management Form</field>
        <field name="model">email.notification.management</field>
        <field name="arch" type="xml">
            <!-- Define the form view layout -->
            <form string="Email Notification Management">
                <sheet>
                    <group>
                        <group string="Sale Email's">
                            <field name="customer_service_email"/>
                            <field name="scheduler_email"/>
                        </group>
                        <group string="Employee Email's">
                            <field name="accommodation_email"/>
                            <field name="procurement_email"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_email_notification_management" model="ir.actions.act_window">
        <field name="name">Email Notification Management</field>
        <field name="res_model">email.notification.management</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem 
        id="menu_email_notification_management"
        name="Email Management"
        action="action_email_notification_management"
        parent="base.menu_users"
        sequence="26"
        />


</odoo>
