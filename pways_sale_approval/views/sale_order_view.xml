<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Sale order Inherit Form View to Modify it -->
        <record id="view_order_form_inherit_approval" model="ir.ui.view">
            <field name="name">view.order.form.inherit.approval</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_quotation_send']" position="after">
                    <button name="too_approve" type="object" class="oe_highlight" string="Submit" attrs="{'invisible':[('sale_approval', '=', False)]}"/>
                </xpath>
                <field name="branch_id" position="after">
                    <field name="has_approval" invisible="1"/>
                    <field name="sale_approval" invisible="1"/>
                </field>
                <xpath expr="//field[@name='state']" position="before">
                    <button string="Approval" name="action_approval" type="object" attrs="{'invisible': [('has_approval', '=', False)]}" class="oe_highlight"/>
                    <button string="Reject" name="%(pways_sale_approval.sale_approval_rejected_action)d" type="action" attrs="{'invisible': [('has_approval', '=', False)]}"/>
                </xpath>
                <xpath expr="//notebook[last()]" position="inside">
                    <page string="Approver History">
                        <field name="sale_history_ids" mode="tree">
                            <tree editable="bottom">
                                <field name="user_id"/>
                                <field name="status"/>
                                <field name="date_done"/>
                                <field name="document_type"/>
                            </tree>
                        </field>
                        <group>
                            <field name="reject_reason" label="Reject Reason" readonly="1"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
