<odoo>
    <data>

        <record id="sending_mail_template" model="mail.template">
            <field name="name">Notification</field>
            <field name="model_id" ref="pways_sale_approval.model_sale_order"/>
            <field name="auto_delete" eval="True"/>
            <field name="email_from">odoo@dulsco.qa</field>
            <field name="email_to">{{object.user_id.email}}</field>
            <field name="subject">{{'Need to discuss'}}</field>
            <field name="body_html" type="html">
                <div/>
            </field>
        </record>

    </data>
</odoo>
