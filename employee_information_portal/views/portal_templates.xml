                                            Certifications 
                                            <span class="badge badge-info ml-2"><t t-esc="len(employee.certification_ids)"/></span>
                                        </a>
                                    </li> -->
                                </ul>

                                <div class="tab-content mt-3" id="employeeRecordsTabContent">
                                    <div class="tab-pane fade show active" id="documents" role="tabpanel">
                                        <table class="table table-striped">
                                            <thead>
                                                <tr>
                                                    <th>Document Type</th>
                                                    <th>Document No</th>
                                                    <th>Valid From</th>
                                                    <th>Valid To</th>
                                                    <th>Document Place</th>
                                                    <th>Status</th>
                                                    <th>Remarks</th>
                                                    <th>Attachment</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="employee.ducument_line_ids" t-as="doc_line">
                                                    <tr>
                                                        <td><t t-esc="doc_line.document_line_id.name"/></td>
                                                        <td><t t-esc="doc_line.document_number"/></td>
                                                        <td><t t-esc="doc_line.valid_from" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/></td>
                                                        <td><t t-esc="doc_line.valid_to" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/></td>
                                                        <td><t t-esc="doc_line.doc_issue_place"/></td>
                                                        <td><t t-esc="doc_line.status"/></td>
                                                        <td><t t-esc="doc_line.remarks"/></td>
                                                        <td>
                                                            <t t-if="doc_line.attachment">
                                                                <a t-att-href="'/download/employee_document/%s' % doc_line.id"
                                                                download="document.pdf">
                                                                    <i class="fa fa-download"/> Download
                                                                </a>
                                                            </t>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>

                                    <!-- <div class="tab-pane fade" id="training" role="tabpanel">
