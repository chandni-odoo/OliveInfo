                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
    
    <template id="employee_information_not_found" name="Employee Information Not Found">
        <t t-call="portal.portal_layout">
            <div class="container">
                <div class="alert alert-warning">
                    <p>No employee information found for your user account. 
                       Please contact HR if you believe this is an error.</p>
                </div>
            </div>
        </t>
    </template>
