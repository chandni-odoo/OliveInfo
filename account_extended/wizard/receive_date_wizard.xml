<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="receive_date_wizard_form_view" model="ir.ui.view">
        <field name="name">receive.date.wizard</field>
        <field name="model">receive.date.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="receive_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="date_line_ids">
                                <tree editable="bottom">
                                    <field name="move_id"/>
                                    <field name="receive_date"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Set Date" name="action_set_date" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_for_receive_date_wizard" model="ir.actions.act_window">
        <field name="name">Set Receive Date</field>
        <field name="res_model">receive.date.wizard</field>
        <field name="view_mode">form</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="target">new</field>
    </record>
</odoo>
