<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_move_form_emp_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='account_id']" position="after">
                <field name='employee_id' optional="hide"/>
                <field name="type_id" optional="hide"/>
                <field name="task_id" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']//field[@name='account_id']" position="after">
                <field name='employee_id' optional="hide"/>
                <field name="type_id" optional="hide"/>
                <field name="task_id" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="code" readonly="1"/>
            </xpath>
            <xpath expr="//page[last()]" position="after">
                <page string='Comment' id='comment'>
                    <field name="comment" placeholder='comment ........' nolabel="1"/>
                </page>
            </xpath>
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="invoice_terms_id" domain="[('condition_type', '=', 'invoice')]" attrs="{'invisible': [('move_type', '!=', 'out_invoice')]}"/>
                <field name="bill_terms_id" domain="[('condition_type', '=', 'bill')]" attrs="{'invisible': [('move_type', '!=', 'in_invoice')]}"/>
            </xpath>
            <xpath expr="//div[@name='branch_div']/field[@name='branch_id']" position="attributes">
                 <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//tree//field[@name='branch_id']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']//tree//field[@name='branch_id']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_emp_fleet_inherit" model="ir.ui.view">
        <field name="name">account.move.fleet.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account_fleet.view_move_form"/>
        <field name="arch" type="xml">
              <xpath expr="//field[@name='line_ids']//field[@name='vehicle_id']" position="replace">
                <field name='vehicle_id' attrs="{'required': [('need_vehicle', '=', True), ('parent.move_type', 'in', ('in_invoice', 'in_refund', 'out_invoice'))], 'column_invisible': [('parent.move_type', 'not in', ('in_invoice', 'in_refund', 'out_invoice'))]}" optional='hidden'/>
                <field name='vehicle_id'/>
              </xpath>
              <xpath expr="//field[@name='invoice_line_ids']//field[@name='vehicle_id']" position="replace">
                <field name='vehicle_id' attrs="{'required': [('need_vehicle', '=', True), ('parent.move_type', 'in', ('in_invoice', 'in_refund', 'out_invoice'))], 'column_invisible': [('parent.move_type', 'not in', ('in_invoice', 'in_refund', 'out_invoice'))]}" optional='hidden'/>
              </xpath>
       </field>
</record>

     <record id="view_move_tree_inherit" model="ir.ui.view">
        <field name="name">account.move.tree.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_date_due']" position="attributes">
                <attribute name="widget"></attribute>
            </xpath>
        </field>
    </record>

    <record id="view_product_nit_type_inherit" model="ir.ui.view">
        <field name="name">product.product.unit.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='detailed_type']" position="after">
                <field name="unit_type_id"/>
            </xpath>
        </field>
    </record>
</odoo>
