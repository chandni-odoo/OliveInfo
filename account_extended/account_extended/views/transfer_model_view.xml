<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_transfer_model_form_inherit" model="ir.ui.view">
        <field name="name">account.transfer.model.inherit</field>
        <field name="model">account.transfer.model</field>
        <field name="inherit_id" ref="account_auto_transfer.view_transfer_model_form"/>
        <field name="arch" type="xml">
            <field name="frequency" position="after">
                <field name="branch_id"/>
            </field>
            <field name="percent" position="after">
                <field name="branch_id"/>
            </field>
            <xpath expr="//field[@name='account_ids']/tree/field[@name='name']" position="after">
                <field name="branch_id"/>
            </xpath>
            <field name="journal_id" position="after">
                <field name="transfer_template_id"/>
            </field>
        </field>
    </record>
    <record id="view_account_form_inherit" model="ir.ui.view">
        <field name="name">account.account.inherit</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">
            <field name="allowed_journal_ids" position="after">
                <field name="branch_id"/>
            </field>
        </field>
    </record>
</odoo>