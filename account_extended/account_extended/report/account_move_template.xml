<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_invoice_custom">
            <t t-call="web.html_container">
                <t t-call="account_extended.external_layout_template">
                    <t t-foreach="docs" t-as="o">
                        <div class="page">
                            <br/>
                            <br/>
                            <div class="col-12"
                                 style='border-right: 1px solid black; border-left: 1px solid black; border-top: 1px solid black;'>
                                <div class="row">
                                    <div class="col-5" style="border-right: 1px groove lightgray;">
                                        <t t-set="child_ids" t-value="o.partner_id.child_ids"/>
                                        <strong>Customer Code :</strong> &#160; &#160; &#160; &#160; &#160; &#160;
                                        <span t-esc="o.partner_id.address_no"/>
                                        <br/>
                                        <b>
                                            <span t-esc="o.partner_id.name"/>
                                        </b>
                                        <br/>
                                        <span t-esc="o.partner_id.street"/>
                                        <span t-esc="o.partner_id.street2"/>
                                        <span t-esc="o.partner_id.city"/>
                                        <span t-esc="o.partner_id.state_id.name"/>
                                        <span t-esc="o.partner_id.city"/>
                                        <span t-esc="o.partner_id.country_id.name"/>
                                        <br/>
                                        <span>P.O. Box.</span>
                                        <span t-esc="o.partner_id.zip"/>
                                        <br/>
                                        <span>Tel.No:</span>
                                        <span t-esc="o.partner_id.phone"/>
                                        <br/>
                                        <strong>Invoice Attn:</strong>
                                        <span t-if="child_ids" t-esc="child_ids[0].name"/>
                                    </div>
                                    <div class="col-3 text-left"
                                         style="border-right: 1px groove lightgray; text-align: center; padding-top: 50px;">
                                        <strong>
                                            <h4>
                                                <center>INVOICE</center>
                                            </h4>
                                        </strong>
                                    </div>
                                    <div class="col-4">
                                        <table class="table table-sm " style="border: none;">
                                            <tbody>
                                                <tr>
                                                    <td style="text-align: left; padding-top:10px;" height="35">
                                                        <span>Invoice No.</span>
                                                    </td>
                                                    <td style="padding-top:10px;">
                                                        <span t-esc="o.name" height="35"/>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="text-align: left; padding-top:10px;" height="35">
                                                        <span>Invoice Date.</span>
                                                    </td>
                                                    <td style="padding-top:10px;">
                                                        <span t-esc="o.invoice_date"
                                                              t-options='{"widget": "date","format": "dd/MM/yyyy"}'
                                                              height="35"/>
                                                    </td>
                                                </tr>
                                                <tr style="padding-top:10px;">
                                                    <td style="text-align: left; padding-top:10px;" height="25">
                                                        <span>Please Pay By.</span>
                                                    </td>
                                                    <td style="padding-top:10px;">
                                                        <span t-esc="o.invoice_date_due"
                                                              t-options='{"widget": "date","format": "dd/MM/yyyy"}'
                                                              height="25"/>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12" style='border: 1px solid black;'>
                                <table class="table table-sm table-bordered" style="width: 100%">
                                    <thead style="font-size:13px;">
                                        <tr>
                                            <th style="width:40%;">
                                                <strong>DESCRIPTION</strong>
                                            </th>
                                            <th class="text-left" style="width:10%;">
                                                <strong>Type</strong>
                                            </th>
                                            <th class="text-left" style="width:5%;">
                                                <strong>Unit</strong>
                                            </th>
                                            <th class="text-center" style="width:15%;">
                                                <strong>Qty</strong>
                                            </th>
                                            <th class="text-center" style="width:15%;">
                                                <strong>Rate</strong>
                                            </th>
                                            <th class="text-center" style="width:15%;">
                                                <strong>Amount</strong>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody style="font-size:13px;">
                                        <t t-set="price_subtotal"
                                           t-value="o.invoice_line_ids.mapped('price_subtotal')"/>
                                        <!--                                <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)"/>-->
                                        <t t-set="lines"
                                           t-value="o.invoice_line_ids.sorted(key=lambda l: l.task_id.id, reverse=True)"/>
                                        <t t-foreach="lines" t-as="line">
                                            <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                                                <t t-if="not line.display_type" name="account_invoice_line_accountable">
                                                    <td style="width:40%;">
                                                        <span t-esc="line.name"/>
                                                    </td>
                                                    <td style='text-align:left; width:10%;'>
                                                        <t t-if="line.branch_id.branch_for == 'es'">
                                                            <span t-esc="line.equipment_type_id.name"/>
                                                        </t>
                                                        <t t-else="">
                                                            <span t-esc="line.type_id.name"/>
                                                        </t>
                                                    </td>

                                                    <td style='text-align:left; width:5%;'>
                                                        <span t-esc="line.product_uom_id.name"/>
                                                    </td>
                                                    <td style='text-align:right; width:15%;'>
                                                        <span t-esc="line.quantity"
                                                              t-options='{"widget": "float", "precision": 6}'/>
                                                    </td>

                                                    <td style='text-align:right; width:15%;'>
                                                        <span t-esc="line.price_unit"
                                                              t-options='{"widget": "float", "precision": 2}'/>
                                                    </td>
                                                    <td style="text-align:right; width:15%;">
                                                        <span t-esc="line.price_subtotal"
                                                              t-options='{"widget": "float", "precision": 2}'/>
                                                    </td>
                                                </t>
                                                <t t-if="line.display_type == 'line_section'">
                                                    <td colspan="99" id="section">
                                                        <span t-field="line.name"/>
                                                    </td>
                                                    <t t-set="current_section" t-value="line"/>
                                                    <t t-set="current_subtotal" t-value="0"/>
                                                </t>
                                                <t t-if="line.display_type == 'line_note'">
                                                    <td colspan="99" id="note">
                                                        <span t-field="line.name"/>
                                                    </td>
                                                </t>
                                            </tr>
                                        </t>
                                        <tr>
                                        </tr>
                                        <td colspan="3">
                                            <b>QAR : <span style="font-size:15px;"
                                                           t-esc="o.convert_num_to_word()"></span> Only
                                            </b>
                                        </td>
                                        <td class="text-right" colspan="3">
                                            <div class="row">
                                                <div class="col-3" style="margin-top:10px; text-align:left;">
                                                    <strong>Total</strong>
                                                </div>
                                                <div class="center col-3" style="margin-top:10px; ">
                                                    <strong>QAR.</strong>
                                                </div>
                                                <div style="text-align:right; margin-top:10px;" class="col-6">
                                                    <strong t-esc="sum(price_subtotal)"
                                                            t-options='{"widget": "float", "precision": 2}'/>
                                                </div>
                                            </div>
                                        </td>
                                    </tbody>
                                </table>
                                <div class="row" style="border: 1px solid black;">
                                    <div class="col-12">
                                        Client Reference: <span t-esc="o.ref">,</span> <![CDATA[&nbsp;]]>
                                        <span>Payment Terms :</span>
                                        <span t-esc="o.invoice_payment_term_id.name"/>
                                    </div>
                                </div>
                                <div class="row" style="border: 1px solid black;">
                                    <div class="col-6">
                                        <strong>Bank Name:</strong>
                                        <strong t-esc="o.company_id.bank_id.name"/>
                                        <br/>
                                        <span>Beneficialy Name:</span>
                                        <span t-esc="o.company_id.bank_id.beneficiary_name"/>
                                        <br/>
                                        <span>Branch Name:</span>
                                        <span t-esc="o.company_id.bank_id.branch_name"/>
                                        <br/>
                                        <span>Bank Address:</span>
                                        <span t-esc="o.company_id.bank_id.street"/>
                                    </div>
                                    <div class="col-6">
                                        <span>Bank Account No:</span>
                                        <span t-esc="o.company_id.bank_id.account_no"/>
                                        <br/>
                                        <span>Swift Code:</span>
                                        <span t-esc="o.company_id.bank_id.swift_code"/>
                                        <br/>
                                        <span>IBAN No:</span>
                                        <span t-esc="o.company_id.bank_id.iban_no"/>
                                        <br/>
                                    </div>
                                </div>
                            </div>
                            <br/>
                            <!-- <br/>
                            <div class="row">
                                <div class="col-9">
                                </div>
                                <div class="col-3">
                                    <span style="text-decoration: overline;">Authorised Signature</span><br/>
                                </div>
                            </div>
                            <br/>
                            <br/> -->
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo> 
 