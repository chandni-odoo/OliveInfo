<?xml version="1.0" encoding="utf-8"?>
<odoo>



        <template id="external_layout_template_so_hro">
            <t t-if="not o" t-set="o" t-value="doc"/>

            <t t-if="not company">
                <!-- Multicompany -->
                <t t-if="company_id">
                    <t t-set="company" t-value="company_id"/>
                </t>
                <t t-elif="o and 'company_id' in o">
                    <t t-set="company" t-value="o.company_id.sudo()"/>
                </t>
                <t t-else="else">
                    <t t-set="company" t-value="res_company"/>
                </t>
            </t>

            <div class="header">
               <div>
                    <div style="width:77%;float:left;">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo" style="max-height:70px;"/>
                    </div>
                    <div style="width:23%;float:right">
                        <img t-if="company.top_right" t-att-src="image_data_uri(company.top_right)" alt="Logo" style="max-height:70px;"/>
                    </div>
                </div>
                <div class="row zero_min_height">
                    <div class="col-12" style="margin-top:12px;">
                        <div />
                    </div>
                </div>
            </div>

            <div class="article o_report_layout_standard"  t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
                <t t-raw="0"/>
            </div>
            <div class="row zero_min_height">
                <div class="col-12">
                    <div style="border-bottom: 1px solid black;"/>
                </div>
            </div>
             <div class="footer o_standard_footer">
                <div class="row">
                    <div class="col-4">
                        <img t-if="company.bottom_left" t-att-src="image_data_uri(company.bottom_left)" alt="Logo" style="max-height:150px;"/>
                    </div>
                    <div  t-if="report_type == 'pdf'" class="text-muted col-4" style="padding-top: 130px;" >
                        <center>Page: <span class="page"/> / <span class="topage"/></center>
                    </div>
                    <div class="col-4" style="margin-top: 60px;text-align: end;">
                        <img t-if="company.bottom_right" t-att-src="image_data_uri(company.bottom_right)" alt="Logo" style="max-height:100px;padding-top: 60px;"/>
                    </div>
                </div>
            </div>
        </template>


     <record id="action_report_sale_quotation_test" model="ir.actions.report">
            <field name="name">Hro Std Test</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">custom_reports.report_sale_quotation_test</field>
            <field name="report_file">custom_reports.report_sale_quotation_test</field>
            <field name="print_report_name">'Quotation - %s' % (object.name)</field>
            <field name="binding_model_id" ref="sale_extended.model_sale_order"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="sale_extended.paperformat_sale_quotation_people"/>
    </record>



    <record id="view_sale_order_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mobile']" position="before">
                <field name="get_pass" attrs="{'invisible': [('branch_for', '=',  'mro')]}"/>
                <field name="notice_period" attrs="{'invisible': [('branch_for', '=',  'mro')]}"/>
                <field name="off_hire_notice_period" attrs="{'invisible': [('branch_for', '=',  'mro')]}"/>
                <field name="aft_type_by" attrs="{'invisible': [('branch_for', '!=',  'es')]}"/>
            </xpath>
              <xpath expr="//notebook" position="inside">
                <page string="Miscellaneous Term Cond..." name="term" attrs="{'invisible': [('branch_for', '=',  'mro')]}">
                    <field name="term_condition"/>
                </page>
            </xpath>
        </field>
    </record>


</odoo>
