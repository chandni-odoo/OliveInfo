<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">


    <function name="write" model="ir.model.data">
        <function name="search" model="ir.model.data">
            <value eval="[('name', '=', 'new_ticket_request_email_template'), ('module', '=', 'helpdesk')]"/>
        </function>
        <value eval="{'noupdate': False}"/>
    </function>


    <record id="helpdesk.new_ticket_request_email_template" model="mail.template">
        <field name="subject">{{ object.display_name }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p>Dear
                    <span t-esc="object.partner_name"/>,
                </p>
                <p>Thank you for reaching out. Your case
                    <t t-out="object.display_name"/>
                    has been noted, and we're
                    investigating. Your satisfaction is crucial, and we're committed to resolving this promptly.
                </p>
                <p>
                    <t t-if="object.check_description() == True">
                        Details:
                        <t t-out="object.description"/>
                    </t>
                </p>
                <p>We appreciate your patience. Updates will follow, but if you have more info, reply here or
                    contact us at
                    <t t-out="object.create_uid.phone"/>
                </p>
                <p>Best,</p>
                <p>
                    <t t-out="object.create_uid.name"/>
                </p>
                <p>
                    <t t-out="object.create_uid.function"/>
                </p>
                <p>
                    <t t-out="object.create_uid.phone"/>
                </p>
                <p>
                    <t t-out="object.create_uid.mobile"/>
                </p>
                <p>
                    <t t-out="object.create_uid.company_id.name"/>
                </p>

            </div>
        </field>
    </record>


    <function name="write" model="ir.model.data">
        <function name="search" model="ir.model.data">
            <value eval="[('name', '=', 'new_ticket_request_email_template'), ('module', '=', 'helpdesk')]"/>
        </function>
        <value eval="{'noupdate': True}"/>
    </function>


</odoo>
