<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree View -->

        <record id="contact_location_tree" model="ir.ui.view">
            <field name="name">contact.location.tree</field>
            <field name="model">contact.location</field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <tree string="Contact Location">
                    <field name="name"/>
                    <field name="latitude"/>
                    <field name="longitude"/>
                </tree>
            </field>
        </record>

        <record id="contact_location_form" model="ir.ui.view">
            <field name="name">contact.location.form</field>
            <field name="model">contact.location</field>
            <field name="priority" eval="8" />
            <field name="arch" type="xml">
                <form string="Contact Location">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Enter Location Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="latitude"/>
                            </group>
                            <group>
                                <field name="longitude"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record model="ir.actions.act_window" id="action_contact_location">
            <field name="name">Location</field>
            <field name="res_model">contact.location</field>
            <!-- <field name="view_type">form</field> -->
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Location Form
                </p>
            </field>
        </record>
        <menuitem id="partner_contact_location" action="action_contact_location" name="Location"
                  sequence="8" parent="contacts.res_partner_menu_config"/>
</odoo>
