<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_view_form_inherit_shift" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.shift</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <field name="coach_id" position="after">
                <field name="shift_id" />
            </field>
            <xpath expr="//notebook/page[last()]" position="after">
                <page string="Weekend Dates" attrs="{'invisible': [('hr_employee_type','=', 'subcontractor')]}">
                    <field name="dayofweek_ids">
                        <tree editable="bottom">
                            <field name="week_id"/>
                            <field name="date"/>
                            <field name="types"/>
                            <field name="shift_allocation_id" invisible="1"/>
                            <field name="employee_id" invisible="1"/>
                            <field name="week_selection_ids"  widget="many2many_tags" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="pways_hr_shift_allocation_filter_inherited" model="ir.ui.view">
        <field name="name">hr.employee.search.inherited</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='job_id']" position='after'>
                <field name="shift_id"/>
            </xpath>
            <xpath expr="//filter[@name='group_job']" position='before'>
                <filter name="shift_id" string="Shift" domain="[]" context="{'group_by': 'shift_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
