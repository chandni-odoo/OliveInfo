<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="shift_allocation_tree_view" model="ir.ui.view">
        <field name="name">shift.allocation.tree.view</field>
        <field name="model">shift.allocation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="shift_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="shift_allocation_form_view" model="ir.ui.view">
        <field name="name">shift.allocation.form.view</field>
        <field name="model">shift.allocation</field>
        <field name="arch" type="xml">
            <form string="Shift Allocation">
                <header>
                    <button name="button_in_progress" string="Process" type="object" class="oe_highlight"
                            states='draft'/>
                    <button name="button_closed" string="Close" type="object" class="oe_highlight" states='draft'/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,cancel" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="shift_id" required='1'/>
                            <field name="date_from" required='1'/>
                        </group>
                        <group>
                            <field name="shift_type_id" required='1'/>
                            <field name="date_to" required='1'/>
                        </group>
                        <group colspan='6' col='4'>
                            <field name="employee_id" required='1'/>
                            <field name='description'/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Weekend Dates">
                            <field name="dayofweek_ids">
                                <tree editable="bottom">
                                    <field name="week_id"/>
                                    <field name="date"/>
                                    <field name="types"/>
                                    <field name="shift_allocation_id" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="shift_allocation_view_calendar" model="ir.ui.view">
        <field name="name">shift.allocation.calendar.view</field>
        <field name="model">shift.allocation</field>
        <field eval="2" name="priority"/>
        <field name="arch" type="xml">
            <calendar date_start="date_from" date_stop="date_to" string="Shift Allocation View" mode="month"
                      color="shift_id" event_limit="100">
                <field name="employee_id"/>
                <field name="shift_id" filters="1"/>
                <field name="shift_type_id" filters="1"/>
            </calendar>
        </field>
    </record>
    <record id="shift_allocation_search_view" model="ir.ui.view">
        <field name="name">shift.allocation.search.view</field>
        <field name="model">shift.allocation</field>
        <field name="arch" type="xml">
            <search>
                <!-- Standard Search Fields -->
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="employee_id" string="Employee" filter_domain="[('employee_id.name', 'ilike', self)]"/>
                <field name="shift_id" string="Shift" filter_domain="[('shift_id.name', 'ilike', self)]"/>
                <field name="shift_type_id"/>
                <field name="state"/>

                <!-- Filters Section -->
                <filter string="Open Shifts" name="open_shifts" domain="[('state', '=', 'open')]"/>
                <filter string="Confirmed Shifts" name="confirmed_shifts" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Done Shifts" name="done_shifts" domain="[('state', '=', 'done')]"/>
                <!-- Group By Section -->
                <group expand="0" string="Group By">
                    <filter name="employee" string="Employee" domain="[]" context="{'group_by':'employee_id'}"/>
                    <filter name="shift" string="Shift" domain="[]" context="{'group_by':'shift_id'}"/>
                    <filter name="shift_type" string="Shift Type" domain="[]" context="{'group_by':'shift_type_id'}"/>
                    <filter name="state" string="Status" domain="[]" context="{'group_by':'state'}"/>

                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_shift_allocation" model="ir.actions.act_window">
        <field name="name">Shift Allocation</field>
        <field name="res_model">shift.allocation</field>
        <field name="view_mode">calendar,tree,form</field>
        <field name="search_view_id" ref="shift_allocation_search_view"/>
    </record>

    <menuitem
            id="menu_shift_allocation"
            name="Shift Allocation"
            action="action_shift_allocation"
            parent="hr.menu_hr_employee_payroll"
            sequence="30"/>
</odoo>

