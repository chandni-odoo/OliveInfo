<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_manpower_requisition_tree" model="ir.ui.view">
        <field name="name">manpower.requisition.tree</field>
        <field name="model">manpower.requisition</field>
        <field name="arch" type="xml">
            <tree>
                <field name="requisition_number"/>
                <field name="description"/>
                <field name="request_date"/>
                <field name="branch_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_manpower_requisition_form" model="ir.ui.view">
        <field name="name">manpower.requisition.form</field>
        <field name="model">manpower.requisition</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="is_approved" invisible="1"/>
                    <field name="users_count" invisible="1"/>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'new')]}"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"
                            groups="visa_processing.manpower_requisition_approved_group"
                            attrs="{'invisible': [('state', '!=', 'pending')]}"/>
                    <button name="action_open_reject_wizard" string="Reject" type="object" class="btn-danger"
                            groups="visa_processing.manpower_requisition_approved_group"
                            attrs="{'invisible': [('state', '!=', 'pending')]}"/>
                    <button name="action_in_progress" string="In Progress" type="object" class="btn-primary"
                            groups="hr_request_portal.group_hr_notification"
                            attrs="{'invisible': [('state', '!=', 'approved')]}"/>
                    <button name="action_completed" string="Completed" type="object" class="btn-success"
                            groups="hr_request_portal.group_hr_notification"
                            attrs="{'invisible': [('state', '!=', 'in_progress')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,pending,approved,in_progress,completed,reject"/>
                </header>
                <sheet>
                    <group>
                        <field name="requisition_number" readonly="1" string="Req. Number" attrs="{'readonly': [('id', '!=', False)]}"/>
                        <field name="description"/>
                        <field name="request_date"/>
                        <field name="branch_id"/>
                        <!-- <field name="branch_approver_ids" widget="many2many_tags" readonly="1"/> -->
                    </group>
                    <group>
                        <field name="reject_reason" readonly="1" attrs="{'invisible': [('state', '!=', 'reject')]}"/>
                    </group>
                    <notebook>
                        <page string="Position Requirements">
                            <field name="requisition_line_ids">
                                <tree editable="bottom">
                                    <field name="job_id" required="1"/>
                                    <field name="specification"/>
                                    <field name="quantity"/>
                                    <field name="required_date"/>
                                    <field name="requisition_closed_date"/>
                                    <field name="remark"/>
                                    <field name="hr_remarks"/>
                                    <field name="hired_count"/>
                                    <field name="remaining_count" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Approval History">
                            <field name="approval_history_ids">
                                <tree editable="bottom" create="0" delete="0">
                                    <field name="user_id"/>
                                    <field name="status"/>
                                    <field name="date_done"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_manpower_reject_form" model="ir.ui.view">
        <field name="name">manpower.requisition.reject.form</field>
        <field name="model">manpower.requisition.reject</field>
        <field name="arch" type="xml">
            <form string="Reject Manpower Requisition">
                <sheet>
                    <group>
                        <field name="reject_reason" placeholder="Please provide a reason for rejection..."/>
                    </group>
                    <footer>
                        <button name="action_confirm_reject" string="Confirm Rejection" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_branch_approvers_tree" model="ir.ui.view">
        <field name="name">branch.approvers.tree</field>
        <field name="model">branch.approvers</field>
        <field name="arch" type="xml">
            <tree>
                <field name="branch_id"/>
            </tree>
        </field>
    </record>

    <!-- Branch Approvers Form View -->
    <record id="view_branch_approvers_form" model="ir.ui.view">
        <field name="name">branch.approvers.form</field>
        <field name="model">branch.approvers</field>
        <field name="arch" type="xml">
            <form string="Branch Approvers">
                    <sheet>
                        <group>
                            <field name="branch_id"/>
                        </group>
                        <field name="approver_line_ids" mode="tree,form">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="user_id" required="1"/>
                            </tree>
                            <form>
                                <group>
                                    <field name="sequence"/>
                                    <field name="user_id"/>
                                </group>
                            </form>
                        </field>
                    </sheet>
                </form>
        </field>
    </record>
    
    <record id="action_manpower_requisition" model="ir.actions.act_window">
        <field name="name">Manpower Requisition</field>
        <field name="res_model">manpower.requisition</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_branch_approvers" model="ir.actions.act_window">
        <field name="name">Branch Approvers</field>
        <field name="res_model">branch.approvers</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Branch Approvers Menu -->
    <menuitem id="menu_branch_approvers" 
            name="Branch Approvers" 
            parent="hr_recruitment.menu_crm_case_categ0_act_job" 
            action="action_branch_approvers" 
            sequence="4"/>

    <menuitem id="menu_hr_job_manpower_requisition" 
              name="Manpower Requisition" 
              parent="hr_recruitment.menu_crm_case_categ0_act_job"
              action="action_manpower_requisition"
              sequence="3"/>
</odoo>