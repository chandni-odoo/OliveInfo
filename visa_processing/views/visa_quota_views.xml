<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_visa_quota_form" model="ir.ui.view">
        <field name="name">visa.quota.form</field>
        <field name="model">visa.quota</field>
        <field name="arch" type="xml">
            <form string="Visa Quota">
                <sheet>
                    <div class="oe_title">
                        <h3>
                            <field name="batch_number"/>
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="batch_number"/>
                            <field name="vp_number"/>
                            <field name="visa_type_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="validity_from_date"/>
                            <field name="validity_to_date"/>
                            <field name="associated_to"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Quota Details">
                            <field name="quota_line_ids">
                                <tree editable="bottom">
                                    <field name="nationality_id"/>
                                    <field name="profession"/>
                                    <field name="gender"/>
                                    <field name="approved_count"/>
                                    <field name="used_count"/>
                                    <field name="remaining_count" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    
   
    <record id="view_visa_quota_tree" model="ir.ui.view">
        <field name="name">visa.quota.tree</field>
        <field name="model">visa.quota</field>
        <field name="arch" type="xml">
            <tree>
                <field name="batch_number"/>
                <field name="vp_number"/>
                <field name="associated_to"/>
                <field name="visa_type_id"/>
                <field name="validity_from_date"/>
                <field name="validity_to_date"/>
            </tree>
        </field>
    </record>

    <record id="action_visa_quota" model="ir.actions.act_window">
        <field name="name">Visa Quota</field>
        <field name="res_model">visa.quota</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>