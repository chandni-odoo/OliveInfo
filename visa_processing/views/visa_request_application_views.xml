    <record id="view_visa_non_qvc_pending_search" model="ir.ui.view">
        <field name="name">visa.qvc.non.qvc.pending.search</field>
        <field name="model">visa.request.application</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Reference"/>
                <field name="recruitment_app_number"/>
                <field name="non_qvc_qatar_first_entry_date"/>
                <field name="qvc_qatar_first_entry_date"/>
                <filter string="QVC/Non-QVC Pending" name="qvc_non_qvc_pending" 
                    domain="['|', ('visa_process_type', '=', 'non_qvc'), ('visa_process_type', '=', 'qvc'), ('state', 'in', ['submit', 'pending', 'process'])]"/>
                <filter string="Days Left &lt; 7" name="days_left_lt_7" 
                    domain="[('days_left', '&lt;', 7), ('days_left', '&gt;', 0)]"/>
                <filter string="Days Left &lt; 0" name="days_left_expired" 
                    domain="[('days_left', '&lt;', 0)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by':'state'}"/>
                    <filter string="Visa Process Type" name="group_by_visa_process_type" context="{'group_by':'visa_process_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_visa_non_qvc_pending" model="ir.actions.act_window">
        <field name="name">QVC/Non-QVC Pending Status</field>
        <field name="res_model">visa.request.application</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_visa_request_application_tree"/>
        <field name="search_view_id" ref="view_visa_non_qvc_pending_search"/>
        <field name="context">{'search_default_qvc_non_qvc_pending': 1}</field>
        <field name="domain">['|', ('visa_process_type', '=', 'non_qvc'), ('visa_process_type', '=', 'qvc'), ('state', 'in', ['submit', 'pending', 'process'])]</field>
    </record>

    <record id="action_visa_request_applications" model="ir.actions.act_window">
        <field name="name">Visa Request Applications</field>
        <field name="res_model">visa.request.application</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_state_submit': 1}</field>
        <field name="domain">[]</field>
        <field name="search_view_id" ref="view_visa_request_application_search"/>
    </record>

    <record id="action_visa_request_new_applications" model="ir.actions.act_window">
        <field name="name">Visa Request</field>
        <field name="res_model">visa.request.application</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_qvc_country" model="ir.actions.act_window">
        <field name="name">QVC Countries</field>
        <field name="res_model">qvc.country</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_qvc_center" model="ir.actions.act_window">
