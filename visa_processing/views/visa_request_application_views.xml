    <record id="view_visa_request_application_search" model="ir.ui.view">
        <field name="name">visa.request.application.search</field>
        <field name="model">visa.request.application</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Reference"/>
                <field name="recruitment_app_number"/>
                <field name="state"/>
                <filter string="All" name="all" domain="[]"/>
                <filter string="Submitted" name="state_submit" 
                    domain="[('state', 'in', ['submit'])]"/>
                <group expand="0" string="Group By">
                </group>
            </search>
        </field>
    </record>

