<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_visa_request_application_tree" model="ir.ui.view">
        <field name="name">visa.request.application.tree</field>
        <field name="model">visa.request.application</field>
        <field name="arch" type="xml">
            <tree>
                <field name="recruitment_app_number"/>
                <field name="employee_name"/>
                <field name="job_position"/>
                <field name="gender"/>
                <field name="business_unit"/>
                <field name="nationality"/>
                <field name="passport_number"/>
                <field name="passport_expiry"/>
                <field name="visa_process_type"/>
                <field name="non_qvc_qatar_first_entry_date" string="Non QVC Qatar First Entry Date"
                    attrs="{'invisible': [('visa_process_type', '!=', 'non_qvc')]}"/>
                <field name="qvc_qatar_first_entry_date" string="QVC Qatar First Entry Date"
                    attrs="{'invisible': [('visa_process_type', '!=', 'qvc')]}"/>
                <field name="days_left" 
                    attrs="{'invisible': [('visa_process_type', 'not in', ['qvc', 'non_qvc'])]}"/>
                <!-- <field name="days_left" 
                    attrs="{'invisible': [('visa_process_type', '!=', 'non_qvc')]}"/> -->
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_visa_request_application_form" model="ir.ui.view">
        <field name="name">visa.request.application.form</field>
        <field name="model">visa.request.application</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" 
                            string="Submit" 
                            type="object" 
                            class="btn-primary"
                            states="new"/>

                    <button name="action_pending" 
                            string="Pending" 
                            type="object" 
                            class="btn-secondary"
                            states="submit"
                            groups="visa_processing.group_pro_team"/>
                    
                    <button name="action_process" 
                            string="Processing" 
                            type="object" 
                            class="btn-warning"
                            states="pending"
                            groups="visa_processing.group_pro_team"/>

                    <button name="action_complete" 
                            string="Complete" 
                            type="object" 
                            class="btn-primary"
                            states="process"
                            groups="visa_processing.group_pro_team"/>

                    <button name="action_reject" 
                            string="Reject" 
                            type="object" 
                            class="btn-danger"
                            states="pending,process"/>
                    
                    <button name="action_cancel" 
                            string="Cancel" 
                            type="object" 
                            class="btn-secondary"
                            states="new,submit,pending,process"/>
                    
                    <button name="action_draft" 
                            string="Reset to New" 
                            type="object" 
                            class="btn-secondary"
                            states="complete,reject,cancel"/>
                    
                    <field name="state" widget="statusbar" statusbar_visible="new,submit,pending,process,complete,reject,cancel"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="request_date"/>
                            <field name="recruitment_app_number"/>
                            <field name="employee_name"/>
                            <field name="employee_number"/>
                            <field name="job_position"/>
                            <field name="gender"/>
                        </group>
                        <group>
                            <field name="business_unit"/>
                            <field name="nationality"/>
                            <field name="passport_number"/>
                            <field name="passport_expiry"/>
                            <field name="qid_number"/>
                            <field name="date_of_birth"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="visa_process_type"/>
                            <field name="visa_applicable" attrs="{'invisible': [('visa_process_type', '!=', 'change_employer')]}"/>
                            <field name="qvc_country_id" attrs="{'invisible': [('visa_process_type', '!=', 'qvc')]}"/>
                            <field name="qvc_center_id" attrs="{'invisible': [('visa_process_type', '!=', 'qvc')]}"/>
                        </group>
                        <!-- <group attrs="{'invisible': [('visa_process_type', 'not in', ['qvc', 'non_qvc'])]}" string="Visa Details"> -->
                        <group attrs="{'invisible': [('visa_process_type', 'not in', ['qvc', 'non_qvc']), ('visa_applicable', '!=', True)]}" string="Visa Details">
                            <field name="vp_number_id" readonly="1" groups="!visa_processing.group_pro_team"/>
                            <field name="visa_profession_id" widget="selection" readonly="1" groups="!visa_processing.group_pro_team"/>
                            <field name="visa_number" readonly="1" groups="!visa_processing.group_pro_team"/>
                            <field name="vp_number_id" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                            <field name="visa_profession_id" widget="selection" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                            <field name="visa_number" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Documents">
                            <field name="document_line_ids">
                                <tree editable="bottom">
                                    <field name="document_type_id"/>
                                    <field name="document_number"/>
                                    <field name="valid_from"/>
                                    <field name="valid_to"/>
                                    <field name="issue_place"/>
                                    <field name="status"/>
                                    <field name="attachment" filename="document_number" widget="binary"/>
                                    <!-- <field name="source_document_id" invisible="1"/> -->
                                    <field name="remarks"/>
                                </tree>
                            </field>
                        </page>
                        
                        <page string="Salary Components">
                            <field name="salary_line_ids">
                                <tree editable="bottom">
                                    <field name="salary_component_id"/>
                                    <field name="amount"/>
                                    <field name="currency_id"/>
                                    <field name="notes"/>
                                </tree>
                                <form>
                                    <group>
                                        <field name="salary_component_id"/>
                                        <field name="amount"/>
                                        <field name="currency_id"/>
                                        <field name="notes"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    <!-- QVC Process Page -->
                        <page string="QVC Process" attrs="{'invisible': [('visa_process_type', '!=', 'qvc')]}">
                            <group>
                                <group>
                                    <field name="qvc_visa_application_date" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="qvc_visa_application_date" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="qvc_payment_date" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="qvc_payment_date" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="qvc_appointment_date" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="qvc_appointment_date" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                </group>
                                <group>
                                    <field name="qvc_visa_payment_date" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="qvc_visa_issue_date" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="qvc_qatar_first_entry_date" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="qvc_qid_apply_date" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="qvc_visa_payment_date" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="qvc_visa_issue_date" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="qvc_qatar_first_entry_date" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="qvc_qid_apply_date" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- Non-QVC Process Page -->
                        <page string="Non-QVC Process" attrs="{'invisible': [('visa_process_type', '!=', 'non_qvc')]}">
                            <group>
                                <group>
                                    <field name="non_qvc_visa_application_date" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="non_qvc_visa_payment_date" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="non_qvc_visa_issue_date" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="non_qvc_qatar_first_entry_date" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="non_qvc_medical_application_date" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="non_qvc_visa_application_date" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="non_qvc_visa_payment_date" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="non_qvc_visa_issue_date" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="non_qvc_qatar_first_entry_date" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="non_qvc_medical_application_date" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                </group>
                                <group>
                                    <field name="non_qvc_medical_appointment_date" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="non_qvc_fingerprint_application_date" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="non_qvc_fingerprint_appointment_date" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="non_qvc_employment_contract" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="non_qvc_qid_payment_date" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="non_qvc_medical_appointment_date" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="non_qvc_fingerprint_application_date" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="non_qvc_fingerprint_appointment_date" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="non_qvc_employment_contract" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="non_qvc_qid_payment_date" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- Change of Employer/Secondment Page -->
                        <page string="Change of Employer/Secondment" attrs="{'invisible': [('visa_process_type', 'not in', ['change_employer', 'secondment'])]}">
                            <group>
                                <group>
                                    <field name="change_employer_noc" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="change_employer_company_documents" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="change_employer_application_date" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="change_employer_application_no" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="change_employer_noc" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="change_employer_company_documents" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="change_employer_application_date" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="change_employer_application_no" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                </group>
                                <group>
                                    <field name="change_employer_application_status" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="change_employer_employee_contract" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="change_employer_transfer_payment_date" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="change_employer_application_status" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="change_employer_employee_contract" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="change_employer_transfer_payment_date" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- Work Permit Page -->
                        <page string="Work Permit" attrs="{'invisible': [('visa_process_type', '!=', 'work_permit')]}">
                            <group>
                                <group>
                                    <field name="work_permit_photo" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="work_permit_qid" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="work_permit_sponsor_id" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="work_permit_education_certificate_arabic" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="work_permit_application_no" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="work_permit_application_date" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="work_permit_photo" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="work_permit_qid" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="work_permit_sponsor_id" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="work_permit_education_certificate_arabic" aattrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="work_permit_application_no" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="work_permit_application_date" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                </group>
                                <group>
                                    <field name="work_permit_pcc" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="work_permit_employee_contract" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="work_permit_payment_date" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="work_permit_validity_from" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="work_permit_expiry_date" readonly="1" groups="!visa_processing.group_pro_team"/>
                                    <field name="work_permit_pcc" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="work_permit_employee_contract" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="work_permit_payment_date" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="work_permit_validity_from" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                    <field name="work_permit_expiry_date" attrs="{'readonly': [('state', 'not in', ['submit', 'pending', 'process'])]}" groups="visa_processing.group_pro_team"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

