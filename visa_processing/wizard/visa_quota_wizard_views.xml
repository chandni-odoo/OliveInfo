<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_visa_quota_report_wizard_form" model="ir.ui.view">
            <field name="name">visa.quota.report.wizard.form</field>
            <field name="model">visa.quota.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Visa Quota Availability Report">
                    <sheet>
                        <group>
                            <group>
                                <field name="date_from"/>
                                <field name="date_to"/>
                            </group>
                            <group>
                                <field name="visa_type_ids" widget="many2many_tags"/>
                                <field name="nationality_ids" widget="many2many_tags"/>
                            </group>
                        </group>
                        <footer>
                            <button name="action_print_report" string="Print Report" type="object" class="btn-primary"/>
                            <button string="Cancel" class="btn-secondary" special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_visa_quota_report_wizard" model="ir.actions.act_window">
            <field name="name">Visa Quota Availability Report</field>
            <field name="res_model">visa.quota.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_visa_quota_report_wizard_form"/>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_visa_quota_report"
                  name="Visa Quota Availability Report"
                  parent="menu_visa_reports"
                  action="action_visa_quota_report_wizard"
                  sequence="3"/>
    </data>
</odoo>