<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_manpower_requisition" model="ir.sequence">
        <field name="name">Manpower Requisition</field>
        <field name="code">manpower.requisition</field>
        <field name="prefix">MR/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_visa_quota" model="ir.sequence">
        <field name="name">Visa Quota</field>
        <field name="code">visa.quota</field>
        <field name="prefix">VQ/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_visa_request_application" model="ir.sequence">
        <field name="name">Visa Request Application</field>
        <field name="code">visa.request.application</field>
        <field name="prefix">VRA/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>