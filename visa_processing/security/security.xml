<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="manpower_requisition_approved_group" model="res.groups">
            <field name="name">Manpower Requisition Approver</field>
        </record>

        <record id="group_pro_team" model="res.groups">
            <field name="name">PRO Team</field>
            <field name="category_id" ref="base.module_category_human_resources"/>
        </record>
        
        <record id="visa_request_application_pro_rule" model="ir.rule">
            <field name="name">PRO Team: Access submitted and processing applications</field>
            <field name="model_id" ref="model_visa_request_application"/>
            <field name="domain_force">[('state','in',['submit','pending','process','complete','reject','cancel'])]</field>
            <field name="groups" eval="[(4, ref('visa_processing.group_pro_team'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="group_hr_employee_contract" model="res.groups">
            <field name="name">Employee Contract payslip Access</field>
        </record>
   
    </data>
</odoo>