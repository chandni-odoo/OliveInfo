<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data noupdate="1">
		<record id="sequence_hr_request" model="ir.sequence">
			<field name="name">Request</field>
			<field name="code">request.request</field>	
			<field name="padding">4</field>
		    <field name="number_increment">1</field>
			<field name="prefix">REQ</field>
		</record>

		 <record id="resignation" model="hr.request.type">
	          <field name="name">Resignation</field>
	          <field name="code">REJ</field>
	      </record>
	      <record id="request_document" model="hr.request.type">
	          <field name="name">Document</field>
	          <field name="code">Doc</field>
	      </record>
	      <record id="request_termination" model="hr.request.type">
	          <field name="name">Termination</field>
	          <field name="code">TRM</field>
	      </record>
	      <record id="request_final" model="hr.request.type">
	          <field name="name">Final clearance</field>
	          <field name="code">FC</field>
	      </record>
	      <record id="request_duty" model="hr.request.type">
	          <field name="name">Duty Resumption</field>
	          <field name="code">DRM</field>
	      </record>
	      <record id="request_other" model="hr.request.type">
	          <field name="name">Other</field>
	          <field name="code">OTH</field>
	      </record>
	</data>
</odoo>