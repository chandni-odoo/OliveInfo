<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <record id="email_template_edi_payslip" model="mail.template">
            <field name="name">Employee Payslips: Send by email</field>
            <field name="model_id" ref="pways_employee_payslip_mail.model_hr_payslip"/>
            <field name="subject">{{ object.company_id.name }} {{ object.name or 'n/a' }}</field>
            <field name="email_from">{{ (object.employee_id.user_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.employee_id.work_email }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear <span t-esc="object.employee_id.name"/>, a new payslip is available for you.</p>
                    <p>Please find the PDF in your employee portal.</p>
                    <p>Have a nice day,</p>
                    <p>The HR Team</p>
                </div>
            </field>
            <field name="report_template" ref="pways_employee_payslip_mail.action_report_payslip"/>
            <field name="report_name">{{ (object.name or '') }}</field>
            <field name="lang">{{ object.employee_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="email_template_payslip_send" model="mail.template">
            <field name="name">Payslip Report</field>
            <field name="email_from">{{ object.env.user.email_formatted }}</field>
            <field name="email_to">{{ object.employee_id.work_email }}</field>
            <field name="subject">{{ object.company_id.name }} {{ object.name or 'n/a' }}</field>
            <field name="model_id" ref="pways_employee_payslip_mail.model_hr_payslip"/>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p>Dear <span t-esc="object.employee_id.name"/>, a new payslip is available for you.</p>
                    <p>Please find the PDF in your employee portal.</p>
                    <p>Have a nice day,</p>
                    <p>The HR Team</p>
                </div>
            </field>
            <field name="report_template" ref="pways_employee_payslip_mail.action_report_payslip"/>
            <field name="report_name">{{ (object.name or '') }}</field>
        </record>
    </data>
</odoo>
