<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hr_payslip_form_inherited" model="ir.ui.view">
            <field name="name">hr.payslip.form</field>
            <field name="model">hr.payslip</field>
            <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//button[@name='action_payslip_cancel']" position="after">
                        <button name="action_payslip_send" type="object" string="Send By Mail"/>
                    </xpath>
                </data>
            </field>
        </record>
        <record id="model_sale_order_action_quotation_sent" model="ir.actions.server">
            <field name="name">Employee Payslip Mail</field>
            <field name="model_id" ref="hr_payroll.model_hr_payslip"/>
            <field name="binding_model_id" ref="hr_payroll.model_hr_payslip"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">action = records.action_payslip_sends()</field>
        </record>
    </data>
</odoo>    
