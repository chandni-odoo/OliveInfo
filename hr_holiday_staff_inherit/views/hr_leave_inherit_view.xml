<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_leave_staff_avail_leave_view_form_inherit" model="ir.ui.view">
            <field name="name">hr.leave.view.form.inherit</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='col_right']" position="after">
                    <group>
                        <field name="staff_leave_available" attrs="{'invisible':[('staff_leave_bool','!=', True)]}"/>
                        <field name="staff_leave_bool" invisible="1"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
