<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    	<record id="bulk_ot_rule_form" model="ir.ui.view">
    		<field name="name">ot.rule.wizard.form</field>
            <field name="model">ot.rule.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="ot_rule_line_ids">
                            <tree editable="bottom">
                                <field name="ot_rule_id"/>
                                <field name="ot_type_id"/>  
                                <field name="ot_type"/>
                                <field name="fix_amount" attrs="{'invisible': [('ot_type', '!=', 'fix')]}"/>
                                <field name="per_amount" attrs="{'invisible' : [('ot_type', '!=', 'percentage')]}"/>
                                <field name="per_based_on" attrs="{'invisible' : [('ot_type', '!=', 'percentage')]}"/>
                            </tree>
                        </field>
                    </group>
                    <group>
                        <group colspan='6'>
                            <field name="employee_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_bulk_ot_rule_line" string="Create" class="oe_highlight" type="object"/>
                    	<button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>   
        </record>

        <record id="action_bulk_ot_rule__wizard" model="ir.actions.act_window">
            <field name="name">Create Bulk Overtime Rule Lines</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ot.rule.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="hr.model_hr_employee" />
            <field name="binding_view_types">list,form</field>
        </record>
	</data>
</odoo>
