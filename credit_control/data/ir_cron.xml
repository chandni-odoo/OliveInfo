<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_check_expired_credit_hold" model="ir.cron">
        <field name="name">Expired Credit Hold Releases</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._reinstate_expired_credit_hold()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall">False</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_notify_credit_approvers" model="ir.cron">
        <field name="name">Notify Credit Hold Approvers</field>
        <field name="model_id" ref="model_res_partner"/>
        <field name="state">code</field>
        <field name="code">model._notify_credit_approvers()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>