<?xml version="1.0" encoding="utf-8"?>
<odoo>    
    <record id="view_release_credit_hold_wizard_form" model="ir.ui.view">
        <field name="name">release.credit.hold.wizard.form</field>
        <field name="model">release.credit.hold.wizard</field>
        <field name="arch" type="xml">
            <form string="Release Credit Hold">
                <group>
                    <field name="partner_ids" invisible="1"/>
                    <field name="release_until" required="1"/>
                    <field name="note"/>
                </group>
                <footer>
                    <button name="release_credit_hold_action" string="Release" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>