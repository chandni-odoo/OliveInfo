<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- TREE VIEW -->
    <record id="view_pdc_cheque_tree" model="ir.ui.view">
        <field name="name">pdc.cheque.tree</field>
        <field name="model">pdc.cheque</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="collection_date"/>
                <field name="customer_id"/>
                <field name="cheque_date"/>
                <field name="cheque_expiry_date"/>
                <field name="cheque_type"/>
                <field name="amount"/>
                <field name="cheque_status"/>
                <field name="replacement_date"/>
                <field name="state"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_pdc_cheque_form" model="ir.ui.view">
        <field name="name">pdc.cheque.form</field>
        <field name="model">pdc.cheque</field>
        <field name="arch" type="xml">
            <form string="PDC Cheque">

                <!-- HEADER STATUS -->
                <header>
                    <button name="action_submitted"
                            string="Submit to Bank"
                            type="object"
                            class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'collected')]}"/>
                    <button name="action_returned"
                        string="Return to Customer"
                        type="object"
                        class="btn-warning"
                        attrs="{'invisible': [('state', '!=', 'collected')]}"/>
                    <!-- <button name="action_returned"
                            string="Return to Customer"
                            type="object"
                            class="btn-warning"
                            attrs="{'invisible': [('state', 'not in', ['submitted', 'bounced'])]}"/> -->
                    <button name="action_bounced"
                            string="Mark as Bounced"
                            type="object"
                            class="btn-danger"
                            attrs="{'invisible': [('state', '!=', 'submitted')]}"/>
                    <button name="action_collected"
                            string="Reset to Collected"
                            type="object"
                            attrs="{'invisible': [('state', '=', 'collected')]}"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="collected,submitted,returned,bounced"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="cheque_date"/>
                            <field name="cheque_expiry_date"/>
                            <field name="collection_date"/>
                            <field name="collected_by"/>
                        </group>

                        <group>
                            <field name="amount"/>
                            <field name="cheque_type"/>
                            <field name="cheque_status" readonly="1"/>
                            <field name="replacement_date" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Notes / Remarks">
                            <group>
                                <field name="notes" placeholder="Enter remarks here..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                    <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_pdc_cheque" model="ir.actions.act_window">
        <field name="name">PDC Cheques</field>
        <field name="res_model">pdc.cheque</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <record id="view_pdc_cheque_search" model="ir.ui.view">
        <field name="name">pdc.cheque.search</field>
        <field name="model">pdc.cheque</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="cheque_type"/>
                <field name="state"/>
                <!-- Filter to show archived records -->
                <filter
                    string="Archived"
                    name="archived"
                    domain="[('active', '=', False)]"
                />
                <group expand="0" string="Group By">
                    <filter string="Customer" name="customer" context="{'group_by': 'customer_id'}"/>
                    <filter string="Type" name="type" context="{'group_by': 'cheque_type'}"/>
                    <filter string="Stage" name="stage" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_pdc_cheque"
              name="PDC Cheques"
              parent="account.menu_finance_receivables"
              action="action_pdc_cheque"
              sequence="25"
              groups="credit_control.group_account_admin_group2"/>

</odoo>