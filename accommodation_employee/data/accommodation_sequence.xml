<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data noupdate="1">

        <record id="sequence_hos_stu" model="ir.sequence">
            <field name="name">Accommodation Student</field>
            <field name="code">accommodation.student</field>
            <field name="padding">3</field>
            <field name="prefix">HOSTU</field>
            <field name="suffix">/%(year)s</field>
        </record>

        <record id="sequence_room_bed" model="ir.sequence">
            <field name="name">RoomBed</field>
            <field name="code">room.bed</field>
            <field name="prefix">Room-BED-/</field>
            <field name="padding">9</field>
            <field name="number_increment">1</field>
        </record>

    </data>
</odoo>
