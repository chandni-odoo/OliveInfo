<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_hr_training_tree" model="ir.ui.view">
        <field name="name">hr.training.tree</field>
        <field name="model">hr.training</field>
        <field name="arch" type="xml">
            <tree>
                <field name="employee_id"/>
                <field name="employee_job_title"/>
                <field name="employee_branch"/>
                <field name="employee_manager"/>
                <field name="employee_status"/>
                <field name="training_name"/>
                <field name="training_date"/>
                <field name="location"/>
                <field name="trainer"/>
                <field name="validity_date"/>
                <field name="days_to_expire"/>
                <field name="attachment" widget="binary"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hr_training_form" model="ir.ui.view">
        <field name="name">hr.training.form</field>
        <field name="model">hr.training</field>
        <field name="arch" type="xml">
            <form string="Training Line">
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="employee_job_title"/>
                        <field name="employee_branch"/>
                        <field name="employee_manager"/>
                        <field name="employee_status"/>
                    </group>
                    <group>
                        <field name="training_name"/>
                        <field name="training_date"/>
                        <field name="location"/>
                        <field name="trainer"/>
                        <field name="validity_date"/>
                        <field name="attachment" widget="binary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_training_search" model="ir.ui.view">
        <field name="name">hr.training.search</field>
        <field name="model">hr.training</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="employee_job_title"/>
                <field name="employee_branch"/>
                <field name="training_name"/>
                <field name="days_to_expire" string="Days to Expire"/>
                
                <filter name="expired" string="Expired" domain="[('days_to_expire','&lt;',0)]"/>
                <filter name="expiring_soon" string="Expiring Soon (≤30 days)" domain="[('days_to_expire','&lt;=',30),('days_to_expire','&gt;=',0)]"/>
                <filter name="valid" string="Valid (30+ days)" domain="[('days_to_expire','&gt;',30)]"/>
                
                <group expand="0" string="Group By">
                    <filter name="group_by_days" string="Days to Expire" context="{'group_by':'days_to_expire'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_training" model="ir.actions.act_window">
        <field name="name">Training Lines</field>
        <field name="res_model">hr.training</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_hr_training_tree"/>
        <field name="search_view_id" ref="view_hr_training_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new document
            </p>
            <p>
                Also you will find here all the related documents and download it by clicking on any individual
                document.
            </p>
        </field>

    </record>

    <!-- Menuitem -->

    <menuitem id="menu_hr_employee_reports"
              name="Employee Reports"
              parent="hr.menu_hr_root"
              sequence="7"/>
              
    <menuitem id="menu_hr_training"
              name="HR Training Line"
              parent="menu_hr_employee_reports"
              action="action_hr_training"
              sequence="4"/>
</odoo>