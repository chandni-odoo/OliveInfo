<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_customer_document_tree" model="ir.ui.view">
        <field name="name">hr.document.line.tree</field>
        <field name="model">hr.document.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="customer_name" string="Customer Name"/>
                <field name="address_no" string="Customer No"/>
                <field name="branch_id"/>
                <field name="document_line_id"/>
                <field name="document_number"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="status"/>
                <field name="receipt_no"/>
                <field name="receipt_date"/>
                <field name="remarks"/>
                <field name="attachment" widget="binary"/>
            </tree>
        </field>
    </record>

    <record id="view_customer_document_search" model="ir.ui.view">
        <field name="name">hr.document.line.search</field>
        <field name="model">hr.document.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="customer_name" string="Customer Name"/>
                <field name="address_no" string="Customer No"/>
                <field name="branch_id"/>
                <field name="document_number"/>
                <filter string="Customers" name="customer" domain="[('partner_id.customer_rank','>', 0),('partner_id.parent_id', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_customer_document" model="ir.actions.act_window">
        <field name="name">Customer Documents</field>
        <field name="res_model">hr.document.line</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_customer_document_tree"/>
        <field name="search_view_id" ref="view_customer_document_search"/>
        <field name="context">{'search_default_customer': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new document
            </p>
            <p>
                Also you will find here all the related documents and download it by clicking on any individual
                document.
            </p>
        </field>

    </record>

    <record id="view_vendor_document_tree" model="ir.ui.view">
        <field name="name">hr.document.line.tree</field>
        <field name="model">hr.document.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="customer_name" string="Vendor Name"/>
                <field name="address_no" string="Vendor No"/>
                <field name="branch_id"/>
                <field name="document_line_id"/>
                <field name="document_number"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="status"/>
                <field name="receipt_no"/>
                <field name="receipt_date"/>
                <field name="remarks"/>
                <field name="attachment" widget="binary"/>
            </tree>
        </field>
    </record>

    <record id="view_vendor_document_search" model="ir.ui.view">
        <field name="name">hr.document.line.search</field>
        <field name="model">hr.document.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="customer_name" string="Vendor Name"/>
                <field name="address_no" string="Vendor No"/>
                <field name="branch_id"/>
                <field name="document_number"/>
                <filter string="Vendors" name="supplier" domain="[('partner_id.supplier_rank','>', 0),('partner_id.parent_id', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_vendor_document" model="ir.actions.act_window">
        <field name="name">Vendor Documents</field>
        <field name="res_model">hr.document.line</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_vendor_document_tree"/>
        <field name="search_view_id" ref="view_vendor_document_search"/>
        <field name="context">{'search_default_supplier': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new document
            </p>
            <p>
                Also you will find here all the related documents and download it by clicking on any individual
                document.
            </p>
        </field>

    </record>


    <menuitem id="menu_customer_document_line"
              name="Customer Documents"
              parent="account.menu_finance_receivables"
              action="action_customer_document"
              sequence="120"/>

    <menuitem id="menu_vendor_document_line"
              name="Vendor Documents"
              parent="account.menu_finance_payables"
              action="action_vendor_document"
              sequence="300"/>
</odoo>