<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_advance_payment_inv_hide_task" model="ir.ui.view">
        <field name="name">sale.advance.payment.inv.hide.task</field>
        <field name="model">sale.advance.payment.inv</field>
        <field name="inherit_id" ref="sale.view_sale_advance_payment_inv"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <field name="branch_for" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='task_ids']" position="attributes">
                <attribute name="attrs">{'invisible':[('branch_for','=','mro')]}</attribute>
            </xpath>

        </field>
    </record>
</odoo>