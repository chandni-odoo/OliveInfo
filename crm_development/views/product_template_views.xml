<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_view_form_inherited" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="project_extended.product_template_view_form_inherited_skills"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='hazardous']" position="after">
                <field name="incoterm_ids" widget="many2many_tags"/>
                <field name="brand_id"/>
                <field name="specification_attachment" 
                       widget="many2many_binary"/>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_form_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description']/parent::group" position="attributes">
                <attribute name="string">Internal Notes/Specification</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_product_view_form_inherited" model="ir.ui.view">
        <field name="name">product.product.form.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="project_extended.product_product_view_form_inherited_skills"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='hazardous']" position="after">
                <field name="incoterm_ids" widget="many2many_tags"/>
                <field name="brand_id"/>
                <field name="specification_attachment" 
                       widget="many2many_binary"/>
            </xpath>
        </field>
    </record>

    <record id="view_indent_request_form_inherit" model="ir.ui.view">
        <field name="name">indent.request.form.inherit</field>
        <field name="model">indent.request</field>
        <field name="inherit_id" ref="purchase_indent_request.view_indent_request_from"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='proposed_vendor']" position="after">
                <field name="brand_id"/>
            </xpath>
        </field>
    </record>

    <!-- Brand Form View -->
    <record id="view_product_brand_form" model="ir.ui.view">
        <field name="name">product.brand.form</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <form string="Product Brand">
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="code"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Enter brand description..." nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Brand Tree View -->
    <record id="view_product_brand_tree" model="ir.ui.view">
        <field name="name">product.brand.tree</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">
            <tree string="Product Brands">
                <field name="name"/>
                <field name="code"/>
            </tree>
        </field>
    </record>

    <!-- Brand Action -->
    <record id="action_product_brand" model="ir.actions.act_window">
        <field name="name">Product Brands</field>
        <field name="res_model">product.brand</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first product brand!
            </p>
        </field>
    </record>

    

    <!-- Brand Menu -->
    <menuitem id="menu_product_brand" 
              name="Product Brands" 
              parent="stock.menu_product_in_config_stock" 
              action="action_product_brand" 
              sequence="60"/>
</odoo>