<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="custom_external_layout">
        <t t-if="not o" t-set="o" t-value="doc"/>

        <t t-if="not company">
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>

        <!-- ═══════════ HEADER ═══════════ -->
        <div class="header">
            <div>
                <div style="width:77%; float:left;">
                    <img t-if="company.logo"
                         t-att-src="image_data_uri(company.logo)"
                         alt="Logo"
                         style="max-height:70px;"/>
                </div>
                <div style="width:23%; float:right;">
                    <img t-if="company.top_right"
                         t-att-src="image_data_uri(company.top_right)"
                         alt="Logo"
                         style="max-height:70px;"/>
                </div>
            </div>
        </div>

        <!-- ═══════════ BODY ═══════════ -->
        <div class="article o_report_layout_standard"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">

            <!-- Render address block -->
            <t t-if="address">
                <div class="row mb16">
                    <div class="col-5 offset-7">
                        <t t-raw="address"/>
                    </div>
                </div>
            </t>

            <!-- Render information block -->
            <t t-if="information_block">
                <div class="row mb16">
                    <t t-raw="information_block"/>
                </div>
            </t>

            <!-- Report page content -->
            <t t-raw="0"/>
        </div>

        <!-- ═══════════ SEPARATOR ═══════════ -->
        <div class="row zero_min_height">
            <div class="col-12">
                <div style="border-bottom: 1px solid black;"/>
            </div>
        </div>

        <!-- ═══════════ FOOTER ═══════════ -->
        <div class="footer o_standard_footer" style="margin-bottom:40px; font-size:16px;">

            <!-- Delivery / Received signature blocks -->
            <div class="row" style="margin-top: 20px; margin-bottom: 10px;">

                <!-- LEFT: Delivered by -->
                <div class="col-6" style="padding-left: 20px;">
                    <table style="width:100%; border-collapse: collapse; font-size:16px;">
                        <tr>
                            <td style="padding: 6px 0;">
                                <strong>Delivery Date:</strong>
                                <span style="display:inline-block; min-width:150px; border-bottom: 1px solid black; margin-left:8px;">&#160;</span>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 6px 0;">
                                <strong>Delivered By:</strong>
                                <span style="display:inline-block; min-width:150px; border-bottom: 1px solid black; margin-left:8px;">&#160;</span>
                            </td>
                        </tr>
                    </table>
                </div>

                <!-- RIGHT: Received by -->
                <div class="col-6" style="padding-right:20px; padding-left:120px;">
                    <table style="width:100%; border-collapse: collapse; font-size:16px;">
                        <tr>
                            <td style="padding: 6px 0;">
                                <strong>Received Date:</strong>
                                <span style="display:inline-block; min-width:150px; border-bottom: 1px solid black; margin-left:8px;">&#160;</span>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 6px 0;">
                                <strong>Received By:</strong>
                                <span style="display:inline-block; min-width:150px; border-bottom: 1px solid black; margin-left:8px;">&#160;</span>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </template>

    <template id="report_custom_deliveryslip">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
    
                <t t-set="o" t-value="o.with_context(lang=o._get_report_lang())"/>
                <t t-set="partner"
                t-value="o.partner_id
                            or (o.move_lines and o.move_lines[0].partner_id)
                            or False"/>
    
                <t t-set="address">
                    <div name="div_outgoing_address">
                        <div t-if="o.should_print_delivery_address()">
                            <span><strong>Delivery Address:</strong></span>
                            <div t-field="o.move_lines[0].partner_id"
                                t-options='{"widget": "contact",
                                            "fields": ["address", "name", "phone"],
                                            "no_marker": True,
                                            "phone_icons": True}'/>
                        </div>
                        <div t-elif="o.picking_type_id.code != 'internal'
                                    and o.picking_type_id.warehouse_id.partner_id">
                            <span><strong>Warehouse Address:</strong></span>
                            <div t-field="o.picking_type_id.warehouse_id.partner_id"
                                t-options='{"widget": "contact",
                                            "fields": ["address", "name", "phone"],
                                            "no_marker": True,
                                            "phone_icons": True}'/>
                        </div>
                    </div>
                </t>
    
                <t t-set="information_block">
                    <div class="row">
                        <div class="col-7" name="div_incoming_address">
                            <t t-set="show_partner" t-value="False"/>
                            <div t-if="o.picking_type_id.code == 'incoming' and partner">
                                <span><strong>Vendor Address:</strong></span>
                                <t t-set="show_partner" t-value="True"/>
                            </div>
                            <div t-if="o.picking_type_id.code == 'outgoing'
                                    and partner
                                    and partner != partner.commercial_partner_id">
                                <span><strong>Customer Address:</strong></span>
                                <t t-set="show_partner" t-value="True"/>
                            </div>
                            <div t-if="show_partner" name="partner_header">
                                <div t-field="partner.commercial_partner_id"
                                    t-options='{"widget": "contact",
                                                "fields": ["address", "name", "phone"],
                                                "no_marker": True,
                                                "phone_icons": True}'/>
                                <p t-if="partner.sudo().commercial_partner_id.vat">
                                    <t t-esc="o.company_id.country_id.vat_label or 'Tax ID'"/>:
                                    <span t-field="partner.sudo().commercial_partner_id.vat"/>
                                </p>
                            </div>
                        </div>
                    </div>
                </t>
    
                <t t-call="crm_development.custom_external_layout">
                    <div class="page">
    
                        <div class="row">
                            <div class="col-12 text-center">
                                <h2 style="font-weight: bold;">Delivery Order</h2>
                            </div>
                        </div>
    
                        <div class="row mt16 mb16"
                            style="border: 1px solid #dee2e6; padding: 8px; border-radius: 4px;">
                            <div class="col-4">
                                <strong>Reference:</strong>
                                <span t-field="o.name"/>
                            </div>
                            <div t-if="o.origin" class="col-4">
                                <strong>Order:</strong>
                                <span t-field="o.origin"/>
                            </div>
                            <div t-if="o.state" class="col-4" style="white-space: nowrap;">
                                <strong>Shipping Date:</strong>
                                <t t-if="o.state == 'done'">
                                    <span t-field="o.date_done" t-options="{'widget': 'datetime'}"/>
                                </t>
                                <t t-if="o.state != 'done'">
                                    <span t-field="o.scheduled_date" t-options="{'widget': 'datetime'}"/>
                                </t>
                            </div>
                        </div>
    
                        <!-- TABLE FOR STATE != DONE -->
                        <table class="table table-sm table-bordered"
                            t-if="o.state != 'done'"
                            name="stock_move_table">
                            <thead style="background-color: #f2f2f2;">
                                <tr>
                                    <th><strong>Product</strong></th>
                                    <th class="text-center"><strong>Ordered Qty</strong></th>
                                    <th class="text-center"><strong>Delivered Qty</strong></th>
                                    <th class="text-center"><strong>Delivery Time</strong></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="lines"
                                t-value="o.move_lines.filtered(lambda x: x.product_uom_qty)"/>
                                <tr t-foreach="lines" t-as="move">
                                    <td>
                                        <span t-if="move.sale_line_id and move.sale_line_id.name"
                                            t-esc="move.sale_line_id.name"/>
                                        <span t-else="" t-field="move.product_id"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-esc="'%.3f' % move.product_uom_qty"/>
                                        <span t-field="move.product_uom"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-esc="'%.3f' % move.quantity_done"/>
                                        <span t-field="move.product_uom"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-if="move.sale_line_id and move.sale_line_id.delivery_time"
                                            t-esc="move.sale_line_id.delivery_time"/>
                                        <span t-else="">-</span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
    
                        <!-- TABLE FOR STATE == DONE -->
                        <table class="table table-sm table-bordered mt48"
                            t-if="o.move_line_ids and o.state == 'done'"
                            name="stock_move_line_table">
    
                            <t t-set="has_serial_number" t-value="False"/>
                            <t t-set="has_serial_number"
                            t-value="o.move_line_ids.mapped('lot_id')"
                            groups="stock.group_lot_on_delivery_slip"/>
    
                            <thead style="background-color: #f2f2f2;">
                                <tr>
                                    <th><strong>Product</strong></th>
                                    <t t-if="has_serial_number">
                                        <th><strong>Lot/Serial Number</strong></th>
                                    </t>
                                    <th class="text-center" t-if="not has_serial_number">
                                        <strong>Ordered Qty</strong>
                                    </th>
                                    <th class="text-center">
                                        <strong>Delivered Qty</strong>
                                    </th>
                                    <th class="text-center"><strong>Delivery Time</strong></th>
                                </tr>
                            </thead>
                            <tbody>
    
                                <t t-if="o.has_packages" name="has_packages">
                                    <t t-set="packages"
                                    t-value="o.move_line_ids.mapped('result_package_id')"/>
    
                                    <t t-foreach="packages" t-as="package">
                                        <t t-call="stock.stock_report_delivery_package_section_line"/>
                                        <t t-set="package_move_lines"
                                        t-value="o.move_line_ids.filtered(
                                                        lambda l: l.result_package_id == package)"/>
    
                                        <t t-if="has_serial_number">
                                            <tr t-foreach="package_move_lines" t-as="move_line">
                                                <td>
                                                    <span t-if="move_line.move_id.sale_line_id and move_line.move_id.sale_line_id.name"
                                                        t-esc="move_line.move_id.sale_line_id.name"/>
                                                    <span t-else="" t-field="move_line.product_id"/>
                                                </td>
                                                <td>
                                                    <span t-field="move_line.lot_id"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="'%.3f' % move_line.qty_done"/>
                                                    <span t-field="move_line.product_uom_id"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-if="move_line.move_id.sale_line_id and move_line.move_id.sale_line_id.delivery_time"
                                                        t-esc="move_line.move_id.sale_line_id.delivery_time"/>
                                                    <span t-else="">-</span>
                                                </td>
                                            </tr>
                                        </t>
    
                                        <t t-else="">
                                            <t t-set="aggregated_lines"
                                            t-value="package_move_lines._get_aggregated_product_quantities(strict=True)"/>
                                            <t t-foreach="aggregated_lines" t-as="agg_key">
                                                <t t-set="agg" t-value="aggregated_lines[agg_key]"/>
                                                <t t-set="agg_move_line"
                                                t-value="package_move_lines.filtered(lambda l: l.product_id == agg['product'])[:1]"/>
                                                <tr>
                                                    <td>
                                                        <span t-if="agg_move_line and agg_move_line.move_id.sale_line_id and agg_move_line.move_id.sale_line_id.name"
                                                            t-esc="agg_move_line.move_id.sale_line_id.name"/>
                                                        <span t-else=""
                                                            t-esc="agg['product'].display_name"/>
                                                        <p t-if="not (agg_move_line and agg_move_line.move_id.sale_line_id and agg_move_line.move_id.sale_line_id.name) and agg.get('description') and agg.get('description') != agg['product'].display_name">
                                                            <span t-esc="agg.get('description')"/>
                                                        </p>
                                                    </td>
                                                    <td class="text-center">
                                                        <span t-esc="'%.3f' % (agg.get('qty_ordered') or 0.0)"/>
                                                        <span t-esc="agg.get('product_uom') if isinstance(agg.get('product_uom'), str) else (agg['product_uom'].name if agg.get('product_uom') else '')"/>
                                                    </td>
                                                    <td class="text-center">
                                                        <span t-esc="'%.3f' % (agg.get('qty_done') or 0.0)"/>
                                                        <span t-esc="agg.get('product_uom') if isinstance(agg.get('product_uom'), str) else (agg['product_uom'].name if agg.get('product_uom') else '')"/>
                                                    </td>
                                                    <td class="text-center">
                                                        <span t-if="agg_move_line and agg_move_line.move_id.sale_line_id and agg_move_line.move_id.sale_line_id.delivery_time"
                                                            t-esc="agg_move_line.move_id.sale_line_id.delivery_time"/>
                                                        <span t-else="">-</span>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                    </t>
    
                                    <t t-set="move_lines"
                                    t-value="o.move_line_ids.filtered(lambda l: not l.result_package_id)"/>
                                    <t t-set="aggregated_lines"
                                    t-value="o.move_line_ids._get_aggregated_product_quantities(except_package=True)"/>
                                    <t t-if="move_lines or aggregated_lines">
                                        <t t-call="stock.stock_report_delivery_no_package_section_line"/>
    
                                        <t t-if="has_serial_number">
                                            <tr t-foreach="move_lines" t-as="move_line">
                                                <td>
                                                    <span t-if="move_line.move_id.sale_line_id and move_line.move_id.sale_line_id.name"
                                                        t-esc="move_line.move_id.sale_line_id.name"/>
                                                    <span t-else="" t-field="move_line.product_id"/>
                                                </td>
                                                <td>
                                                    <span t-field="move_line.lot_id"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="'%.3f' % move_line.qty_done"/>
                                                    <span t-field="move_line.product_uom_id"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-if="move_line.move_id.sale_line_id and move_line.move_id.sale_line_id.delivery_time"
                                                        t-esc="move_line.move_id.sale_line_id.delivery_time"/>
                                                    <span t-else="">-</span>
                                                </td>
                                            </tr>
                                        </t>
    
                                        <t t-elif="aggregated_lines">
                                            <t t-foreach="aggregated_lines" t-as="agg_key">
                                                <t t-set="agg" t-value="aggregated_lines[agg_key]"/>
                                                <t t-set="agg_move_line"
                                                t-value="move_lines.filtered(lambda l: l.product_id == agg['product'])[:1]"/>
                                                <tr>
                                                    <td>
                                                        <span t-if="agg_move_line and agg_move_line.move_id.sale_line_id and agg_move_line.move_id.sale_line_id.name"
                                                            t-esc="agg_move_line.move_id.sale_line_id.name"/>
                                                        <span t-else=""
                                                            t-esc="agg['product'].display_name"/>
                                                        <p t-if="not (agg_move_line and agg_move_line.move_id.sale_line_id and agg_move_line.move_id.sale_line_id.name) and agg.get('description') and agg.get('description') != agg['product'].display_name">
                                                            <span t-esc="agg.get('description')"/>
                                                        </p>
                                                    </td>
                                                    <td class="text-center">
                                                        <span t-esc="'%.3f' % (agg.get('qty_ordered') or 0.0)"/>
                                                        <span t-esc="agg.get('product_uom') if isinstance(agg.get('product_uom'), str) else (agg['product_uom'].name if agg.get('product_uom') else '')"/>
                                                    </td>
                                                    <td class="text-center">
                                                        <span t-esc="'%.3f' % (agg.get('qty_done') or 0.0)"/>
                                                        <span t-esc="agg.get('product_uom') if isinstance(agg.get('product_uom'), str) else (agg['product_uom'].name if agg.get('product_uom') else '')"/>
                                                    </td>
                                                    <td class="text-center">
                                                        <span t-if="agg_move_line and agg_move_line.move_id.sale_line_id and agg_move_line.move_id.sale_line_id.delivery_time"
                                                            t-esc="agg_move_line.move_id.sale_line_id.delivery_time"/>
                                                        <span t-else="">-</span>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                    </t>
                                </t>
    
                                <t t-else="">
    
                                    <t t-if="has_serial_number">
                                        <tr t-foreach="o.move_line_ids" t-as="move_line">
                                            <td>
                                                <span t-if="move_line.move_id.sale_line_id and move_line.move_id.sale_line_id.name"
                                                    t-esc="move_line.move_id.sale_line_id.name"/>
                                                <span t-else="" t-field="move_line.product_id"/>
                                            </td>
                                            <td>
                                                <span t-field="move_line.lot_id"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-esc="'%.3f' % move_line.qty_done"/>
                                                <span t-field="move_line.product_uom_id"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-if="move_line.move_id.sale_line_id and move_line.move_id.sale_line_id.delivery_time"
                                                    t-esc="move_line.move_id.sale_line_id.delivery_time"/>
                                                <span t-else="">-</span>
                                            </td>
                                        </tr>
                                    </t>
    
                                    <t t-else="">
                                        <t t-set="aggregated_lines"
                                        t-value="o.move_line_ids._get_aggregated_product_quantities()"/>
                                        <t t-foreach="aggregated_lines" t-as="agg_key">
                                            <t t-set="agg" t-value="aggregated_lines[agg_key]"/>
                                            <t t-set="agg_move_line"
                                            t-value="o.move_line_ids.filtered(lambda l: l.product_id == agg['product'])[:1]"/>
                                            <tr>
                                                <td>
                                                    <span t-if="agg_move_line and agg_move_line.move_id.sale_line_id and agg_move_line.move_id.sale_line_id.name"
                                                        t-esc="agg_move_line.move_id.sale_line_id.name"/>
                                                    <span t-else=""
                                                        t-esc="agg['product'].display_name"/>
                                                    <p t-if="not (agg_move_line and agg_move_line.move_id.sale_line_id and agg_move_line.move_id.sale_line_id.name) and agg.get('description') and agg.get('description') != agg['product'].display_name">
                                                        <span t-esc="agg.get('description')"/>
                                                    </p>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="'%.3f' % (agg.get('qty_ordered') or 0.0)"/>
                                                    <span t-esc="agg.get('product_uom') if isinstance(agg.get('product_uom'), str) else (agg['product_uom'].name if agg.get('product_uom') else '')"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-esc="'%.3f' % (agg.get('qty_done') or 0.0)"/>
                                                    <span t-esc="agg.get('product_uom') if isinstance(agg.get('product_uom'), str) else (agg['product_uom'].name if agg.get('product_uom') else '')"/>
                                                </td>
                                                <td class="text-center">
                                                    <span t-if="agg_move_line and agg_move_line.move_id.sale_line_id and agg_move_line.move_id.sale_line_id.delivery_time"
                                                        t-esc="agg_move_line.move_id.sale_line_id.delivery_time"/>
                                                    <span t-else="">-</span>
                                                </td>
                                            </tr>
                                        </t>
                                    </t>
                                </t>
    
                            </tbody>
                        </table>
    
                        <t t-set="backorders"
                        t-value="o.backorder_ids.filtered(
                                        lambda x: x.state not in ('done','cancel'))"/>
                        <t t-if="o.backorder_ids and backorders">
                            <p class="mt-5">
                                <span>Remaining quantities not yet delivered:</span>
                            </p>
                            <table class="table table-sm table-bordered"
                                style="table-layout: fixed;">
                                <thead style="background-color: #f2f2f2;">
                                    <tr>
                                        <th><strong>Product</strong></th>
                                        <th/>
                                        <th class="text-center"><strong>Quantity</strong></th>
                                        <th class="text-center"><strong>Delivery Time</strong></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="backorders" t-as="backorder">
                                        <t t-set="bo_lines"
                                        t-value="backorder.move_lines.filtered(
                                                        lambda x: x.product_uom_qty)"/>
                                        <tr t-foreach="bo_lines" t-as="bo_line">
                                            <td>
                                                <span t-if="bo_line.sale_line_id and bo_line.sale_line_id.name"
                                                    t-esc="bo_line.sale_line_id.name"/>
                                                <span t-else="" t-field="bo_line.product_id"/>
                                            </td>
                                            <td/>
                                            <td class="text-center">
                                                <span t-esc="'%.3f' % bo_line.product_uom_qty"/>
                                                <span t-field="bo_line.product_uom"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-if="bo_line.sale_line_id and bo_line.sale_line_id.delivery_time"
                                                    t-esc="bo_line.sale_line_id.delivery_time"/>
                                                <span t-else="">-</span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
    
                        <div t-if="o.signature" class="mt32 ml64 mr4" name="signature">
                            <div class="offset-8"><strong>Signature</strong></div>
                            <div class="offset-8">
                                <img t-att-src="image_data_uri(o.signature)"
                                    style="max-height:4cm; max-width:8cm;"/>
                            </div>
                            <div class="offset-8 text-center">
                                <p t-field="o.partner_id.name"/>
                            </div>
                        </div>
    
                    </div>
                </t>
            </t>
        </t>
    </template>
 
 

