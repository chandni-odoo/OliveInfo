<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hr_leave_form_inherit" model="ir.ui.view">
        <field name="name">hr.leave.view.form.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">

            <!--            point no 8-->
            <xpath expr="//button[@name='action_approve']" position="attributes">
                <attribute name="groups">leave_extended.leave_approval_group</attribute>
            </xpath>

            <xpath expr="//button[@name='action_validate']" position="attributes">
                <attribute name="groups">leave_extended.validate_leave_approved_group</attribute>
            </xpath>

            <xpath expr="//button[@name='action_refuse']" position="attributes">
                <attribute name="groups">leave_extended.leave_approval_group</attribute>
            </xpath>

            <xpath expr="//field[@name='name']" position="after">
                <field name="air_ticket"/>
                <field name="emergency_contact_number"/>
                <field name="address"/>
                <field name="check_leave_view"/>
                <field name="recycle_planning"/>
                <field name="duty_resumption_leave"/>
                <field name="is_calender_day"/>
            </xpath>


            <xpath expr="//sheet/group/group[@name='col_left']/div[1]" position="after">
                <field name="cal_custom_duration"
                       attrs="{'invisible': [('cal_custom_duration', '=', 0.0)]}"/>
            </xpath>

            <xpath expr="//sheet/group/group[@name='col_left']/label[2]" position="replace">
                <label for="number_of_days" string="Duration"
                       attrs="{'invisible': [('request_unit_half', '=', True), ('leave_type_request_unit', '!=', 'hour')]}"/>
            </xpath>

        </field>
    </record>

