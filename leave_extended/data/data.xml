<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<data  noupdate="1">
		<record id="sequence_hr_employee_own" model="ir.sequence">
			<field name="name">Employee Number OWN</field>
			<field name="code">hr.employee.own</field>	
			<field name="padding">4</field>
		    <field name="number_increment">1</field>
			<field name="prefix">EMP/OWN/</field>
		</record>

		<record id="sequence_hr_employee_subcontractor" model="ir.sequence">
			<field name="name">Employee Number Sub Contractor</field>
			<field name="code">hr.employee.subcontractor</field>	
			<field name="padding">4</field>
		    <field name="number_increment">1</field>
			<field name="prefix">EMP/SUBCONT/</field>
		</record>


		<record id="ir_cron_check_employee_status" model="ir.cron">
            <field name="name">HR EMPLOYEE: update leave status</field>
            <field name="model_id" ref="model_hr_employee"/>
            <field name="type">ir.actions.server</field>
            <field name="state">code</field>
            <field name="code">model.update_employee_leave_status()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
        </record>
	</data>
</odoo>
