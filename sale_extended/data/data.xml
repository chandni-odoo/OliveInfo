<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <record id="product_uom_month" model="uom.uom">
            <field name="name">Month</field>
            <field name="category_id" ref="uom.uom_categ_wtime"/>
            <field name="factor" eval="2.0"/>
            <field name="uom_type">bigger</field>
        </record>

        <record id="sequence_customer_site_visit" model="ir.sequence">
            <field name="name">name</field>
            <field name="code">site.visit</field>
            <field name="prefix">SI/</field>
            <field name="padding">3</field>
            <field name="number_increment">1</field>
        </record>
        <record id="sequence_customer_onboarding_request" model="ir.sequence">
            <field name="name">CustomerOnboardingRequest</field>
            <field name="code">customer.onboarding.request</field>
            <field name="prefix">CO/</field>
            <field name="padding">3</field>
            <field name="number_increment">1</field>
        </record>
        <record id="sequence_site_inspection" model="ir.sequence">
            <field name="name">name</field>
            <field name="code">sale.site.inspection</field>
            <field name="prefix">SI/</field>
            <field name="padding">3</field>
            <field name="number_increment">1</field>
        </record>
        <record id="sequence_customer_request" model="ir.sequence">
            <field name="name">address_no</field>
            <field name="code">res.partner</field>
            <field name="prefix">Contacts/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
        </record>
        <record id="sequence_supplier_request" model="ir.sequence">
            <field name="name">name</field>
            <field name="code">supplier.onboarding.request</field> 
            <field name="prefix">Sup/</field>
            <field name="padding">3</field>
            <field name="number_increment">1</field>
        </record>
        <record id="sequence_sale_agreement" model="ir.sequence">
            <field name="name">name</field>
            <field name="code">sale.agreement</field> 
            <field name="prefix">Agree</field>
            <field name="padding">3</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>
