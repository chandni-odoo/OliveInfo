<odoo>
    <data>

        <record id="site_inspection_email_template" model="mail.template">
            <field name="name">Site Inspection</field>
            <field name="model_id" ref="sale_extended.model_site_inspection_wizard"/>
            <field name="email_from">{{ (object.sale_id.user_id.login) }}</field>
            <field name="email_to">{{ object.user_id.login }}</field>
            <field name="subject">Site Inspection for Sale Order {{ object.sale_id.name }}</field>
            <field name="auto_delete" eval="True"/>
            <!--            <field name="lang">${object.partner_id.lang}</field>-->
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-size: 13px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hello,
                    </p>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Please check the Site Inspection for
                        <t t-out="object.site_inspection_id.name"/>
                    </p>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Thank you.
                    </p>
                </div>
            </field>
        </record>

        <record id="site_visit_mail_id" model="mail.template">
            <field name="name">Site Visit</field>
            <field name="model_id" ref="sale_extended.model_site_visit"/>
            <field name="email_from">{{ (object.prepared_id.login) }}</field>
            <field name="email_to">{{ object.prepared_id.login }}</field>
            <field name="subject">Site Visit</field>
            <field name="auto_delete" eval="True"/>
            <!--            <field name="lang">${object.partner_id.lang}</field>-->
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-size: 13px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hello,
                    </p>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Site Visit has been marked as Done for
                        <t t-out="object.partner_id.name"/>
                        <t t-out="object.name"/>
                    </p>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Thank you.
                    </p>
                </div>
            </field>
        </record>

        <record id="sale_site_inspection_mail_id" model="mail.template">
            <field name="name">Sale Site Inspection</field>
            <field name="model_id" ref="sale_extended.model_sale_site_inspection"/>
            <field name="email_from">{{ (object.assign_id.login) }}</field>
            <field name="email_to">{{ object.prepared_id.login }}</field>
            <field name="subject">Sale Site Inspection</field>
            <field name="auto_delete" eval="True"/>
            <!--            <field name="lang">${object.partner_id.lang}</field>-->
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-size: 13px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hello,
                    </p>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Sale Site Inspection has been marked as Done for
                        <t t-out="object.name"/>
                    </p>
                    <br/>
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Thank you.
                    </p>
                </div>
            </field>
        </record>

    </data>
</odoo>