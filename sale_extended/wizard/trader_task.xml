<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="trader_task_wizard_form_view" model="ir.ui.view">
        <field name="name">trader.task.wizard.from</field>
        <field name="model">trader.task.wizard</field>
        <field name="arch" type="xml">
            <form string="Trade Test">
                <sheet>
                    <group>
                        <group col="2">
                            <field name="task_id" readonly="1"/>
                            <field name="date"/>
                        </group>
                        <group col="2">
                            <field name="sale_order_id" readonly="1"/>
                            <field name="attachment_id"/>
                            <field name="remark"/>
                        </group>
                    </group>
                    <group>
                        <field name="trade_test_ids" nolabel="1" widget='one2many' class="oe_inline oe_no_button">
                            <tree editable="bottom">
                                <field name="employee_id" domain="[('billable', '=', True)]"/>
                                <field name="status"/>
                                <field name="attachment_id"/>
                                <field name="remark"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button string="Approve" name="action_approve" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="trader_task_wizard_action" model="ir.actions.act_window">
        <field name="name">Trade Test</field>
        <field name="res_model">trader.task.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="trader_task_wizard_form_view"/>
        <field name="target">new</field>
    </record>

    <record id="trade_test_record_tree_view" model="ir.ui.view">
        <field name="name">trade.test.record.tree.view</field>
        <field name="model">trade.test.record</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="task_id"/>
                <field name="employee_id"/>
                <field name="sale_order_id"/>
                <field name="date"/>
                <field name="remark"/>
                <field name="attachment_id"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="action_trade_test_record" model="ir.actions.act_window">
        <field name="name">Trade Test Records</field>
        <field name="res_model">trade.test.record</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="trade_test_record_tree_view"/>
    </record>

    <menuitem
            id="menu_test_trade" name="Trade Test"
            action="action_trade_test_record"
            parent="project.menu_project_config"
    />

</odoo>

