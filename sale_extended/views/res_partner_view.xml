<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_tree_inherit_peoplesol" model="ir.ui.view">
        <field name="name">res.partner.view.inherit.peoplesol</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="display_name" position="before">
                <field name="address_no"/>
            </field>
            <field name="display_name" position="after">
                <field name="branch_id"/>
            </field>
        </field>
    </record>

    <record id="res_partner_kanban_view_inherit_peoplesol" model="ir.ui.view">
        <field name="name">res.partner.view.kanban.inherit.peoplesol</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.res_partner_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//strong[hasclass('o_kanban_record_title')]" position="after">
                <field name="address_no"/>
                <field name="branch_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_contacts_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.view</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(purchase.act_res_partner_2_purchase_order)d']" position="after">
               <button type="object" name="site_inspection" class="oe_stat_button" icon="fa-pencil-square-o" attrs="{'invisible': [('site_count', '=', 0)]}">
                <field name="site_count" widget="statinfo" string="Site Inspection"/>
                </button>
                <button type="object" name="open_site_visit" class="oe_stat_button" icon="fa-pencil-square-o" attrs="{'invisible': [('site_visit_count', '=', 0)]}">
                <field name="site_visit_count" widget="statinfo" string="Site Visit"/>
                </button>
            </xpath>
            <xpath expr="//sheet/notebook/page[@name='sales_purchases']/group/group[1]" position="inside">
                <field name="is_customer"/>
            </xpath>
            <!-- <xpath expr="//sheet/notebook/page[@name='sales_purchases']/group/group[2]" position="inside">
                <field name="is_supplier"/>
            </xpath> -->
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="Customer Master" attrs="{'invisible': [('is_customer', '=', False)]}" name="customer_master">
                    <group>
                        <group>
                            <field name="address_no"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                        </group>
                    </group>
                </page>
                <page string="Supplier Master" attrs="{'invisible': [('is_supplier', '=', False)]}">
                    <group>
                        <group>
                            <field name="address_no"/>
                            <field name="spe_payee_id"/>
                            <field name="hold_payment"/>
                            <field name="hold_reason_id"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="payment_instrument"/>
                            <field name="credit_facility"/>
                            <field name="parent"/>
                        </group>
                    </group>
                </page>
                <page string="Category" name="category">
                    <group>
                        <group>
                            <field name="region_id"/>
                            <field name="grade_id"/>
                        </group>
                        <group>
                            <field name="sector_id"/>
                            <field name="location_id"/>
                            <field name="segment_id"/>
                        </group>
                    </group>
                </page>
                <page string="Credit Control" name="credit_control">
                    <group>
                        <group>
                            <field name="hold_option"/>
                            <field name="credit_block"/>
                            <field name="credit_limit"/>
                            <field name="credit_days"/>
                            <field name="credit_manager"/>
                        </group>
                        <group>
                            <field name="hold_reason"/>
                            <field name="credit_facility"/>
                            <field name="ava_credit_bal"/>
                            <!-- <field name="ava_unbilled_bal"/> -->
                            <field name="credit_message"/>
                            <field name="collection_manager"/>
                        </group>
                    </group>
                </page>
                <page string="Billing" name="billing">
                    <group>
                        <group>
                            <field name="delivery_address"/>
                            <field name="billing_method"/>
                        </group>
                        <group>
                            <field name="payment_instrument"/>
                        </group>
                    </group>
                </page>
                <page string="Nature of Business" name="nature_of_business">
                    <group>
                        <group>
                            <field name="customer_profile"/>
                            <field name="license_no"/>
                            <field name="license_validity"/>
                            <field name="annual_revenue"/>
                            <field name="how_to_know"/>
                        </group>
                        <group>
                            <field name="parent_company"/>
                            <field name="issuing_authority"/>
                            <field name="growth_rate"/>
                            <field name="total_employees"/>
                      </group>
                    </group>
                </page>
                <page string="Account" name="account">
                    <group>
                        <group>
                            <field name="acc_coordinator_id"/>
                            <field name="cs_coordinator_id"/>
                            <field name="initiated_id"/>
                            <field name="comments"/>
                        </group>
                        <group>
                            <field name="sales_person_id"/>
                            <field name="ope_coordinator_id"/>
                            <field name="lost_to"/>
                        </group>
                    </group>
                </page>
                <page string="Onboarding Info" name="onboarding">
                    <group>
                        <group>
                            <field name="advance_coll"/>
                            <field name="contract_period"/>
                            <field name="agreement_ref"/>
                        </group>
                        <group>
                            <field name="security_deposite"/>
                            <field name="expected_sales"/>
                            <field name="job_type_id"/>
                        </group>
                    </group>
                </page>
                <page string="Documents" name="documents">
                    <field name="document_line_ids">
                        <tree editable="bottom">
                            <field name="document_line_id"/>
                            <field name="document_number"/>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                            <field name="status"/>
                            <field name="receipt_no"/>
                            <field name="receipt_date"/>
                            <field name="remarks"/>
                            <field name="attachment" widget="binary"/>
                        </tree>
                    </field>
                </page>
                <page string="Document Validity" name="document">
                    <group>
                        <group>
                            <field name="computer_card"/>
                            <field name="trade_license"/>
                            <field name="tax_card"/>
                            <field name="sponsor_id"/>
                            <field name="cr"/>
                            <field name="qid"/>
                            <field name="passport"/>
                            <field name="noc_sponsor"/>  
                            
                        </group>
                        <group>
                            <field name="cc_validity"/>
                            <field name="tl_validity"/>
                            <field name="tc_validity"/>
                            <field name="sid_validity"/>
                            <field name="cr_validity"/>
                            <field name="qid_validity"/>
                            <field name="passport_validity"/> 
                        </group>
                    </group>
                </page>
                <page string="Partner" name="partner">
                    <group>
                        <group>
                            <field name="designation_id"/>
                            <field name="support_level"/>
                            <field name="anniversary_date"/>
                            <field name="date_of_birth"/>
                            <field name="location"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                            <field name="marital_status"/>
                            <field name="hobbies"/>
                            <field name="religion_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='contract_type_id']" position="after">
                <field name="contact_type" invisible="1"/>
                <field name="onboarding_id" invisible="1"/>
                <field name="supplier_id"/>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']" position="attributes">
                <attribute name="attrs">{'invisible': [('contact_type', 'in', ['contact', 'employee'])]}</attribute>
            </xpath>
            <xpath expr="//page[@name='partner']" position="attributes">
                <attribute name="attrs">{'invisible': [('contact_type', 'in', ['contact', 'employee'])]}</attribute>
            </xpath>
            <xpath expr="//page[@name='internal_notes']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('contact_type', '=', 'contact'), ('is_customer', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//page[@name='category']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('contact_type', 'in', ['contact', 'employee']), ('is_customer', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//page[@name='credit_control']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('contact_type', 'in', ['contact', 'employee']), ('is_customer', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//page[@name='billing']" position="attributes">
                <attribute name="attrs">{'invisible': [('contact_type', 'not in', ['partner', 'employee'])]}</attribute>
            </xpath>
            <xpath expr="//page[@name='nature_of_business']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('contact_type', 'in', ['contact', 'employee']), ('is_customer', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//page[@name='account']" position="attributes">
               <attribute name="attrs">{'invisible': [('contact_type', '!=', 'partner')]}</attribute>
            </xpath>
            <xpath expr="//page[@name='onboarding']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('contact_type', 'in', ['contact', 'employee']), ('is_customer', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//page[@name='documents']" position="attributes">
                <attribute name="attrs">{'invisible': [('contact_type', '=', 'contact')]}</attribute>
            </xpath>
            <xpath expr="//page[@name='document']" position="attributes">
                <attribute name="attrs">{'invisible': [('contact_type', '=', 'contact')]}</attribute>
            </xpath>
            <xpath expr="//notebook/page[3]" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('contact_type', 'not in', ['partner', 'employee']), ('is_customer', '=', False), ('is_supplier', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//span[@name='address_name']" position="before">
                <field name="address_no"/>
            </xpath>
        </field>
    </record>
    <record id="account.res_partner_view_search" model="ir.ui.view">
        <field name="name">res.partner.search.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="before">
                <filter string="Customers" name="customer" domain="[('customer_rank','>', 0),('parent_id', '=', False)]"/>
                <filter string="Vendors" name="supplier" domain="[('supplier_rank','>', 0),('parent_id', '=', False)]"/>
            </xpath>
        </field>
    </record>
    <record id="account.res_partner_action_customer" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'default_is_customer':'t','search_default_customer': 1,'res_partner_search_mode': 'customer', 'default_is_company': True, 'default_customer_rank': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new customer in your address book
            </p>
            <p>
                Odoo helps you easily track all activities related to a customer.
            </p>
        </field>
    </record>
    <record id="account.res_partner_action_supplier" model="ir.actions.act_window">
        <field name="name">Suppliers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'default_is_supplier':'t','search_default_supplier': 1,'res_partner_search_mode': 'supplier', 'default_is_company': True, 'default_supplier_rank': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new supplier in your address book
            </p>
            <p>
                Odoo helps you easily track all activities related to a supplier.
            </p>
        </field>
    </record>
</odoo>
