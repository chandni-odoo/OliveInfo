<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="cost_plus_tree_view" model="ir.ui.view">
            <field name="name">cost.plus.tree.view</field>
            <field name="model">cost.plus</field>
            <field name="arch" type="xml">
                <tree string="Cost Plus">
                    <field name="name" string="Batch Number"/>
                    <field name="cost_date"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>


        <record id="cost_plus_search_view" model="ir.ui.view">
            <field name="name">cost.plus.search.view</field>
            <field name="model">cost.plus</field>
            <field name="arch" type="xml">
                <search string="Cost Plus Search">
                    <field name="name" string="Batch Number"/>
                    <field name="cost_date"/>
                    <field name="state"/>

                    <filter string="New" name="new" domain="[('state', '=', 'new')]"/>
                    <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                    <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>

                    <group expand="1" string="Group By">
                        <filter string="Batch Number" name="group_by_name" context="{'group_by':'name'}"/>
                        <filter string="Date" name="group_by_date" context="{'group_by':'cost_date'}"/>
                        <filter string="State" name="group_by_state" context="{'group_by':'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="cost_plus_form_view" model="ir.ui.view">
            <field name="name">cost.plus.form.view</field>
            <field name="model">cost.plus</field>
            <field name="arch" type="xml">
                <form string="Cost Plus">
                    <header>
                        <field name="is_approved" invisible="1"/>
                        <field name="users_count" invisible="1"/>
                        <field name="can_create_earning" invisible="1"/>
                        <field name="button_status" invisible="1"/>
                        <!--  <button name="action_waiting_for_approval" string="Approve" type="object" class="btn-primary"
                             groups="sale_extended.cost_plus_approved_group"
                             attrs="{'invisible': [('state', 'in', ['pending','approved','reject'])]}"/> -->
                        <button name="action_approve" string="Approve" type="object" class="btn-primary"
                                groups="sale_extended.cost_plus_approved_group"
                                attrs="{'invisible': [('state', 'in', ['approved','reject'])]}"/>
                        <button name="action_reject" string="Reject" type="object" class="btn-primary"
                                groups="sale_extended.cost_plus_approved_group"
                                attrs="{'invisible': [('state', 'in', ['approved','reject'])]}"/>
                        <!-- <button name="%(pways_sale_approval.sale_approval_rejected_action)d" string="Reject"
                                type="action" class="btn-primary"
                                groups="sale_extended.cost_plus_approved_group"
                                attrs="{'invisible': [('state', 'in', ['pending','approved','reject'])]}"/> -->
                        <button name="create_other_earning" string="Create Other Earnings" type="object"
                                class="oe_highlight"
                                attrs="{
                                    'invisible': ['|', ('state', 'in', ['pending','new','reject']), ('button_status', '!=', 'can_create')]
                                }"/>
                        
                        <!-- Red button when already created -->
                        <button name="create_other_earning" string="Earnings Already Created" type="object"
                                class="btn-danger"
                                attrs="{
                                    'invisible': ['|', ('state', 'in', ['pending','new','reject']), ('button_status', '!=', 'already_created')],
                                    'readonly': [('button_status', '=', 'already_created')]
                                }"/>
                        <!-- <button name="create_other_earning" string="Create Other Earnings" type="object"
                                attrs="{'invisible': [('state', 'in', ['pending','new','reject'])]}"/> -->
                        <field name="state" widget="statusbar" statusbar_visible="new,approved,reject"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="cost_date"/>
                        </group>
                        <group>
                            <field name="reject_reason"/>
                        </group>
                        <notebook>
                            <page string="Cost Plus Line">
                                <field name="cost_line_ids">
                                    <tree editable="bottom">
                                        <field name="cost_plus_line_date"
                                               attrs="{'readonly': ['|', ('billing_status','=', True),('payroll_status','=', True)]}"/>
                                        <field name="product_id"
                                               attrs="{'readonly': ['|', ('billing_status','=', True),('payroll_status','=', True)]}"/>
                                        <field name="employee_id"
                                               attrs="{'readonly': ['|', ('billing_status','=', True),('payroll_status','=', True)]}"/>
                                        <field name="amount"
                                               attrs="{'readonly': ['|', ('billing_status','=', True),('payroll_status','=', True)]}"/>
                                        <field name="uom_id" required="True"
                                               attrs="{'readonly': ['|', ('billing_status','=', True),('payroll_status','=', True)]}"/>
                                        <field name="partner_id" readonly="1"/>
                                        <field name="sale_order_id" readonly="1"/>
                                        <field name="task_id"
                                               attrs="{'readonly': ['|', ('billing_status','=', True),('payroll_status','=', True)]}"/>
                                        <field name="billing"
                                               attrs="{'readonly': ['|', ('billing_status','=', True),('payroll_status','=', True)]}"/>
                                        <field name="payroll"
                                               attrs="{'readonly': ['|', ('billing_status','=', True),('payroll_status','=', True)]}"/>
                                        <field name="billing_status"/>
                                        <field name="payroll_status"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Approved History">
                                <field name="cost_approval_history_ids">
                                    <tree editable="bottom" create="0" delete="0">
                                        <field name="user_id"/>
                                        <field name="status"/>
                                        <field name="date_done"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="cost_plus_line_tree_view" model="ir.ui.view">
            <field name="name">cost.plus.line.tree.view</field>
            <field name="model">cost.plus.line</field>
            <field name="arch" type="xml">
                <tree string="Cost Plus Line" editable="bottom">
                    <field name="cost_plus_id" readonly="1"/>
                    <field name="cost_plus_line_date"
                           attrs="{'readonly': ['|', ('billing_status','=', True),('payroll_status','=', True)]}"/>
                    <field name="product_id"
                           attrs="{'readonly': ['|', ('billing_status','=', True),('payroll_status','=', True)]}"/>
                    <field name="employee_id"
                           attrs="{'readonly': ['|', ('billing_status','=', True),('payroll_status','=', True)]}"/>
                    <field name="amount"
                           attrs="{'readonly': ['|', ('billing_status','=', True),('payroll_status','=', True)]}"/>
                    <field name="uom_id" required="True"
                           attrs="{'readonly': ['|', ('billing_status','=', True),('payroll_status','=', True)]}"/>
                    <field name="partner_id" readonly="1"/>
                    <field name="sale_order_id" readonly="1"/>
                    <field name="task_id"
                           attrs="{'readonly': ['|', ('billing_status','=', True),('payroll_status','=', True)]}"/>
                    <field name="billing"
                           attrs="{'readonly': ['|', ('billing_status','=', True),('payroll_status','=', True)]}"/>
                    <field name="payroll"
                           attrs="{'readonly': ['|', ('billing_status','=', True),('payroll_status','=', True)]}"/>
                    <field name="billing_status"/>
                    <field name="payroll_status"/>
                </tree>
            </field>
        </record>

        <record id="action_view_of_cost_plus" model="ir.actions.act_window">
            <field name="name">Cost PLus</field>
            <field name="res_model">cost.plus</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="action_view_of_cost_plus_line" model="ir.actions.act_window">
            <field name="name">Cost PLus Line</field>
            <field name="res_model">cost.plus.line</field>
            <field name="view_mode">tree</field>
            <field name="domain">[('cost_plus_id', '=', False)]</field>
        </record>

        <record id="action_create_batch" model="ir.actions.server">
            <field name="name">Create Cost Plus Batch</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="model_cost_plus_line"/>
            <field name="binding_model_id" ref="model_cost_plus_line"/>
            <field name="state">code</field>
            <field name="code">records.create_cost_plus_batch()</field>
        </record>

        <menuitem
                id="menu_cost_plus"
                name="Cost PLus"
                action="action_view_of_cost_plus"
                parent="sale.menu_sale_config"
                sequence="30"/>

        <menuitem
                id="menu_cost_plus_line"
                name="Cost PLus Line"
                action="action_view_of_cost_plus_line"
                parent="sale.menu_sale_config"
                sequence="31"/>

    </data>
</odoo>
