<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_client_accommodation_form" model="ir.ui.view">
        <field name="name">client.accommodation.form</field>
        <field name="model">client.accommodation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="client_accommodation_id"/>
                            <field name="sale_order_id"/>
                            <field name="customer_id" readonly="1"/>
                            <field name="contact_number" readonly="1"/>
                            <field name="contact_person" readonly="1"/>
                            <field name="payment_terms" readonly="1"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="rental_type"/>
                            <field name="maintenance_by"/>
                            <field name="signed_by"/>
                            <field name="designation"/>
                            <field name="rental_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lease Products">
                            <field name="product_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="product_uom"/>
                                    <field name="currency_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Additional Details">
                            <group>
                                <group>
                                    <field name="unit_type"/>
                                    <field name="allowed_people"/>
                                    <field name="camp_id"/>
                                    <field name="num_of_units"/>
                                    <field name="room_type_ids" widget="many2many_tags"/>
                                </group>
                                <group>
                                    <field name="with_facilities"/>
                                    <field name="facilities" attrs="{'invisible': [('with_facilities', '=', False)]}" widget="many2many_tags"/>
                                    <field name="rate_unit"/>
                                    <field name="rental_amount" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Terms and Conditions">
                            <field name="terms_conditions"/>
                            <field  name="description"/>
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_client_accommodation_tree" model="ir.ui.view">
        <field name="name">client.accommodation.tree</field>
        <field name="model">client.accommodation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="client_accommodation_id"/>
                <field name="customer_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="rental_type"/>
                <field name="maintenance_by"/>
                <field name="rental_date"/>
            </tree>
        </field>
    </record>

    <record id="action_client_accommodation" model="ir.actions.act_window">
        <field name="name">Customer Rental Contracts</field>
        <field name="res_model">client.accommodation</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_sm">Create and manage rental contracts for company-owned camps.</p>
        </field>
    </record>

    
</odoo>