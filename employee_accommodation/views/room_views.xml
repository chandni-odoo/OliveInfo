<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_accommodation_room_tree" model="ir.ui.view">
        <field name="name">accommodation.room.tree</field>
        <field name="model">accommodation.room</field>
        <field name="arch" type="xml">
            <tree>
                <field name="camp_id"/>
                <field name="floor_id"/>
                <field name="name"/>
                <field name="type"/>
                <field name="size"/>
                <field name="capacity"/>
                <field name="allocated_bed_count"/>
                <field name="available_bed_count"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_room_form" model="ir.ui.view">
        <field name="name">accommodation.room.form</field>
        <field name="model">accommodation.room</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="camp_id"/>
                            <field name="floor_id"/>
                            <field name="name"/>
                            <field name="type"/>
                        </group>
                        <group>
                            <field name="size"/>
                            <field name="capacity"/>
                            <field name="allocated_bed_count"/>
                            <field name="available_bed_count"/>
                            <field name="status"/>
                            <field name="facilities" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_rooms" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">accommodation.room</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>

