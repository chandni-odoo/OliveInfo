<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_accommodation_check_list_form" model="ir.ui.view">
        <field name="name">accommodation.check.list.form</field>
        <field name="model">accommodation.check.list</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="reference"/>
                            <field name="create_date"/>
                            <field name="created_by"/>
                            <field name="employee_id"/>
                            <field name="checkin_id"/>
                        </group>
                        <group>
                            <field name="camp_id"/>
                            <field name="floor_id"/>
                            <field name="room_id"/>
                            <field name="bed_id"/>   
                            <field name="checkin_date"/>
                            <field name="facilities" widget="many2many_tags"/>
                            <field name="condition_checked"/>
                            <field name="remark"/>
                        </group>
                        <field name="facility_items">
                            <tree editable="bottom">
                                <field name="facility_id"/>
                                <field name="status"/>
                                <field name="remark"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_accommodation_check_list_tree" model="ir.ui.view">
        <field name="name">accommodation.check.list.tree</field>
        <field name="model">accommodation.check.list</field>
        <field name="arch" type="xml">
            <tree>
                <field name="reference"/>
                <field name="create_date"/>
                <field name="created_by"/>
                <field name="employee_id"/>
                <field name="checkin_id"/>
                <field name="camp_id"/>
                <field name="floor_id"/>
                <field name="room_id"/>
                <field name="bed_id"/>
                <field name="checkin_date"/>
                <field name="facilities" widget="many2many_tags"/>
            </tree>
        </field>
    </record>


    <record id="action_check_list" model="ir.actions.act_window">
        <field name="name">Check-List</field>
        <field name="res_model">accommodation.check.list</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>