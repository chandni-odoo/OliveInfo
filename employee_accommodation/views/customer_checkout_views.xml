<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_customer_checkout_form" model="ir.ui.view">
        <field name="name">customer.checkout.form</field>
        <field name="model">customer.checkout</field>
        <field name="arch" type="xml">
            <form string="Customer Check-Out">
                <sheet>
                    <group>
                        <group>
                            <field name="check_out_id"/>
                            <field name="customer_id" required="1"/>
                            <field name="check_in_id" required="1"/>
                            <field name="customer_checklist_id"/>
                            <field name="employee_name"/>
                        </group>
                        <group>
                            <field name="camp_id"/>
                            <field name="floor_id"/>
                            <field name="room_id"/>
                            <field name="bed_id"/>
                            <field name="check_out_date"/>
                            <field name="facilities" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_customer_checkout_tree" model="ir.ui.view">
        <field name="name">customer.checkout.tree</field>
        <field name="model">customer.checkout</field>
        <field name="arch" type="xml">
            <tree>
                <field name="check_out_id"/>
                <field name="customer_id"/>
                <field name="check_in_id"/>
                <field name="employee_name"/>
                <field name="camp_id"/>
                <field name="floor_id"/>
                <field name="room_id"/>
                <field name="bed_id"/>
                <field name="check_out_date"/>
                <field name="facilities" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="action_customer_checkout" model="ir.actions.act_window">
        <field name="name">Customer Check-Out</field>
        <field name="res_model">customer.checkout</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>