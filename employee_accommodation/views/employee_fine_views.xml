<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_disciplinary_action_form" model="ir.ui.view">
        <field name="name">disciplinary.action.form</field>
        <field name="model">employee.accommodation.disciplinary</field>
        <field name="arch" type="xml">
            <form string="Disciplinary Action">
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="action_type_id"/>
                        <field name="date"/>
                        <field name="fine_amount"/>
                        <field name="severity"/>
                    </group>
                    <group>
                        <field name="reason_id"/>
                        <field name="remarks"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_disciplinary_action_tree" model="ir.ui.view">
        <field name="name">disciplinary.action.tree</field>
        <field name="model">employee.accommodation.disciplinary</field>
        <field name="arch" type="xml">
            <tree>
                <field name="employee_id"/>
                <field name="action_type_id"/>
                <field name="reason_id"/>
                <field name="date"/>
                <field name="fine_amount"/>
                <field name="severity"/>
            </tree>
        </field>
    </record>

    <record id="action_employee_disciplinary" model="ir.actions.act_window">
        <field name="name">Employee Fines and Disciplinary Actions</field>
        <field name="res_model">employee.accommodation.disciplinary</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create and manage disciplinary actions.
            </p>
        </field>
    </record>
</odoo>