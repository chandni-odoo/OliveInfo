<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_accommodation_camp_tree" model="ir.ui.view">
        <field name="name">accommodation.camp.tree</field>
        <field name="model">accommodation.camp</field>
        <field name="arch" type="xml">
            <tree>
                <field name="camp_seq"/>
                <field name="name"/>
                <field name="location_id"/>
                <field name="capacity"/>
                <field name="type"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_camp_form" model="ir.ui.view">
        <field name="name">camp.form</field>
        <field name="model">accommodation.camp</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="camp_seq"/>
                            <field name="name"/>
                            <field name="location_id"/>
                            <field name="capacity"/>
                            <field name="total_floors"/>
                            <field name="total_rooms"/>
                            <field name="size"/>
                        </group>
                        <group>
                            <field name="type"/>
                            <field name="status"/>
                            <field name="owner_id"/>
                            <field name="rental_start_date"/>
                            <field name="rental_end_date"/>
                            <field name="camp_boss"/>
                            <field name="facilities" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Floors">
                            <field name="floor_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="number_of_rooms"/>
                                    <field name="size"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Rooms">
                            <field name="room_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="type"/>
                                    <field name="size"/>
                                    <field name="capacity"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_camps" model="ir.actions.act_window">
        <field name="name">Camps</field>
        <field name="res_model">accommodation.camp</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>