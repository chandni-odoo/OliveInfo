<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_customer_checkin_form" model="ir.ui.view">
        <field name="name">customer.checkin.form</field>
        <field name="model">customer.checkin</field>
        <field name="arch" type="xml">
            <form string="Customer Check-In">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="customer_id"/>
                            <field name="employee_name"/>
                            <field name="employee_ref"/>
                            <field name="qid"/>
                            <field name="passport"/>
                            <field name="check_in_date"/>
                        </group>
                        <group>
                            <field name="camp_id"/>
                            <field name="floor_id"/>
                            <field name="room_id"/>
                            <field name="bed_id"/>
                            <field name="status"/>
                            <field name="facilities" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_customer_checkin_tree" model="ir.ui.view">
        <field name="name">customer.checkin.tree</field>
        <field name="model">customer.checkin</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="employee_name"/>
                <field name="employee_ref"/>
                <field name="qid"/>
                <field name="passport"/>
                <field name="status"/>
                <field name="check_in_date"/>
            </tree>
        </field>
    </record>

    <record id="action_customer_checkin" model="ir.actions.act_window">
        <field name="name">Customer Check-In</field>
        <field name="res_model">customer.checkin</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>