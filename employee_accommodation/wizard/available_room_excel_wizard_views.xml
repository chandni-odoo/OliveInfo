<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_available_room_excel_wizard_form" model="ir.ui.view">
        <field name="name">Room Availability Excel Report Wizard</field>
        <field name="model">available.room.excel.wizard</field>
        <field name="arch" type="xml">
            <form string="Room Availability Excel Report">
               <group>
                    <field name="camp_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button string="Generate Excel Report" type="object" name="generate_excel_report" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="available_room_excel_wizard_action" model="ir.actions.act_window">
        <field name="name">Availability Room Excel Report</field>
        <field name="res_model">available.room.excel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


    <menuitem id="menu_available_room_excel_report"
              name="Room Availability Excel Report"
              parent="menu_reports_root"
              action="available_room_excel_wizard_action"
              sequence="6"/>
</odoo>