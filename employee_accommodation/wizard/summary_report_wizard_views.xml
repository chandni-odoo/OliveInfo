<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_room_summary_wizard_form" model="ir.ui.view">
        <field name="name">room.summary.wizard.form</field>
        <field name="model">room.summary.wizard</field>
        <field name="arch" type="xml">
            <form string="Camp Availability &amp; Occupancy Percentage">
                <group>
                    <field name="camp_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_generate_report" type="object" string="Print" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_room_summary_report" model="ir.actions.act_window">
        <field name="name">Camp Availability &amp; Occupancy Percentage</field>
        <field name="res_model">room.summary.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_room_summary_report"
              name="Camp Availability &amp; Occupancy Percentage"
              parent="menu_reports_root"
              action="action_room_summary_report"
              sequence="7"/>
</odoo>