<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_available_beds_excel_wizard_form" model="ir.ui.view">
        <field name="name">Available Beds Excel Report Wizard</field>
        <field name="model">available.beds.excel.wizard</field>
        <field name="arch" type="xml">
            <form string="Available Beds Excel Report">
                <group>
                    <field name="camp_ids" widget="many2many_tags" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_generate_excel" type="object" string="Generate Excel" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="available_beds_excel_wizard_action" model="ir.actions.act_window">
        <field name="name">Bed Availability Excel Report</field>
        <field name="res_model">available.beds.excel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_available_beds_excel_report"
              name="Bed Availability Excel Report"
              parent="menu_reports_root"
              action="available_beds_excel_wizard_action"
              sequence="5"/>
</odoo>