<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_onboarding_wizard_form" model="ir.ui.view">
        <field name="name">customer.onboarding.wizard.form</field>
        <field name="model">customer.onboarding.wizard</field>
        <field name="arch" type="xml">
            <form string="Customer Onboarding">
                <sheet>
                    <group>
                        <field name="client_accommodation_id"/>
                        <field name="customer_name"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Occupy Beds" 
                            type="object" 
                            name="action_occupied_beds" 
                            class="btn-primary"/>
                    <button string="Cancel" 
                            special="cancel" 
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_customer_onboarding_wizard" model="ir.actions.act_window">
        <field name="name">Customer Onboarding</field>
        <field name="res_model">customer.onboarding.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>