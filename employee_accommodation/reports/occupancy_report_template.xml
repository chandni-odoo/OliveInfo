<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <data>
        <record id="occupancy_list_report_action" model="ir.actions.report">
            <field name="name">Occupancy List Report</field>
            <field name="model">accommodation.check.in</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">employee_accommodation.occupancy_list_report_template</field>
            <field name="report_file">employee_accommodation.occupancy_list_report_template</field>
            <field name="print_report_name">'Occupancy Report.pdf'</field>
            <field name="binding_model_id" ref="employee_accommodation.model_accommodation_check_in"/>
            <field name="paperformat_id" ref="employee_accommodation.paperformat_employee_accommodation"/>
            <field name="binding_type">report</field>
        </record>
    </data>


    <template id="occupancy_list_report_template">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page">
                    <h2>Occupancy List</h2>
                    <table class="table table-condensed">
                        <thead>
                            <tr>
                                <th>Allocation ID</th>
                                <th>Employee</th>
                                <th>Nationality</th>
                                <th>Phone Number</th>
                                <th>Branch</th>
                                <th>Religion</th>
                                <th>Designation</th>
                                <th>Date of Join</th>
                                <th>Company</th>
                                <th>Vendor</th>
                                <th>Camp</th>
                                <th>Floor</th>
                                <th>Room</th>
                                <th>Bed</th>
                                <th>Check-In Date</th>
                                <th>Facilities Assigned</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="doc_ids">
                            <tr t-foreach="doc_ids" t-as="doc">
                                <td><span t-field="doc.allocation_id"/></td>
                                <td><span t-field="doc.employee_id.name"/></td>
                                <td><span t-field="doc.nationality.name"/></td>
                                <td><span t-field="doc.contact"/></td>
                                <td><span t-field="doc.business_unit.name"/></td>
                                <td><span t-field="doc.religion.name"/></td>
                                <td><span t-field="doc.designation.name"/></td>
                                <td><span t-field="doc.date_of_join"/></td>
                                <td><span t-field="doc.company.name"/></td>
                                <td><span t-field="doc.vendor_id.name"/></td>
                                <td><span t-field="doc.camp_id.name"/></td>
                                <td><span t-field="doc.floor_id.name"/></td>
                                <td><span t-field="doc.room_id.name"/></td>
                                <td><span t-field="doc.bed_id.name"/></td>
                                <td><span t-field="doc.check_in_date"/></td>
                                <td>
                                    <t t-foreach="doc.facilities" t-as="facility">
                                        <span t-field="facility.name"/><br/>
                                    </t>
                                </td>
                            </tr>
                        </t>
                        <t t-else="">
                            <tr t-foreach="docs" t-as="docid">
                                <td><span t-field="docid.allocation_id"/></td>
                                <td><span t-field="docid.employee_id.name"/></td>
                                <td><span t-field="docid.nationality.name"/></td>
                                <td><span t-field="docid.contact"/></td>
                                <td><span t-field="docid.business_unit.name"/></td>
                                <td><span t-field="docid.religion.name"/></td>
                                <td><span t-field="docid.designation.name"/></td>
                                <td><span t-field="docid.date_of_join"/></td>
                                <td><span t-field="docid.company.name"/></td>
                                <td><span t-field="docid.vendor_id.name"/></td>
                                <td><span t-field="docid.camp_id.name"/></td>
                                <td><span t-field="docid.floor_id.name"/></td>
                                <td><span t-field="docid.bed_id.name"/></td>
                                <td><span t-field="docid.check_in_date"/></td>
                                <td>
                                    <t t-foreach="docid.facilities" t-as="facility">
                                        <span t-field="facility.name"/><br/>
                                    </t>
                                </td>
                            </tr>
                        </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>