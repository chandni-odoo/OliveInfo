<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_change_scheduled_date_order_form" model="ir.ui.view">
        <field name="name">change.scheduled.date.order.form</field>
        <field name="model">change.scheduled.date.order.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Vehicles On Delivery Orders">
                <sheet>
                    <group>
                        <group>
                            <field name="start_date" />
                            <field name="vehicle_id" />
                            <field name="shift_type_id" />
                        </group>
                        <group>
                            <field name="end_date" />
                            <field name="new_vehicle_id" />
                        </group>
                    </group>
                    <group>
                        <field name="delivery_orders_ids" widget="many2many_tags" />
                        <field name="note" />
                    </group>
                    <footer>
                        <button name="action_transfer" type="object" string="Transfer" class="btn-primary" data-hotkey="y" />
                        <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="z"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_change_scheduled_date_order" model="ir.actions.act_window">
        <field name="name">Change Scheduled Date Order</field>
        <field name="res_model">change.scheduled.date.order.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>