<?xml version="1.0" encoding="UTF-8"?>
<template id="template" xml:space="preserve">
    <t t-name="OperationDashboard">
        <div class="oh_dashboards">
            <div class="container-fluid my-5 o_operation_schedule_dashboard" />
        </div>
    </t>
    <t t-name="DashboardMain">
        <div class="o_operation_dashboard">
            <section class="dashboard_main" id="main_section">
                <div class="col-sm-12 mb-4">
                    <div class="row">
                        <div class="col-12 col-sm-12 col-md-8">
                            <h2 class="section-header">Operation Dashboard</h2>
                        </div>
                        <div class="row">
                            <div class="col-6">
                                <div class="card o_dashboard_card">
                                    <div class="card-header">
                                        <h3>Trip Sheets</h3>
                                    </div>
                                    <div class="card-body">
                                        <p>Total:
                                            <t t-esc="widget.trip_sheet_count" />
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="card o_dashboard_card">
                                    <div class="card-header">
                                        <h3>Job Orders</h3>
                                    </div>
                                    <div class="card-body">
                                        <p>Total:
                                            <t t-esc="widget.job_order_count" />
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </t>
</template>