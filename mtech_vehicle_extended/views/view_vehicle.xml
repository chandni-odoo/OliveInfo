<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_vehicle_view_form_inherit_mtech" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit.mtech</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='horsepower_tax']" position="after">
                <field name="warranty_details" />
                <field name="warranty_date" />
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_mark_repair" string="Mark as Repair" class="btn btn-primary" type="object" attrs="{'invisible': [('state_id', '!=', 6)]}" />
                <button name="action_active" string="Active" class="btn btn-primary" type="object" attrs="{'invisible': [('state_id', '!=', 5)]}" />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Insurance" name="vehicle_insurance">
                    <field name="vehicle_insurance_ids">
                        <tree string="Insurance">
                            <field name="insurance_company" />
                            <field name="policy_number" />
                            <field name="start_date" />
                            <field name="end_date" />
                            <field name="insurance_amount" />
                            <field name="premium_amount" />
                            <field name="insurance_type" />
                            <field name="attachment" filename="attachment_filename" />
                        </tree>
                        <form>
                            <group string="Insurance Information" colspan="2">
                                <field name="insurance_company" />
                                <field name="policy_number" />
                                <field name="start_date" />
                                <field name="end_date" />
                                <field name="insurance_amount" />
                                <field name="premium_amount" />
                                <field name="insurance_type" />
                                <field name="attachment" filename="attachment_filename" />
                            </group>
                        </form>
                    </field>
                </page>
                <page string="Opration Shift Schedule" name="shift_schedule">
                    <field name="shift_ids">
                        <tree editable="bottom">
                            <field name="scheduled_date" />
                            <field name="shift_type" />
                            <field name="employee_id" />
                            <field name="employee_type" />
                            <field name="active_shift" />
                        </tree>
                        <form>
                            <group>
                                <field name="scheduled_date" />
                                <field name="shift_type" />
                                <field name="employee_id" />
                                <field name="employee_type" />
                                <field name="active_shift" />
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="fleet_vehicle_view_form_inherit_peoplesol_mtech" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit_mtech</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="account_extended.fleet_vehicle_view_form_inherit_peoplesol" />
        <field name="arch" type="xml">
            <field name="asset_sequence" position="after">
                <field name="permit_ids" widget="many2many_tags" options="{'no_create': True}" />
            </field>
        </field>
    </record>
</odoo>