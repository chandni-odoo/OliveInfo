<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_operation_schedule_tree" model="ir.ui.view">
        <field name="name">operation.schedule.tree</field>
        <field name="model">operation.schedule</field>
        <field name="arch" type="xml">
            <tree string="Sales Order Lines">
                <field name="active_shift" />
                <field name="scheduled_date" />
                <field name="day_name" />
                <field name="employee_id" />
                <field name="vehicle_id" />
                <field name="shift_type" />
                <field name="week_off" />
                <field name="employee_type" />
                <field name="company_id" />
            </tree>
        </field>
    </record>
    <record id="view_operation_schedule_form" model="ir.ui.view">
        <field name="name">operation.schedule.form</field>
        <field name="model">operation.schedule</field>
        <field name="arch" type="xml">
            <form string="Operation Schedule">
                <sheet>
                    <group>
                        <group>
                            <field name="active_shift" />
                            <field name="scheduled_date" />
                            <field name="day_name" />
                            <field name="employee_id" />
                            <field name="vehicle_id" />
                        </group>
                        <group>
                            <field name="shift_type" />
                            <field name="week_off" />
                            <field name="employee_type" />
                            <field name="company_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_operation_schedule_calendar" model="ir.ui.view">
        <field name="name">operation.schedule.calendar</field>
        <field name="model">operation.schedule</field>
        <field name="arch" type="xml">
            <calendar string="Operation Schedule" date_start="scheduled_date">
                <field name="employee_id" />
                <field name="vehicle_id" />
                <field name="shift_type" />
            </calendar>
        </field>
    </record>
    <record id="view_operation_schedule_gantt" model="ir.ui.view">
        <field name="name">operation.schedule.gantt</field>
        <field name="model">operation.schedule</field>
        <field name="arch" type="xml">
            <gantt string="Operation Schedule" color="employee_id" create="false" edit="false" default_group_by='employee_id' date_start="scheduled_date" date_stop="scheduled_date">
                <field name="employee_id" />
                <field name="shift_type" />
                <field name="vehicle_id" />
            </gantt>
        </field>
    </record>
    <record id="action_operation_schedules" model="ir.actions.act_window">
        <field name="name">Operation Scheduled</field>
        <field name="res_model">operation.schedule</field>
        <field name="view_mode">gantt,tree,form,calendar</field>
    </record>
</odoo>