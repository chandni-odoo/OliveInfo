<odoo>
    <record id="view_simple_dashboard_form" model="ir.ui.view">
        <field name="name">simple.dashboard.form</field>
        <field name="model">simple.dashboard</field>
        <field name="arch" type="xml">
            <form string="Simple Dashboard">
                <sheet>
                <!-- Dashboard Header -->
                <h1 class="d-flex justify-content-center mb-4">Dashboard</h1>

                <div class="container">
                    <div class="row d-flex justify-content-center gap-4">
                        <!-- Trip Sheet Button -->
                        <div class="col-5 d-flex justify-content-center align-items-center"
                             style="background-color: #E3F2FD; border-radius: 12px; text-align: center; height: 190px; padding: 15px;">
                            <button type="object" name="action_open_trip_sheet"
                                    class="oe_stat_button btn-block text-center p-4"
                                    style="background-color: #1565C0; color: white; border-radius: 12px; width: 100%; height: 160px; 
                                           display: flex; flex-direction: column; align-items: center; justify-content: center;">
                                <i class="fa fa-shopping-cart fa-3x mb-2" aria-hidden="true" title="Trip Sheet"></i>
                                <span style="font-size: 22px; font-weight: bold;">
                                    <field name="trip_sheet_count" nolabel="True"/>
                                </span>
                                <span style="font-size: 16px;">Trip Sheet</span>
                            </button>
                        </div>

                        <!-- Shift Operation Button -->
                        <div class="col-5 d-flex justify-content-center align-items-center"
                             style="background-color: #C8E6C9; border-radius: 12px; text-align: center; height: 190px; padding: 15px;">
                            <button type="object" name="action_open_shift_opration"
                                    class="oe_stat_button btn-block text-center p-4"
                                    style="background-color: #2E7D32; color: white; border-radius: 12px; width: 100%; height: 160px;
                                           display: flex; flex-direction: column; align-items: center; justify-content: center;">
                                <i class="fa fa-truck fa-3x mb-2" aria-hidden="true" title="Shift Operation"></i>
                                <span style="font-size: 22px; font-weight: bold;">
                                    <field name="shift_opration_count" nolabel="True"/>
                                </span>
                                <span style="font-size: 16px;">Shift Operation</span>
                            </button>
                        </div>
                    </div>

                    <div class="row d-flex justify-content-center gap-4 mt-3">
                        <!-- Fleet Vehicles Button -->
                        <div class="col-5 d-flex justify-content-center align-items-center"
                             style="background-color: #FFCCBC; border-radius: 12px; text-align: center; height: 190px; padding: 15px;">
                            <button type="object" name="action_open_fleet"
                                    class="oe_stat_button btn-block text-center p-4"
                                    style="background-color: #D84315; color: white; border-radius: 12px; width: 100%; height: 160px;
                                           display: flex; flex-direction: column; align-items: center; justify-content: center;">
                                <i class="fa fa-car fa-3x mb-2" aria-hidden="true" title="Fleet Vehicles"></i>
                                <span style="font-size: 22px; font-weight: bold;">
                                    <field name="fleet_count" nolabel="True"/>
                                </span>
                                <span style="font-size: 16px;">Fleet Vehicles</span>
                            </button>
                        </div>

                        <!-- Project Tasks Button -->
                        <div class="col-5 d-flex justify-content-center align-items-center"
                             style="background-color: #E1BEE7; border-radius: 12px; text-align: center; height: 190px; padding: 15px;">
                            <button type="object" name="action_open_project_tasks"
                                    class="oe_stat_button btn-block text-center p-4"
                                    style="background-color: #8E24AA; color: white; border-radius: 12px; width: 100%; height: 160px;
                                           display: flex; flex-direction: column; align-items: center; justify-content: center;">
                                <i class="fa fa-tasks fa-3x mb-2" aria-hidden="true" title="Project Tasks"></i>
                                <span style="font-size: 22px; font-weight: bold;">
                                    <field name="project_task_count" nolabel="True"/>
                                </span>
                                <span style="font-size: 16px;">Project Tasks</span>
                            </button>
                        </div>
                    </div>
                </div>
            </sheet>

              
            </form>
        </field>
    </record>
    <!-- Action to open the Simple Dashboard -->
    <!-- <record id="action_simple_dashboard" model="ir.actions.act_window">
        <field name="name">Simple Dashboard</field>
        <field name="res_model">simple.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
    <menuitem id="menu_operation_dashboard_action" name="Dashboard" parent="menu_operation_schedule" action="action_simple_dashboard" sequence="1" /> -->
</odoo>