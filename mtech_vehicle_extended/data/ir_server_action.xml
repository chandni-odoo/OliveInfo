<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="0">
        <record id="action_update_trip_state" model="ir.actions.server">
            <field name="name">Completed</field>
            <field name="model_id" ref="custom_trip.model_custom_trip_sheet"/>
            <field name="binding_model_id" ref="custom_trip.model_custom_trip_sheet"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                for record in records:
                    action = records.button_approve()
            </field>
        </record>
        <record id="action_donebutton_trip_sheet" model="ir.actions.server">
            <field name="name">Done</field>
            <field name="model_id" ref="custom_trip.model_custom_trip_sheet"/>
            <field name="binding_model_id" ref="custom_trip.model_custom_trip_sheet"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                for record in records:
                    record.write({'stage': 'completed'})
            </field>
        </record>
        <record id="action_holdbutton_trip_sheet" model="ir.actions.server">
            <field name="name">Hold</field>
            <field name="model_id" ref="custom_trip.model_custom_trip_sheet"/>
            <field name="binding_model_id" ref="custom_trip.model_custom_trip_sheet"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                for record in records:
                    record.write({'stage': 'hold'})
            </field>
        </record>
        <record id="action_cancel_trip_sheet" model="ir.actions.server">
            <field name="name">Cancel</field>
            <field name="model_id" ref="custom_trip.model_custom_trip_sheet"/>
            <field name="binding_model_id" ref="custom_trip.model_custom_trip_sheet"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                for record in records:
                    record.write({'stage': 'cancel'})
            </field>
        </record>
        <record id="server_action_change_scheduled_date" model="ir.actions.server">
            <field name="name">Change Scheduled Date</field>
            <field name="model_id" ref="custom_trip.model_custom_trip_sheet"/>
            <field name="binding_model_id" ref="custom_trip.model_custom_trip_sheet"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
active_ids = env.context.get('active_ids', [])
action = {
    "type": "ir.actions.act_window",
    "name": "Change Scheduled Date",
    "res_model": "change.scheduled.date.wizard",
    "view_mode": "form",
    "target": "new",
    "context": {'active_ids': active_ids, 'active_model': 'custom.trip.sheet'},
}
            </field>
        </record>
        <record id="server_action_change_scheduled_date_order" model="ir.actions.server">
            <field name="name">Change Scheduled Date Order</field>
            <field name="model_id" ref="custom_trip.model_custom_trip_sheet"/>
            <field name="binding_model_id" ref="custom_trip.model_custom_trip_sheet"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
active_ids = env.context.get('active_ids', [])

action = {
    "type": "ir.actions.act_window",
    "name": "Change Scheduled Date Order",
    "res_model": "change.scheduled.date.order.wizard",
    "view_mode": "form",
    "target": "new",
    "context": {
        'active_ids': active_ids,
        'active_model': 'custom.trip.sheet',
        'default_delivery_orders_ids': [(6, 0, active_ids)],
    },
}
            </field>
        </record>
    </data>
</odoo>