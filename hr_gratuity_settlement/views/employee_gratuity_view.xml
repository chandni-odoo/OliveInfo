        <record id="res_config_settings_view_form_inherits" model="ir.ui.view">
            <field name="name">hr.res_config_settings_view_form.inherit</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='enrich_employee_setting']" position="after">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane">
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="gratuity_date"/>
                            <div class="text-muted">
                                <field name="gratuity_date"/>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

        <record id="employee_resignation_form_inherit" model="ir.ui.view">
            <field name="name">hr.resignation.form.inherit</field>
            <field name="model">hr.resignation</field>
            <field name="inherit_id" ref="hr_resignation.employee_resignation_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='cancel_resignation']" position="after">
                    <button name="action_create_emp_gratuity" type="object" attrs="{'invisible': [('state','!=', 'approved')]}" string="Create Employee Gratuity"/>
                </xpath>
            </field>
        </record>

        <record id="action_employee_gratuity" model="ir.actions.act_window">
           <field name="name">Gratuity Settlement</field>
           <field name="res_model">hr.gratuity</field>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem id="gratuity_creation" 
            name="Employee Gratuity" 
            parent="hr_resignation.employee_resignation"
            action="action_employee_gratuity"  
            sequence="10"/>
    </data>
</odoo>
