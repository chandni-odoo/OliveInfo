<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_loan_form_view_inherit_hr_loan" model="ir.ui.view">
        <field name="name">hr.loan.form.inherit.hr.loan</field>
        <field name="model">hr.loan</field>
        <field name="inherit_id" ref="hr_loan_management.hr_loan_form_view"/>
        <field name="arch" type="xml">
            <field name="installment" position="after">
                <field name="settlement_id" readonly="1"/>
                <field name="unpaid_days" invisible="1"/>
                <field name="date_from" invisible="1"/>
                <field name="date_to" invisible="1"/>

            </field>
        </field>
    </record>
    <record id="model_hr_loan_action_sent" model="ir.actions.server">
        <field name="name">Loan Validate</field>
        <field name="model_id" ref="hr_loan_management.model_hr_loan"/>
        <field name="binding_model_id" ref="hr_loan_management.model_hr_loan"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_loan_validate()</field>
    </record>
</odoo>
