<odoo>
	<data noupdate="0">
		<record id="leave_settlement_wizard_view_form" model="ir.ui.view">
			<field name="name">leave.settlement.wizard.view</field>
			<field name="model">leave.settlement.wizard</field>
			<field name="arch" type="xml">
				<form>
					<group>
						<group>
							<field name="journal_id" required='1' domain="[('type', 'in', ('cash', 'bank'))]"/>
						</group>
						<group>
							<field name="employee_id" required='1'/>
						</group>
					</group>
					<group>
						<group>
							<field name="credit_account_id" required='1'/>
						</group>
						<group>
							<field name="debit_account_id" required='1'/>
						</group>
					</group>		
					<footer>
						<button name="create_extra_journal_entries" string="Create Journal Entries"
							type="object" class="oe_highlight" />	
						<button string="Cancel" class="oe_link" special="cancel"/>
					</footer>
				</form>
			</field>
		</record>

		<record id="leave_settlement_wizard_act" model="ir.actions.act_window">
			<field name="name">Leave Settlement Wizard</field>
			<field name="res_model">leave.settlement.wizard</field>
			<field name="view_mode">form</field>
			<field name="view_id" ref="leave_settlement_wizard_view_form"/>
			<field name="target">new</field>
		</record>

	</data>
</odoo>
