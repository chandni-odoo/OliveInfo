<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<record id="hr_employee_view_form_inherit_people" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.shift</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <field name="coach_id" position="after">
                <field name="is_peoplesolve_partner" />
                <field name="peoplesolve_emp_partner_id" />
            </field>
        </field>
    </record>

    <record id="hr_leave_type_form_inherit" model="ir.ui.view">
            <field name="name">hr.leave.type.form</field>
            <field name="model">hr.leave.type</field>
            <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='allocation_validation']" position='inside'>
                    <field name="is_service_portal"/>
                </xpath>
            </field>
    </record>
</odoo>