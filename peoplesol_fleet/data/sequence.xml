<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data  noupdate="1">
        <record id="seq_vehicle_handover" model="ir.sequence">
            <field name="name">Vehicle Handover </field>
            <field name="code">vehicle.handover</field>
            <field name="prefix">VH/</field>
            <field name="padding">5</field>
        </record>

        <record id="seq_vehicle_tyre_detail" model="ir.sequence">
            <field name="name">Vehicle Tyre Detail</field>
            <field name="code">vehicle.tyre.detail</field>
            <field name="prefix">R-</field>
            <field name="padding">5</field>
        </record>

        <record id="transport_rate_product" model="product.product">
            <field name="name">Transport Rate</field>
            <field name="lst_price">400.0</field>
            <field name="standard_price">400.0</field>
            <field name="type">service</field>
            <field name="uom_id" ref="uom.product_uom_day"/>
            <field name="uom_po_id" ref="uom.product_uom_day"/>
            <field name="categ_id" ref="product.cat_expense"/>
        </record>
    </data>
</odoo>
