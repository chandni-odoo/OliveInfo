<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tender_working_status_tree" model="ir.ui.view">
        <field name="name">tender.working.status.tree</field>
        <field name="model">tender.working.status</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_tender_working_status_form" model="ir.ui.view">
        <field name="name">tender.working.status.form</field>
        <field name="model">tender.working.status</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_tender_working_status" model="ir.actions.act_window">
        <field name="name">Tender Working Status</field>
        <field name="res_model">tender.working.status</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>