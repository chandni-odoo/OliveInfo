<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tender_tracking_report_wizard_form" model="ir.ui.view">
        <field name="name">tender.tracking.report.wizard.form</field>
        <field name="model">tender.tracking.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Tender Tracking Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>

                    <group>
                        <field name="branch_ids" widget="many2many_tags"/>
                        <field name="working_status_id"/>
                        <field name="include_archived"/>
                    </group>
                </group>

                <footer>
                    <button
                        name="action_generate_report"
                        type="object"
                        string="Generate Report"
                        class="btn-primary"
                    />

                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tender_tracking_report_wizard" model="ir.actions.act_window">
        <field name="name">Tender Tracking Report</field>
        <field name="res_model">tender.tracking.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>