<odoo>

    <record id="view_budget_variance_report_wizard_form" model="ir.ui.view">
        <field name="name">budget.variance.report.wizard.form</field>
        <field name="model">budget.variance.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Budget Variance Report Parameters">
                <sheet>
                    <group>
                        <group>
                            <field name="company_ids" widget="many2many_tags"/>
                            <field name="branch_ids" widget="many2many_tags"/>
                            <field name="budget_ids"  widget="many2many_tags" domain="[('company_id', '=', company_ids)]"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="report_level"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_report" string="Generate Excel Report" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

