    <record id="action_budget_variance_report_wizard" model="ir.actions.act_window">
        <field name="name">Budget Variance Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">budget.variance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    
    <menuitem id="menu_budget_variance_report" 
        name="Variance Report" 
        parent="account.account_reports_management_menu" 
