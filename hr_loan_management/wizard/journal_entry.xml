<odoo>
	<data noupdate="0">
		<record id="journal_entry_wizard_view_form" model="ir.ui.view">
			<field name="name">journal.entry.wizard.view</field>
			<field name="model">journal.entry.wizard</field>
			<field name="arch" type="xml">
				<form>
					<group>
						<group>
							<field name="journal_id" required='1'/>
						</group>
						<group>
							<field name="emp_partner_id"/>
						</group>
					</group>
					<group>
						<group>
							<field name="credit_account_id" required='1'/>
						</group>
						<group>
							<field name="debit_account_id" required='1'/>
						</group>
					</group>		
					<footer>
						<button name="create_extra_journal_entries" string="Create Journal Entries"
							type="object" class="oe_highlight" />	
						<button string="Cancel" class="oe_link" special="cancel"/>
					</footer>
				</form>
			</field>
		</record>

		<record id="journal_entry_wizard_act" model="ir.actions.act_window">
			<field name="name">Journal Entry Wizard</field>
			<field name="res_model">journal.entry.wizard</field>
			<field name="view_mode">form</field>
			<field name="view_id" ref="journal_entry_wizard_view_form"/>
			<field name="target">new</field>
		</record>

	</data>
</odoo>
