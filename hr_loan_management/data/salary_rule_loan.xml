<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data  noupdate="1">
         <record id="hr_payslip_loan_input" model="hr.payslip.input.type">
            <field name="name">Loan</field>
            <field name="code">Loan</field>
            <field name="country_id" ref="base.us"/>
        </record>

        <record id="hr_payslip_salary_advance_input" model="hr.payslip.input.type">
            <field name="name">Salary</field>
            <field name="code">Salary</field>
            <field name="country_id" ref="base.us"/>
        </record>

        <record id="seq_loan" model="ir.sequence">
            <field name="name">Loan</field>
            <field name="code">loan.seq</field>
            <field name="prefix">LOAN/</field>
            <field name="number_increment">1</field>
            <field name="padding">3</field>
        </record>

         <record id="seq_salary_advance" model="ir.sequence">
            <field name="name">Salary</field>
            <field name="code">loan.advance.seq</field>
            <field name="prefix">ASAL/</field>
            <field name="number_increment">1</field>
            <field name="padding">3</field>
        </record>
	</data>
</odoo>
