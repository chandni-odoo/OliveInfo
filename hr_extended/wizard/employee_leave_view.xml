<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_leave_wizard" model="ir.ui.view">
        <field name="name">Employee Leave</field>
        <field name="model">employee.leave.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Leave Type">
                <group>
                    <field name="leave_type_id" required='1'/>
                </group>
                <footer>
                    <button string="Leave" name="action_create_leave" type="object"  class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="action_leave_wizard" model="ir.actions.act_window">
        <field name="name">Employee Leave</field>
        <field name="res_model">employee.leave.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_employee_leave_wizard"/>
        <field name="target">new</field>
    </record>
</odoo>
