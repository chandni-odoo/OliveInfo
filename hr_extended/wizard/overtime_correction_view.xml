<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    	<record id="employee_overtime_correction_form" model="ir.ui.view">
    		<field name="name">overtime.correction.wizard.form</field>
            <field name="model">overtime.correction</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group colspan='6'>
                            <field name="employee_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_employee_overtime_corrections" string="Correction" class="oe_highlight" type="object"/>
                    	<button string="cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>   
        </record>

        <record id="action_employee_overtime_correction" model="ir.actions.act_window">
            <field name="name">Employee Overtime Correction</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">overtime.correction</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="binding_view_types">list,form</field>
        </record>
	</data>
</odoo>
